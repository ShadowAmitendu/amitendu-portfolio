---
layout: base.njk
title: Blog
headerTagline: MY WEB LOG
pagination:
  data: collections.blog
  size: 25
  alias: posts
  reverse: true
permalink: "{% if pagination.pageNumber == 0 %}/blog/{% else %}/blog/page/{{ pagination.pageNumber + 1 }}/{% endif %}"
heading: Web log
intro: Notes from my corner of the web.
---
<h2 class="border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">{{ heading }}</h2>
<p class="mt-3">{{ intro }}</p>
{% for post in posts %}
<article class="site-card mt-6 border border-[#b7cbd6] bg-[#f4f8fa] p-0">
  <a class="site-card-link block p-4 text-inherit no-underline" href="{{ post.url }}">
    <div class="site-card-row flex items-center justify-between gap-4">
      <div class="min-w-0">
        <h3 class="font-bold text-[#164b70]">{{ post.data.title }}</h3>
        <p class="mt-2 text-xs text-[#71828b]">{{ post.data.date | shortDate }}{% if post.data.author %} · by {{ post.data.author }}{% endif %}</p>
        <p class="mt-2">{{ post.data.description }}</p>
      </div>
      {% if post.data.image %}<img class="site-card-image h-24 w-28 max-w-full shrink-0 object-cover" src="{{ post.data.image }}" alt="{{ post.data.title }}" />{% endif %}
    </div>
  </a>
</article>
{% endfor %}
{% if pagination.pages.length > 1 %}
<nav class="mt-6 flex flex-wrap items-center gap-3 text-xs" aria-label="Blog pagination">
  {% if pagination.href.previous %}<a class="text-[#064f83] underline hover:text-[#c0392b]" href="{{ pagination.href.previous }}">← newer posts</a>{% endif %}
  <span>page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}</span>
  {% if pagination.href.next %}<a class="text-[#064f83] underline hover:text-[#c0392b]" href="{{ pagination.href.next }}">older posts →</a>{% endif %}
</nav>
{% endif %}
