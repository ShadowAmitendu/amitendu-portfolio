---
layout: base.njk
title: Friends
headerTagline: FRIENDS & ALLIES
permalink: /about/friends/
aboutTab: friends
---
{% include "about-tabs.njk" %}

<h2 class="border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">
  {{ friends.heading or 'Friends & Web Neighbours' }}</h2>
{% if friends.intro %}
<p class="mt-3 text-sm leading-relaxed text-[#26343d]">{{ friends.intro }}</p>
{% endif %}

<div class="mt-4 space-y-4">
  {% if friends.items and friends.items.length > 0 %}
  {% for friend in friends.items %}
  <div class="site-card border border-[#9bb0be] bg-white p-0 shadow-[2px_2px_0_#cad6de]">
    {# 2005 Window Header #}
    <div
      class="border-b border-[#c6d7e0] bg-[#e4eef2] px-3 py-1.5 flex flex-wrap items-center justify-between gap-2 shadow-[inset_0_1px_0_#fff]">
      <div class="flex items-baseline gap-1.5 text-sm">
        <span class="text-sm font-bold text-[#556b78] select-none">#{{ loop.index }}</span>
        <h3 class="font-bold text-sm text-[#164b70] tracking-tight uppercase leading-none m-0 inline">
          {% if friend.url %}
          <a class="text-[#164b70] underline hover:text-[#c0392b]" href="{{ friend.url }}" target="_blank"
            rel="noopener noreferrer">{{ friend.name }}</a>
          {% else %}
          {{ friend.name }}
          {% endif %}
        </h3>
        {% if friend.relationship %}
        <span class="text-sm text-[#556b78] font-normal">({{ friend.relationship }})</span>
        {% endif %}
      </div>
      <div>
        {% if friend.url %}
        <a class="text-[11px] font-bold text-[#164b70] bg-[#e1ebf0] px-1.5 py-0.5 border border-[#c6d7e0] underline hover:text-[#c0392b]"
          href="{{ friend.url }}" target="_blank" rel="noopener noreferrer">Visit Site &raquo;</a>
        {% endif %}
      </div>
    </div>

    {# Body #}
    <div class="site-listing-body p-3 bg-[#f8fbfc]">
      {# Left Portrait Image Frame (Full Height of the Area, Cropped) #}
      <div class="site-listing-image-col shrink-0 self-stretch w-28 sm:w-28 md:w-32 mx-auto sm:mx-0 flex flex-col justify-stretch">
        {% if friend.avatar %}
        <div class="site-listing-frame is-friend-portrait h-full w-full min-h-[8.5rem] p-0.5 overflow-hidden bg-white border border-[#7892a3] shadow-[2px_2px_0_#cad6de] flex items-stretch">
          <img src="{{ friend.avatar }}" alt="{{ friend.name }}" class="w-full h-full object-cover object-center block" />
        </div>
        {% else %}
        <div class="site-listing-placeholder is-friend-portrait h-full w-full min-h-[8.5rem] text-[11px] flex items-center justify-center bg-[#dce9ef] border border-[#7892a3] shadow-[2px_2px_0_#cad6de] font-bold text-[#164b70] tracking-wider select-none">
          PORTRAIT
        </div>
        {% endif %}
      </div>

      {# Right Details Definition Table #}
      <div class="min-w-0 flex-1 w-full text-xs">
        <table class="w-full text-xs text-[#26343d] border-collapse">
          <tbody>
            {% if friend.relationship %}
            <tr class="border-b border-[#e1ebf0]">
              <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Relationship:</td>
              <td class="py-1 text-[#3b4d57]">{{ friend.relationship }}</td>
            </tr>
            {% endif %}
            {% if friend.url %}
            <tr class="border-b border-[#e1ebf0]">
              <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Website:</td>
              <td class="py-1 text-[#064f83] truncate">
                <a class="underline hover:text-[#c0392b]" href="{{ friend.url }}" target="_blank"
                  rel="noopener noreferrer">{{ friend.url }}</a>
              </td>
            </tr>
            {% endif %}
            {% if friend.description %}
            <tr class="border-b border-[#e1ebf0]">
              <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Notes:</td>
              <td class="py-1 text-[#26343d] leading-relaxed italic">"{{ friend.description }}"</td>
            </tr>
            {% endif %}
          </tbody>
        </table>

        {% if friend.url %}
        <div class="pt-2 flex justify-end">
          <a class="site-button-2007 inline-block px-3 py-1 text-xs" href="{{ friend.url }}" target="_blank"
            rel="noopener noreferrer">
            Visit Homepage &raquo;
          </a>
        </div>
        {% endif %}
      </div>
    </div>
  </div>
  {% endfor %}
  {% else %}
  <div class="border border-[#b7cbd6] bg-[#f4f8fa] px-4 py-3 text-xs text-[#71828b]">
    No friends added yet. Friends added via the admin panel will appear here.
  </div>
  {% endif %}
</div>

<p class="mt-6"><a class="text-[#064f83] underline hover:text-[#c0392b]" href="/">← back to home</a></p>
