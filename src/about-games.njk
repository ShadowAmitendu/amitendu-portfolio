---
layout: base.njk
title: Games
headerTagline: WHAT I'M PLAYING
permalink: /about/games/
aboutTab: games
---
{% include "about-tabs.njk" %}

<h2 class="border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">
  {{ games.heading or 'Games' }}</h2>
{% if games.intro %}
<p class="mt-3 text-sm leading-relaxed text-[#26343d]">{{ games.intro }}</p>
{% endif %}

<div class="mt-4 space-y-3">
  {% if games.items and games.items.length > 0 %}
  {% for game in games.items %}
  <article class="site-card border border-[#b7cbd6] bg-[#f4f8fa] p-3">
    <div class="flex items-start gap-3">
      {% set gameImg = game.image or game.icon %}
      {% if gameImg %}
      <img class="{% if game.image %}h-20 w-14 object-cover{% else %}h-10 w-10 object-contain{% endif %} shrink-0 border border-[#7892a3] bg-white p-0.5" src="{{ gameImg }}" alt="{{ game.name }}" />
      {% else %}
      <div class="h-16 w-12 shrink-0 border border-[#7892a3] bg-[#dce9ef] flex items-center justify-center text-[9px] font-bold text-[#164b70]">
        GAME
      </div>
      {% endif %}
      <div class="min-w-0 flex-1">
        <h3 class="font-bold text-[#164b70]">
          {% if game.link %}
          <a class="text-[#164b70] underline hover:text-[#c0392b]" href="{{ game.link }}" target="_blank" rel="noopener noreferrer">{{ game.name }}</a>
          {% else %}
          {{ game.name }}
          {% endif %}
          {% if game.platform %}
          <span class="font-normal text-xs text-[#556b78]">({{ game.platform }})</span>
          {% endif %}
        </h3>
        {% if game.publisher %}
        <p class="text-xs text-[#556b78] mt-0.5">{{ game.publisher }}</p>
        {% endif %}
        <p class="mt-1 text-xs text-[#71828b]">
          {% if game.playingRightNow or game.playingNow or game.status == "Playing right now" %}
          <strong class="text-[#164b70]">[Playing right now]</strong>
          {% elif game.status %}
          <strong>[{{ game.status }}]</strong>
          {% endif %}
          {% if game.tags and game.tags.length > 0 %}
          <span class="ml-1 text-[11px] text-[#556b78]">· {{ game.tags | join(', ') }}</span>
          {% endif %}
        </p>
        {% if game.description %}
        <p class="mt-1 text-xs text-[#26343d]">{{ game.description }}</p>
        {% endif %}
        {% if game.link %}
        <p class="mt-1.5 text-xs">
          <a class="text-[#064f83] underline hover:text-[#c0392b]" href="{{ game.link }}" target="_blank" rel="noopener noreferrer">official link &raquo;</a>
        </p>
        {% endif %}
      </div>
    </div>
  </article>
  {% endfor %}
  {% else %}
  <div class="border border-[#b7cbd6] bg-[#f4f8fa] px-4 py-3 text-xs text-[#71828b]">
    No games added yet. Games added via the admin panel will appear here.
  </div>
  {% endif %}
</div>

<p class="mt-6"><a class="text-[#064f83] underline hover:text-[#c0392b]" href="/">← back to home</a></p>
