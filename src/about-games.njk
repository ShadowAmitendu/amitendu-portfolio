---
layout: base.njk
title: Games
headerTagline: WHAT I'M PLAYING
permalink: /about/games/
aboutTab: games
---
{% include "about-tabs.njk" %}

<h2 class="border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">
  {{ games.heading or 'Games & Software' }}</h2>
{% if games.intro %}
<p class="mt-3 text-sm leading-relaxed text-[#26343d]">{{ games.intro }}</p>
{% endif %}

<div class="mt-4 space-y-3">
  {% if games.items and games.items.length > 0 %}
  {% for game in games.items %}
  <article class="site-card border border-[#b7cbd6] bg-[#f4f8fa] p-3">
    <div class="flex items-start gap-3">
      {% if game.icon %}
      <img class="h-10 w-10 shrink-0 object-contain border border-[#7892a3] bg-white p-0.5" src="{{ game.icon }}" alt="{{ game.name }}" width="40" height="40" />
      {% else %}
      <div class="h-10 w-10 shrink-0 border border-[#7892a3] bg-[#dce9ef] flex items-center justify-center text-[9px] font-bold text-[#164b70]">
        GAME
      </div>
      {% endif %}
      <div class="min-w-0 flex-1">
        <h3 class="font-bold text-[#164b70]">
          {% if game.link %}
          <a class="text-[#164b70] underline hover:text-[#c0392b]" href="{{ game.link }}" target="_blank" rel="noopener noreferrer">{{ game.name }}</a>
          {% else %}
          {{ game.name }}
          {% endif %}
          {% if game.platform %}
          <span class="font-normal text-xs text-[#556b78]">({{ game.platform }})</span>
          {% endif %}
        </h3>
        <p class="mt-1 text-xs text-[#71828b]">
          {% if game.status %}<strong>[{{ game.status }}]</strong>{% endif %}
        </p>
        {% if game.description %}
        <p class="mt-1 text-xs text-[#26343d]">{{ game.description }}</p>
        {% endif %}
        {% if game.link %}
        <p class="mt-1.5 text-xs">
          <a class="text-[#064f83] underline hover:text-[#c0392b]" href="{{ game.link }}" target="_blank" rel="noopener noreferrer">official link &raquo;</a>
        </p>
        {% endif %}
      </div>
    </div>
  </article>
  {% endfor %}
  {% else %}
  <div class="border border-[#b7cbd6] bg-[#f4f8fa] px-4 py-3 text-xs text-[#71828b]">
    No games added yet. Games added via the admin panel will appear here.
  </div>
  {% endif %}
</div>

<p class="mt-6"><a class="text-[#064f83] underline hover:text-[#c0392b]" href="/">← back to home</a></p>
