---
layout: base.njk
title: Games
headerTagline: WHAT I'M PLAYING
permalink: /about/games/
aboutTab: games
---
{% include "about-tabs.njk" %}

<h2 class="border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">
  {{ games.heading or 'Games' }}</h2>
{% if games.intro %}
<p class="mt-3 text-sm leading-relaxed text-[#26343d]">{{ games.intro }}</p>
{% endif %}

<div class="mt-4 space-y-4">
  {% if games.items and games.items.length > 0 %}
  {% for game in games.items %}
  <div class="site-card border border-[#9bb0be] bg-white p-0 shadow-[2px_2px_0_#cad6de]">
    {# 2005 Window Header #}
    <div class="border-b border-[#c6d7e0] bg-[#e4eef2] px-3 py-1.5 flex flex-wrap items-center justify-between gap-2 shadow-[inset_0_1px_0_#fff]">
      <div class="flex items-baseline gap-1.5">
        <span class="text-xs font-bold text-[#556b78] select-none">#{{ loop.index }}</span>
        <h3 class="font-bold text-sm text-[#164b70] tracking-tight uppercase leading-none m-0 inline">
          {% if game.link %}
          <a class="text-[#164b70] underline hover:text-[#c0392b]" href="{{ game.link }}" target="_blank" rel="noopener noreferrer">{{ game.name }}</a>
          {% else %}
          {{ game.name }}
          {% endif %}
        </h3>
        {% if game.publisher %}
        <span class="text-xs text-[#556b78] font-normal">({{ game.publisher }})</span>
        {% elif game.platform %}
        <span class="text-xs text-[#556b78] font-normal">({{ game.platform }})</span>
        {% endif %}
      </div>
      <div>
        {% if game.playingRightNow or game.playingNow or game.status == "Playing right now" %}
        <span class="inline-block bg-[#164b70] text-white text-[10px] font-bold px-1.5 py-0.5 shadow-[inset_0_1px_1px_rgba(0,0,0,0.3)]">PLAYING RIGHT NOW</span>
        {% elif game.status %}
        <span class="text-[11px] font-bold text-[#556b78]">{{ game.status }}</span>
        {% endif %}
      </div>
    </div>

    {# Body #}
    <div class="site-listing-body p-3 bg-[#f8fbfc]">
      {# Left Icon / Box Art #}
      {% set gameImg = game.image or game.icon %}
      <div class="site-listing-image-col">
        {% if gameImg %}
        <div class="site-listing-frame">
          <img src="{{ gameImg }}" alt="{{ game.name }}" />
        </div>
        {% else %}
        <div class="site-listing-placeholder">
          GAME
        </div>
        {% endif %}
      </div>

      {# Right Details Definition Table #}
      <div class="min-w-0 flex-1 w-full text-xs">
        <table class="w-full text-xs text-[#26343d] border-collapse">
          <tbody>
            {% if game.publisher %}
            <tr class="border-b border-[#e1ebf0]">
              <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Publisher:</td>
              <td class="py-1 text-[#3b4d57]">{{ game.publisher }}</td>
            </tr>
            {% endif %}
            {% if game.platform %}
            <tr class="border-b border-[#e1ebf0]">
              <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Platform:</td>
              <td class="py-1 text-[#3b4d57]">{{ game.platform }}</td>
            </tr>
            {% endif %}
            {% if game.status %}
            <tr class="border-b border-[#e1ebf0]">
              <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Status:</td>
              <td class="py-1 text-[#3b4d57]">
                <strong>{{ game.status }}</strong>
                {% if game.tags and game.tags.length > 0 %}
                <span class="text-[#71828b] ml-1">({{ game.tags | join(', ') }})</span>
                {% endif %}
              </td>
            </tr>
            {% endif %}
            {% if game.description %}
            <tr class="border-b border-[#e1ebf0]">
              <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Notes:</td>
              <td class="py-1 text-[#26343d] leading-relaxed italic">"{{ game.description }}"</td>
            </tr>
            {% endif %}
          </tbody>
        </table>

        {% if game.link %}
        <div class="pt-2 flex justify-end">
          <a class="site-button-2007 inline-block px-3 py-1 text-xs" href="{{ game.link }}" target="_blank" rel="noopener noreferrer">
            Visit Official Website &raquo;
          </a>
        </div>
        {% endif %}
      </div>
    </div>
  </div>
  {% endfor %}
  {% else %}
  <div class="border border-[#b7cbd6] bg-[#f4f8fa] px-4 py-3 text-xs text-[#71828b]">
    No games added yet. Games added via the admin panel will appear here.
  </div>
  {% endif %}
</div>

<p class="mt-6"><a class="text-[#064f83] underline hover:text-[#c0392b]" href="/">← back to home</a></p>
