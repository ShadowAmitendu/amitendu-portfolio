---
layout: base.njk
title: Software
headerTagline: TOOLS & APPS I USE
permalink: /about/software/
aboutTab: software
---
{% include "about-tabs.njk" %}

<h2 class="border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">
  {{ software.heading or 'Software & Tools' }}</h2>
{% if software.intro %}
<p class="mt-3 text-sm leading-relaxed text-[#26343d]">{{ software.intro }}</p>
{% endif %}

<div class="mt-4 space-y-4">
  {% if software.items and software.items.length > 0 %}
  {# Retro directory toolbar #}
  <div class="border border-[#b7cbd6] bg-[#edf4f7] px-3 py-1.5 text-xs text-[#536a75] flex items-center justify-between shadow-[inset_0_1px_0_#fff]">
    <span class="font-bold text-[#164b70]">SOFTWARE ARCHIVE // {{ software.items.length }} TOOL{% if software.items.length != 1 %}S{% endif %} &amp; APPS LISTED</span>
    <span class="text-[11px] text-[#71828b]">SYSTEM: UTILITIES &amp; TOOLS</span>
  </div>

  {% for item in software.items %}
  <div class="site-card border border-[#9bb0be] bg-white p-0 shadow-[2px_2px_0_#cad6de]">
    {# 2005 Window Header #}
    <div class="border-b border-[#c6d7e0] bg-[#e4eef2] px-3 py-1.5 flex flex-wrap items-center justify-between gap-2 shadow-[inset_0_1px_0_#fff]">
      <div class="flex items-center gap-2">
        <span class="text-xs font-bold text-[#556b78]">#{{ loop.index }}</span>
        <h3 class="font-bold text-sm text-[#164b70] tracking-tight uppercase leading-none m-0">
          {% if item.link %}
          <a class="text-[#164b70] underline hover:text-[#c0392b]" href="{{ item.link }}" target="_blank" rel="noopener noreferrer">{{ item.name }}</a>
          {% else %}
          {{ item.name }}
          {% endif %}
        </h3>
        {% if item.category %}
        <span class="text-[11px] text-[#556b78] font-normal">({{ item.category }})</span>
        {% endif %}
      </div>
      <div>
        {% if item.platform %}
        <span class="text-[11px] font-bold text-[#164b70] bg-[#e1ebf0] px-1.5 py-0.5 border border-[#c6d7e0]">[{{ item.platform }}]</span>
        {% endif %}
      </div>
    </div>

    {# Body #}
    <div class="p-3 bg-[#f8fbfc] flex flex-col sm:flex-row items-start gap-3.5">
      {# Left Icon Frame #}
      <div class="shrink-0 flex flex-col items-center mx-auto sm:mx-0">
        {% if item.icon %}
        <div class="border border-[#7892a3] bg-white p-1 shadow-[2px_2px_0_#cad6de]">
          <img class="h-12 w-12 object-contain block" src="{{ item.icon }}" alt="{{ item.name }}" width="48" height="48" />
        </div>
        {% else %}
        <div class="h-12 w-12 border border-[#7892a3] bg-[#dce9ef] flex items-center justify-center text-[10px] font-bold text-[#164b70] shadow-[2px_2px_0_#cad6de]">
          APP
        </div>
        {% endif %}
      </div>

      {# Right Details Definition Table #}
      <div class="min-w-0 flex-1 w-full text-xs">
        <table class="w-full text-xs text-[#26343d] border-collapse">
          <tbody>
            {% if item.category %}
            <tr class="border-b border-[#e1ebf0]">
              <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Category:</td>
              <td class="py-1 text-[#3b4d57]">{{ item.category }}</td>
            </tr>
            {% endif %}
            {% if item.platform %}
            <tr class="border-b border-[#e1ebf0]">
              <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Platform:</td>
              <td class="py-1 text-[#3b4d57]">{{ item.platform }}</td>
            </tr>
            {% endif %}
            {% if item.description %}
            <tr class="border-b border-[#e1ebf0]">
              <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Usage &amp; Notes:</td>
              <td class="py-1 text-[#26343d] leading-relaxed">{{ item.description }}</td>
            </tr>
            {% endif %}
          </tbody>
        </table>

        {% if item.link %}
        <div class="pt-2 flex justify-end">
          <a class="site-button-2007 inline-block px-3 py-1 text-xs" href="{{ item.link }}" target="_blank" rel="noopener noreferrer">
            Visit Official Website &raquo;
          </a>
        </div>
        {% endif %}
      </div>
    </div>
  </div>
  {% endfor %}
  {% else %}
  <div class="border border-[#b7cbd6] bg-[#f4f8fa] px-4 py-3 text-xs text-[#71828b]">
    No software or tools added yet. Software added via the admin panel will appear here.
  </div>
  {% endif %}
</div>

<p class="mt-6"><a class="text-[#064f83] underline hover:text-[#c0392b]" href="/">← back to home</a></p>
