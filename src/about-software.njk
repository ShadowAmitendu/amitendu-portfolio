---
layout: base.njk
title: Software
headerTagline: TOOLS & APPS I USE
permalink: /about/software/
aboutTab: software
---
{% include "about-tabs.njk" %}

<h2 class="border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">
  {{ software.heading or 'Software & Tools' }}</h2>
{% if software.intro %}
<p class="mt-3 text-sm leading-relaxed text-[#26343d]">{{ software.intro }}</p>
{% endif %}

<div class="mt-4 space-y-3">
  {% if software.items and software.items.length > 0 %}
  {% for item in software.items %}
  <article class="site-card border border-[#b7cbd6] bg-[#f4f8fa] p-3">
    <div class="flex items-start gap-3">
      {% if item.icon %}
      <img class="h-10 w-10 shrink-0 object-contain border border-[#7892a3] bg-white p-0.5" src="{{ item.icon }}" alt="{{ item.name }}" width="40" height="40" />
      {% else %}
      <div class="h-10 w-10 shrink-0 border border-[#7892a3] bg-[#dce9ef] flex items-center justify-center text-[9px] font-bold text-[#164b70]">
        APP
      </div>
      {% endif %}
      <div class="min-w-0 flex-1">
        <h3 class="font-bold text-[#164b70]">
          {% if item.link %}
          <a class="text-[#164b70] underline hover:text-[#c0392b]" href="{{ item.link }}" target="_blank" rel="noopener noreferrer">{{ item.name }}</a>
          {% else %}
          {{ item.name }}
          {% endif %}
          {% if item.category %}
          <span class="font-normal text-xs text-[#556b78]">({{ item.category }})</span>
          {% endif %}
        </h3>
        {% if item.platform %}
        <p class="mt-1 text-xs text-[#71828b]">
          <strong>[{{ item.platform }}]</strong>
        </p>
        {% endif %}
        {% if item.description %}
        <p class="mt-1 text-xs text-[#26343d]">{{ item.description }}</p>
        {% endif %}
        {% if item.link %}
        <p class="mt-1.5 text-xs">
          <a class="text-[#064f83] underline hover:text-[#c0392b]" href="{{ item.link }}" target="_blank" rel="noopener noreferrer">official link &raquo;</a>
        </p>
        {% endif %}
      </div>
    </div>
  </article>
  {% endfor %}
  {% else %}
  <div class="border border-[#b7cbd6] bg-[#f4f8fa] px-4 py-3 text-xs text-[#71828b]">
    No software or tools added yet. Software added via the admin panel will appear here.
  </div>
  {% endif %}
</div>

<p class="mt-6"><a class="text-[#064f83] underline hover:text-[#c0392b]" href="/">← back to home</a></p>
