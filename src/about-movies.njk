---
layout: base.njk
title: Movies
headerTagline: WHAT I'M WATCHING
permalink: /about/movies/
aboutTab: movies
---
{% include "about-tabs.njk" %}

<h2 class="border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">
  {{ movies.heading or 'Cinema & TV Shows' }}</h2>
{% if movies.intro %}
<p class="mt-3 text-sm leading-relaxed text-[#26343d]">{{ movies.intro }}</p>
{% endif %}

{# Section 1: Movies #}
<div class="mt-6">
  <h3 class="border-b border-[#b7cbd6] pb-1 text-base font-bold text-[#164b70]">
    Movies / Cinema
  </h3>
  <div class="mt-3 space-y-4">
    {% set movieList = movies.movies or [] %}
    {% if movieList.length == 0 and movies.items %}
    {% for item in movies.items %}
    {% if item.type != 'TV Series' %}{% set movieList = (movieList.push(item), movieList) %}{% endif %}
    {% endfor %}
    {% endif %}

    {% if movieList and movieList.length > 0 %}
    {% for movie in movieList %}
    <div class="site-card border border-[#9bb0be] bg-white p-0 shadow-[2px_2px_0_#cad6de]">
      {# 2005 Window Header #}
      <div
        class="border-b border-[#c6d7e0] bg-[#e4eef2] px-3 py-1.5 flex flex-wrap items-center justify-between gap-2 shadow-[inset_0_1px_0_#fff]">
        <div class="flex items-baseline gap-1.5 text-sm">
          <span class="text-sm font-bold text-[#556b78] select-none">#{{ loop.index }}</span>
          <h4 class="font-bold text-sm text-[#164b70] tracking-tight uppercase leading-none m-0 inline">
            {% if movie.link %}
            <a class="text-[#164b70] underline hover:text-[#c0392b]" href="{{ movie.link }}" target="_blank"
              rel="noopener noreferrer">{{ movie.title }}</a>
            {% else %}
            {{ movie.title }}
            {% endif %}
          </h4>
          {% if movie.director %}
          <span class="text-sm text-[#556b78] font-normal">({{ movie.director }})</span>
          {% endif %}
        </div>
        <div>
          {% if movie.status == "currently-watching" %}
          <span
            class="inline-block bg-[#164b70] text-white text-[10px] font-bold px-1.5 py-0.5 shadow-[inset_0_1px_1px_rgba(0,0,0,0.3)]">WATCHING
            NOW</span>
          {% elif movie.status == "watched" %}
          <span class="text-[11px] font-bold text-[#2e7d32]">WATCHED</span>
          {% elif movie.status == "plan-to-watch" %}
          <span class="text-[11px] font-bold text-[#556b78]">PLAN TO WATCH</span>
          {% endif %}
        </div>
      </div>

      {# Body #}
      <div class="site-listing-body p-3 bg-[#f8fbfc]">
        {# Left Poster Frame #}
        <div class="site-listing-image-col">
          {% if movie.image %}
          <div class="site-listing-frame">
            <img src="{{ movie.image }}" alt="{{ movie.title }}" />
          </div>
          {% else %}
          <div class="site-listing-placeholder">
            CINEMA
          </div>
          {% endif %}
        </div>

        {# Right Details Definition Table #}
        <div class="min-w-0 flex-1 w-full text-xs">
          <table class="w-full text-xs text-[#26343d] border-collapse">
            <tbody>
              {% if movie.director %}
              <tr class="border-b border-[#e1ebf0]">
                <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Director:</td>
                <td class="py-1 text-[#3b4d57]">{{ movie.director }}</td>
              </tr>
              {% endif %}
              {% if movie.status %}
              <tr class="border-b border-[#e1ebf0]">
                <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Status:</td>
                <td class="py-1 text-[#3b4d57]">
                  {% if movie.status == "currently-watching" %}Currently
                  Watching{% elif movie.status == "watched" %}Completed / Watched{% else %}Plan to Watch{% endif %}
                </td>
              </tr>
              {% endif %}
              {% if movie.rating %}
              <tr class="border-b border-[#e1ebf0]">
                <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Rating:</td>
                <td class="py-1 text-[#c0392b] font-bold">{{ movie.rating }}</td>
              </tr>
              {% endif %}
              {% if movie.year %}
              <tr class="border-b border-[#e1ebf0]">
                <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Release Year:</td>
                <td class="py-1 text-[#556b78]">{{ movie.year }}</td>
              </tr>
              {% endif %}
              {% if movie.review %}
              <tr class="border-b border-[#e1ebf0]">
                <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Mini Review:</td>
                <td class="py-1 text-[#26343d] leading-relaxed italic">"{{ movie.review }}"</td>
              </tr>
              {% endif %}
            </tbody>
          </table>

          {% if movie.link %}
          <div class="pt-2 flex justify-end">
            <a class="site-button-2007 inline-block px-3 py-1 text-xs" href="{{ movie.link }}" target="_blank"
              rel="noopener noreferrer">
              Movie Details / IMDb &raquo;
            </a>
          </div>
          {% endif %}
        </div>
      </div>
    </div>
    {% endfor %}
    {% else %}
    <div class="border border-[#b7cbd6] bg-[#f4f8fa] px-4 py-3 text-xs text-[#71828b]">
      No movies added yet. Movies added via the admin panel will appear here.
    </div>
    {% endif %}
  </div>
</div>

{# Section 2: TV Shows #}
<div class="mt-8">
  <h3 class="border-b border-[#b7cbd6] pb-1 text-base font-bold text-[#164b70]">
    TV Shows &amp; Series
  </h3>
  <div class="mt-3 space-y-4">
    {% set showList = movies.shows or [] %}
    {% if showList.length == 0 and movies.items %}
    {% for item in movies.items %}
    {% if item.type == 'TV Series' %}{% set showList = (showList.push(item), showList) %}{% endif %}
    {% endfor %}
    {% endif %}

    {% if showList and showList.length > 0 %}
    {% for show in showList %}
    <div class="site-card border border-[#9bb0be] bg-white p-0 shadow-[2px_2px_0_#cad6de]">
      {# 2005 Window Header #}
      <div
        class="border-b border-[#c6d7e0] bg-[#e4eef2] px-3 py-1.5 flex flex-wrap items-center justify-between gap-2 shadow-[inset_0_1px_0_#fff]">
        <div class="flex items-baseline gap-1.5 text-sm">
          <span class="text-sm font-bold text-[#556b78] select-none">#{{ loop.index }}</span>
          <h4 class="font-bold text-sm text-[#164b70] tracking-tight uppercase leading-none m-0 inline">
            {% if show.link %}
            <a class="text-[#164b70] underline hover:text-[#c0392b]" href="{{ show.link }}" target="_blank"
              rel="noopener noreferrer">{{ show.title }}</a>
            {% else %}
            {{ show.title }}
            {% endif %}
          </h4>
          {% if show.creator %}
          <span class="text-sm text-[#556b78] font-normal">({{ show.creator }})</span>
          {% endif %}
        </div>
        <div>
          {% if show.status == "currently-watching" %}
          <span
            class="inline-block bg-[#164b70] text-white text-[10px] font-bold px-1.5 py-0.5 shadow-[inset_0_1px_1px_rgba(0,0,0,0.3)]">WATCHING
            NOW</span>
          {% elif show.status == "watched" %}
          <span class="text-[11px] font-bold text-[#2e7d32]">COMPLETED</span>
          {% elif show.status == "plan-to-watch" %}
          <span class="text-[11px] font-bold text-[#556b78]">PLAN TO WATCH</span>
          {% endif %}
        </div>
      </div>

      {# Body #}
      <div class="site-listing-body p-3 bg-[#f8fbfc]">
        {# Left Poster Frame #}
        <div class="site-listing-image-col">
          {% if show.image %}
          <div class="site-listing-frame">
            <img src="{{ show.image }}" alt="{{ show.title }}" />
          </div>
          {% else %}
          <div class="site-listing-placeholder">
            SERIES
          </div>
          {% endif %}
        </div>

        {# Right Details Definition Table #}
        <div class="min-w-0 flex-1 w-full text-xs">
          <table class="w-full text-xs text-[#26343d] border-collapse">
            <tbody>
              {% if show.creator %}
              <tr class="border-b border-[#e1ebf0]">
                <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Creator/Network:</td>
                <td class="py-1 text-[#3b4d57]">{{ show.creator }}</td>
              </tr>
              {% endif %}
              {% if show.status %}
              <tr class="border-b border-[#e1ebf0]">
                <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Status:</td>
                <td class="py-1 text-[#3b4d57]">
                  {% if show.status == "currently-watching" %}Currently
                  Watching{% elif show.status == "watched" %}Completed{% else %}Plan to Watch{% endif %}
                </td>
              </tr>
              {% endif %}
              {% if show.progress %}
              <tr class="border-b border-[#e1ebf0]">
                <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Progress:</td>
                <td class="py-1 text-[#164b70] font-semibold">{{ show.progress }}</td>
              </tr>
              {% endif %}
              {% if show.rating %}
              <tr class="border-b border-[#e1ebf0]">
                <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Score:</td>
                <td class="py-1 text-[#c0392b] font-bold">{{ show.rating }}</td>
              </tr>
              {% endif %}
              {% if show.year %}
              <tr class="border-b border-[#e1ebf0]">
                <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Year:</td>
                <td class="py-1 text-[#556b78]">{{ show.year }}</td>
              </tr>
              {% endif %}
              {% if show.review %}
              <tr class="border-b border-[#e1ebf0]">
                <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Series Notes:</td>
                <td class="py-1 text-[#26343d] leading-relaxed italic">"{{ show.review }}"</td>
              </tr>
              {% endif %}
            </tbody>
          </table>

          {% if show.link %}
          <div class="pt-2 flex justify-end">
            <a class="site-button-2007 inline-block px-3 py-1 text-xs" href="{{ show.link }}" target="_blank"
              rel="noopener noreferrer">
              Series Details &raquo;
            </a>
          </div>
          {% endif %}
        </div>
      </div>
    </div>
    {% endfor %}
    {% else %}
    <div class="border border-[#b7cbd6] bg-[#f4f8fa] px-4 py-3 text-xs text-[#71828b]">
      No TV shows added yet. TV shows added via the admin panel will appear here.
    </div>
    {% endif %}
  </div>
</div>

<p class="mt-6"><a class="text-[#064f83] underline hover:text-[#c0392b]" href="/">← back to home</a></p>
