---
layout: base.njk
title: Anime
headerTagline: WHAT I'M WATCHING
permalink: /about/anime/
aboutTab: anime
---
{# 
  Component / Page: Anime Showcase (Frutiger Aero Grid Layout)
  Description: Displays anime series, films, and animations in a responsive retro-styled poster grid.
  Features:
    - Responsive 2-to-4 column poster grid with aspect-2/3 framing
    - Interactive client-side status filtering (All, Watching, Watched, Plan to Watch)
    - Full details in native accessible Windows 7 Aero <dialog> modals
    - Authentic star ratings, studio credits, genres, format badges, and reviews
  Data Sources: src/_data/anime.json
#}
{% include "components/about-tabs.njk" %}

<h2 class="border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">
  {{ anime.heading or 'Anime & Animation' }}
</h2>
{% if anime.intro %}
  <p class="mt-3 text-sm leading-relaxed text-[#26343d]">{{ anime.intro }}</p>
{% endif %}

{% set totalAnime = anime.series.length if anime.series else 0 %}
{% set watchingAnime = [] %}
{% set watchedAnime = [] %}
{% set planAnime = [] %}
{% if anime.series %}
  {% for item in anime.series %}
    {% if item.status == "currently-watching" %}
      {% set watchingAnime = (watchingAnime.push(item), watchingAnime) %}
    {% elif item.status == "watched" %}
      {% set watchedAnime = (watchedAnime.push(item), watchedAnime) %}
    {% elif item.status == "plan-to-watch" %}
      {% set planAnime = (planAnime.push(item), planAnime) %}
    {% endif %}
  {% endfor %}
{% endif %}

{# Interactive Category Filter Bar #}
<div class="mt-4 mb-6 flex flex-wrap items-center justify-between gap-2 text-xs select-none border-y border-[#b7cbd6] py-2 bg-[#f4f8fa]">
  <div class="flex items-center gap-1.5 flex-wrap">
    <span class="font-bold text-[#164b70] uppercase tracking-wider text-[11px] mr-1">Filter:</span>
    <button
      type="button"
      class="site-button-2007 px-2.5 py-0.5 text-xs font-semibold inline-flex items-center gap-1.5 cursor-pointer anime-filter-btn whitespace-nowrap active"
      data-filter="all"
      title="Show all anime series and films"
    >
      <span>All</span>
      <span class="bg-[#164b70] text-white text-[10px] px-1.5 py-0.5 rounded-full font-bold leading-none inline-flex items-center justify-center">{{ totalAnime }}</span>
    </button>
    <button
      type="button"
      class="site-button-2007 px-2.5 py-0.5 text-xs font-semibold inline-flex items-center gap-1.5 cursor-pointer anime-filter-btn whitespace-nowrap"
      data-filter="currently-watching"
      title="Show anime currently watching"
    >
      <svg class="w-3.5 h-3.5 shrink-0 inline-block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="15" x="2" y="7" rx="2" ry="2"/><polyline points="17 2 12 7 7 2"/></svg>
      <span>Watching</span>
      <span class="bg-[#164b70] text-white text-[10px] px-1.5 py-0.5 rounded-full font-bold leading-none inline-flex items-center justify-center">{{ watchingAnime.length }}</span>
    </button>
    <button
      type="button"
      class="site-button-2007 px-2.5 py-0.5 text-xs font-semibold inline-flex items-center gap-1.5 cursor-pointer anime-filter-btn whitespace-nowrap"
      data-filter="watched"
      title="Show watched / completed anime"
    >
      <svg class="w-3.5 h-3.5 shrink-0 inline-block text-[#2e7d32]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
      <span>Watched</span>
      <span class="bg-[#2e7d32] text-white text-[10px] px-1.5 py-0.5 rounded-full font-bold leading-none inline-flex items-center justify-center">{{ watchedAnime.length }}</span>
    </button>
    <button
      type="button"
      class="site-button-2007 px-2.5 py-0.5 text-xs font-semibold inline-flex items-center gap-1.5 cursor-pointer anime-filter-btn whitespace-nowrap"
      data-filter="plan-to-watch"
      title="Show planned anime"
    >
      <svg class="w-3.5 h-3.5 shrink-0 inline-block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/></svg>
      <span>Plan to Watch</span>
      <span class="bg-[#556b78] text-white text-[10px] px-1.5 py-0.5 rounded-full font-bold leading-none inline-flex items-center justify-center">{{ planAnime.length }}</span>
    </button>
  </div>
  <span class="text-[11px] text-[#556b78] font-medium" id="anime-count-display">Showing {{ totalAnime }} of {{ totalAnime }} series</span>
</div>

{# Macro to render individual anime poster cards #}
{% macro renderAnimeCard(item, idx) %}
  {% set dialogId = "anime-dialog-" ~ idx %}
  <article
    class="site-card border border-[#9bb0be] bg-white p-2.5 flex flex-col justify-between shadow-[2px_2px_0_#cad6de] hover:border-[#164b70] transition-colors group anime-item"
    data-status="{{ item.status }}"
  >
    <button
      type="button"
      class="w-full text-left cursor-pointer flex flex-col h-full focus:outline-dotted focus:outline-2 focus:outline-[#164b70]"
      onclick="document.getElementById('{{ dialogId }}').showModal()"
      aria-haspopup="dialog"
      aria-controls="{{ dialogId }}"
      title="Click to view full details for {{ item.title }}"
    >
      {# Anime Poster Frame with 2:3 Aspect Ratio #}
      <div class="relative w-full aspect-2/3 overflow-hidden bg-[#e4eef2] border border-[#7892a3] p-1.5 bg-white shadow-[inset_0_1px_2px_rgba(0,0,0,0.1)] flex items-center justify-center">
        {% if item.image %}
          <img
            src="{{ item.image }}"
            alt="{{ item.imageAlt or item.title }}"
            class="w-full h-auto max-h-full object-contain block mx-auto drop-shadow-[0_2px_4px_rgba(0,0,0,0.12)]"
            loading="lazy"
          />
        {% else %}
          <div class="w-full h-full flex flex-col items-center justify-center text-center p-2 bg-[#dce9ef]">
            <span class="text-xs font-bold text-[#164b70] uppercase">ANIME</span>
            <span class="text-[10px] text-[#556b78] mt-1 line-clamp-2">{{ item.title }}</span>
          </div>
        {% endif %}

        {# Status Badge (Top Right) #}
        <div class="absolute top-1.5 right-1.5 shadow-[1px_1px_2px_rgba(0,0,0,0.3)]">
          {% if item.status == "currently-watching" %}
            <span class="inline-block bg-[#164b70] text-white text-[9px] font-bold px-1.5 py-0.5 tracking-wider uppercase">Watching</span>
          {% elif item.status == "watched" %}
            <span class="inline-block bg-[#2e7d32] text-white text-[9px] font-bold px-1.5 py-0.5 tracking-wider uppercase">Watched</span>
          {% else %}
            <span class="inline-block bg-[#556b78] text-white text-[9px] font-bold px-1.5 py-0.5 tracking-wider uppercase">Plan</span>
          {% endif %}
        </div>

        {# Format Badge (Bottom Left) #}
        {% if item.type %}
          <div class="absolute bottom-1.5 left-1.5 shadow-[1px_1px_2px_rgba(0,0,0,0.3)]">
            <span class="inline-block bg-[#0a1926]/80 text-white text-[9px] font-semibold px-1.5 py-0.5 tracking-wide backdrop-blur-xs">
              {{ item.type }}
            </span>
          </div>
        {% endif %}
      </div>

      {# Anime Title, Studio & Metadata #}
      <div class="mt-2.5 flex-1 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between text-[10px] text-[#485b66] font-bold">
            <span>#{{ idx }}</span>
            {% if item.year %}<span>{{ item.year }}</span>{% endif %}
          </div>
          <h3 class="font-bold text-xs text-[#164b70] tracking-tight uppercase leading-snug line-clamp-2 min-h-8 flex items-start group-hover:text-[#c0392b] group-hover:underline mt-0.5">
            {{ item.title }}
          </h3>
          <p class="text-[11px] text-[#556b78] line-clamp-1 min-h-[1.1rem] flex items-center mt-0.5">
            {% if item.studio %}Studio: {{ item.studio }}{% endif %}
          </p>
          {% if item.genres %}
            <p class="text-[10px] text-[#7892a3] line-clamp-1 truncate mt-0.5" title="{{ item.genres }}">
              {{ item.genres }}
            </p>
          {% endif %}
        </div>

        <div class="mt-2 pt-1.5 border-t border-dashed border-[#d8e5ec] flex items-center justify-between text-[11px]">
          {% if item.rating %}
            <span class="text-[#c0392b] font-bold text-[10px]">{{ item.rating | ratingStars }}</span>
          {% else %}
            <span></span>
          {% endif %}
          <span class="text-[#064f83] font-semibold underline text-[10px] group-hover:text-[#c0392b]">Details &raquo;</span>
        </div>
      </div>
    </button>

    {# Native HTML5 Accessible Modal Dialog #}
    <dialog
      id="{{ dialogId }}"
      class="site-book-dialog p-0 bg-transparent border-0 max-w-xl w-[92vw] m-auto backdrop:backdrop-blur-xs"
    >
      <div class="win7-aero-window p-1 shadow-[0_20px_50px_rgba(0,0,0,0.5)]">
        <div class="win7-aero-glass-shine"></div>

        <div class="win7-aero-titlebar pr-14">
          <div class="win7-title-text truncate">
            #{{ idx }} — {{ item.title }}
          </div>
          <button
            type="button"
            class="win7-btn-close"
            onclick="document.getElementById('{{ dialogId }}').close()"
            aria-label="Close details"
          >
            <span>✕</span>
          </button>
        </div>

        <div class="win7-client-area bg-[#f8fbfc] p-3 sm:p-4 text-xs">
          <div class="flex flex-col sm:flex-row items-center sm:items-start gap-4">
            {# Left Poster Frame #}
            <div class="shrink-0 w-28 sm:w-36 flex items-start justify-center">
              {% if item.image %}
                <div class="site-listing-frame w-full shadow-[2px_2px_0_#cad6de] border border-[#7892a3] bg-white p-1">
                  <img
                    src="{{ item.image }}"
                    alt="{{ item.imageAlt or item.title }}"
                    class="w-full h-auto object-contain block mx-auto"
                  />
                </div>
              {% else %}
                <div class="w-full aspect-2/3 flex items-center justify-center bg-[#dce9ef] border border-[#7892a3] font-bold text-[#164b70]">
                  ANIME
                </div>
              {% endif %}
            </div>

            {# Right Details Table #}
            <div class="min-w-0 flex-1 w-full">
              <h3 class="text-base font-bold text-[#164b70] tracking-tight uppercase leading-snug">
                {{ item.title }}
              </h3>
              {% if item.studio %}
                <p class="text-xs text-[#556b78] mt-0.5">
                  Studio: <span class="font-bold text-[#26343d]">{{ item.studio }}</span>
                </p>
              {% endif %}

              <table class="w-full mt-3 text-xs border-collapse">
                <tbody>
                  {% if item.type %}
                    <tr class="border-b border-[#e1ebf0]">
                      <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Format:</td>
                      <td class="py-1 text-[#3b4d57]">
                        {{ item.type }}{% if item.progress %} &bull; {{ item.progress }}{% endif %}
                      </td>
                    </tr>
                  {% endif %}
                  {% if item.status %}
                    <tr class="border-b border-[#e1ebf0]">
                      <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Status:</td>
                      <td class="py-1 text-[#3b4d57]">
                        {% if item.status == "currently-watching" %}
                          <span class="inline-block bg-[#164b70] text-white text-[10px] font-bold px-1.5 py-0.2 shadow-[inset_0_1px_1px_rgba(0,0,0,0.3)]">WATCHING NOW</span>
                        {% elif item.status == "watched" %}
                          <span class="text-[11px] font-bold text-[#2e7d32]">COMPLETED / WATCHED</span>
                        {% else %}
                          <span class="text-[11px] font-bold text-[#556b78]">PLAN TO WATCH</span>
                        {% endif %}
                      </td>
                    </tr>
                  {% endif %}
                  {% if item.year %}
                    <tr class="border-b border-[#e1ebf0]">
                      <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Period:</td>
                      <td class="py-1 text-[#556b78]">{{ item.year }}</td>
                    </tr>
                  {% endif %}
                  {% if item.genres %}
                    <tr class="border-b border-[#e1ebf0]">
                      <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Genres:</td>
                      <td class="py-1 text-[#3b4d57]">{{ item.genres }}</td>
                    </tr>
                  {% endif %}
                  {% if item.rating %}
                    <tr class="border-b border-[#e1ebf0]">
                      <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Rating:</td>
                      <td class="py-1 text-[#c0392b] font-bold">{{ item.rating | ratingStars }} ({{ item.rating }}/5)</td>
                    </tr>
                  {% endif %}
                  {% if item.review %}
                    <tr class="border-b border-[#e1ebf0]">
                      <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Viewer Notes:</td>
                      <td class="py-1 text-[#26343d] leading-relaxed italic bg-[#f0f6f9] p-2 rounded mt-1 block sm:table-cell">
                        "{{ item.review }}"
                      </td>
                    </tr>
                  {% endif %}
                </tbody>
              </table>

              {% if item.link %}
                <div class="mt-3 pt-2 border-t border-[#e1ebf0] flex items-center justify-between">
                  <a
                    class="site-button-2007 px-3 py-1 text-xs inline-flex items-center gap-1.5"
                    href="{{ item.link }}"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <svg class="w-3 h-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                    <span>View on MyAnimeList / Official</span>
                    <span>&raquo;</span>
                  </a>
                  <button
                    type="button"
                    class="site-button-2007 px-3 py-1 cursor-pointer hidden sm:inline-block"
                    onclick="document.getElementById('{{ dialogId }}').close()"
                  >
                    Close
                  </button>
                </div>
              {% endif %}
            </div>
          </div>

          <div class="mt-3 pt-2 border-t border-[#d8e5ec] flex justify-center sm:hidden">
            <button
              type="button"
              class="site-button-2007 px-4 py-1 cursor-pointer"
              onclick="document.getElementById('{{ dialogId }}').close()"
            >
              Close
            </button>
          </div>
        </div>
      </div>
    </dialog>
  </article>
{% endmacro %}

{# Responsive Poster Grid #}
<div class="mt-6">
  {% if anime.series and anime.series.length > 0 %}
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4" id="anime-grid">
      {% for item in anime.series %}
        {{ renderAnimeCard(item, loop.index) }}
      {% endfor %}
    </div>
  {% else %}
    <p class="text-sm italic text-[#556b78]">No anime listed yet.</p>
  {% endif %}
</div>

{# Client-side Status Filter Script #}
<script>
  (function() {
    var btns = document.querySelectorAll('.anime-filter-btn');
    var items = document.querySelectorAll('.anime-item');
    var countDisplay = document.getElementById('anime-count-display');
    if (!btns.length || !items.length) return;

    btns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var filter = btn.getAttribute('data-filter');
        btns.forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');

        var visibleCount = 0;
        items.forEach(function(item) {
          var status = item.getAttribute('data-status');
          if (filter === 'all' || status === filter) {
            item.style.display = '';
            visibleCount++;
          } else {
            item.style.display = 'none';
          }
        });

        if (countDisplay) {
          countDisplay.textContent = 'Showing ' + visibleCount + ' of ' + items.length + ' series';
        }
      });
    });
  })();
</script>

<p class="mt-8">
  <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/">← back to home</a>
</p>
