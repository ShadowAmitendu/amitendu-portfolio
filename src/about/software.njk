---
layout: base.njk
title: Software
headerTagline: TOOLS & APPS I USE
permalink: /about/software/
aboutTab: software
---
{% include "components/about-tabs.njk" %}

<h2 class="border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">
  {{ software.heading or 'Software & Tools' }}</h2>
{% if software.intro %}
<p class="mt-3 text-sm leading-relaxed text-[#26343d]">{{ software.intro }}</p>
{% endif %}

<div class="mt-6">
  {% if software.items and software.items.length > 0 %}
  <div class="site-software-grid">
    {% for item in software.items %}
    <div class="flex items-center gap-2.5 min-w-0">
      {% if item.icon %}
      <img src="{{ item.icon }}" alt="{{ item.name }} icon" class="w-5 h-5 object-contain shrink-0" loading="lazy" />
      {% else %}
      <span class="w-5 h-5 flex items-center justify-center shrink-0 text-[#556b78]" aria-hidden="true">
        <svg class="w-4 h-4 fill-current" viewBox="0 0 16 16"><path d="M2 3a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3zm1 1v2h10V4H3zm10 3H3v6h10V7z"/></svg>
      </span>
      {% endif %}
      {% if item.link %}
      <a class="text-[#064f83] underline hover:text-[#c0392b] text-[14px] leading-snug truncate" href="{{ item.link }}" target="_blank"
        rel="noopener noreferrer" title="{{ item.name }}">{{ item.name }}</a>
      {% else %}
      <span class="text-[#064f83] underline text-[14px] leading-snug truncate" title="{{ item.name }}">{{ item.name }}</span>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% else %}
  <div class="w-full border border-[#b7cbd6] bg-[#f4f8fa] px-4 py-3 text-xs text-[#485b66]">
    No software or tools added yet. Software added via the admin panel will appear here.
  </div>
  {% endif %}
</div>

<p class="mt-8"><a class="text-[#064f83] underline hover:text-[#c0392b]" href="/">← back to home</a></p>
