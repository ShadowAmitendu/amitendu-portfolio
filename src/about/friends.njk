---
layout: base.njk
title: Friends
headerTagline: FRIENDS & ALLIES
permalink: /about/friends/
aboutTab: friends

---
{% include "components/about-tabs.njk" %}

<h2 class="border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">
  {{ friends.heading or 'Friends & Web Neighbours' }}
</h2>
{% if friends.intro %}
  <p class="mt-3 text-sm leading-relaxed text-[#26343d]">{{ friends.intro }}</p>
{% endif %}

<div class="mt-6">
  {% if friends.items and friends.items.length > 0 %}
    {# Responsive Friends Grid #}
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
      {% for friend in friends.items %}
        <article class="site-card border border-[#9bb0be] bg-white p-2.5 flex flex-col justify-between shadow-[2px_2px_0_#cad6de] hover:border-[#164b70] transition-colors group">
          <button
            type="button"
            class="w-full text-left cursor-pointer flex flex-col h-full focus:outline-dotted focus:outline-2 focus:outline-[#164b70]"
            onclick="document.getElementById('friend-dialog-{{ loop.index }}').showModal()"
            aria-haspopup="dialog"
            aria-controls="friend-dialog-{{ loop.index }}"
            title="Click to view details for {{ friend.name }}"
          >
            {# Friend Portrait Frame with 3/4 Aspect Ratio #}
            <div class="relative w-full aspect-3/4 overflow-hidden bg-[#e4eef2] border border-[#7892a3] p-1.5 shadow-[inset_0_1px_2px_rgba(0,0,0,0.1)] flex items-center justify-center">
              {% if friend.avatar %}
                <img
                  src="{{ friend.avatar }}"
                  alt="{{ friend.avatarAlt or friend.name }}"
                  class="w-full h-auto max-h-full object-contain block mx-auto drop-shadow-[0_2px_4px_rgba(0,0,0,0.12)]"
                  loading="lazy"
                />
              {% else %}
                <div class="w-full h-full flex flex-col items-center justify-center text-center p-2 bg-[#dce9ef]">
                  <span class="text-xs font-bold text-[#164b70] uppercase"
                  >PORTRAIT</span>
                  <span class="text-[10px] text-[#556b78] mt-1 line-clamp-2">{{
                    friend.name
                  }}</span>
                </div>
              {% endif %}
            </div>

            {# Friend Name & Relationship (Fixed/uniform heights to align text everywhere) #}
            <div class="mt-2.5 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="font-bold text-xs text-[#164b70] tracking-tight uppercase leading-snug line-clamp-2 min-h-8 flex items-start group-hover:text-[#c0392b] group-hover:underline">
                  {{ friend.name }}
                </h3>
                <p class="text-[11px] text-[#556b78] line-clamp-1 min-h-[1.1rem] flex items-center mt-0.5">
                  {% if friend.relationship %}{{ friend.relationship }}{%
                    endif
                  %}
                </p>
              </div>

              <div class="mt-2 pt-1.5 border-t border-dashed border-[#d8e5ec] flex items-center justify-between text-[11px]">
                {%
                  if friend.url and friend.url != '#' and friend.url != 'example.com'
                %}
                  <span class="text-[#2e7d32] font-semibold text-[10px]"
                  >● Online</span>
                {% else %}
                  <span></span>
                {% endif %}
                <span
                  class="text-[#064f83] font-semibold underline text-[10px] group-hover:text-[#c0392b]"
                >Details &raquo;</span>
              </div>
            </div>
          </button>

          {# Native HTML5 Accessible Modal Dialog #}
          <dialog
            id="friend-dialog-{{ loop.index }}"
            class="site-friend-dialog p-0 bg-transparent border-0 max-w-xl w-[92vw] m-auto backdrop:backdrop-blur-xs"
          >
            <div class="win7-aero-window p-1 shadow-[0_20px_50px_rgba(0,0,0,0.5)]">
              <div class="win7-aero-glass-shine"></div>

              {# Dialog Aero Titlebar #}
              <div class="win7-aero-titlebar pr-14">
                <div class="win7-title-text truncate">
                  {{ friend.name }}
                </div>
                <button
                  type="button"
                  class="win7-btn-close"
                  onclick="document.getElementById('friend-dialog-{{ loop.index }}').close()"
                  aria-label="Close details"
                >
                  <span>✕</span>
                </button>
              </div>

              {# Dialog Body #}
              <div class="win7-client-area bg-[#f8fbfc] p-3 sm:p-4 text-xs">
                <div class="flex flex-col sm:flex-row items-center sm:items-start gap-4">
                  {# Left Avatar Frame balanced to w-28 sm:w-32 with full width and auto height #}
                  <div class="shrink-0 w-28 sm:w-32 flex items-start justify-center">
                    {% if friend.avatar %}
                      <div class="site-listing-frame w-full shadow-[2px_2px_0_#cad6de] border border-[#7892a3] bg-white p-1">
                        <img
                          src="{{ friend.avatar }}"
                          alt="{{ friend.avatarAlt or friend.name }}"
                          class="w-full h-auto object-contain block mx-auto"
                        />
                      </div>
                    {% else %}
                      <div class="w-full aspect-3/4 flex items-center justify-center bg-[#dce9ef] border border-[#7892a3] font-bold text-[#164b70]">
                        PORTRAIT
                      </div>
                    {% endif %}
                  </div>

                  {# Right Details Table #}
                  <div class="min-w-0 flex-1 w-full">
                    <h3 class="text-base font-bold text-[#164b70] tracking-tight uppercase leading-snug">
                      {{ friend.name }}
                    </h3>
                    {% if friend.relationship %}
                      <p class="text-xs text-[#556b78] mt-0.5">
                        <span class="font-bold text-[#26343d]">{{
                          friend.relationship
                        }}</span>
                      </p>
                    {% endif %}

                    <table class="w-full mt-3 text-xs border-collapse">
                      <tbody>
                        {% if friend.relationship %}
                          <tr class="border-b border-[#e1ebf0]">
                            <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">
                              Relationship:
                            </td>
                            <td class="py-1 text-[#26343d]">
                              {{ friend.relationship }}
                            </td>
                          </tr>
                        {% endif %}
                        {% if friend.url and friend.url != '#' %}
                          <tr class="border-b border-[#e1ebf0]">
                            <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">
                              Website:
                            </td>
                            <td class="py-1 text-[#064f83] truncate">
                              <a
                                class="underline hover:text-[#c0392b]"
                                href="{% if not friend.url.startsWith('http') and friend.url != 'example.com' %}https://{{ friend.url }}{% elif friend.url == 'example.com' %}https://example.com{% else %}{{ friend.url }}{% endif %}"
                                target="_blank"
                                rel="noopener noreferrer"
                              >{{ friend.url }}</a>
                            </td>
                          </tr>
                        {% endif %}
                        {% if friend.description %}
                          <tr class="border-b border-[#e1ebf0]">
                            <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">
                              Notes:
                            </td>
                            <td class="py-1 text-[#26343d] leading-relaxed italic whitespace-pre-line">
                              "{{ friend.description }}"
                            </td>
                          </tr>
                        {% endif %}
                      </tbody>
                    </table>

                    {% if friend.url and friend.url != '#' %}
                      <div class="mt-3 flex justify-start">
                        <a
                          class="site-button-2007 inline-block px-3 py-1 text-xs"
                          href="{% if not friend.url.startsWith('http') and friend.url != 'example.com' %}https://{{ friend.url }}{% elif friend.url == 'example.com' %}https://example.com{% else %}{{ friend.url }}{% endif %}"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          Visit Homepage &raquo;
                        </a>
                      </div>
                    {% endif %}
                  </div>
                </div>

                {# Close button hidden on desktop; red close button in titlebar is used #}
                <div class="mt-3 pt-2 border-t border-[#d8e5ec] flex justify-center sm:hidden">
                  <button
                    type="button"
                    class="site-button-2007 px-4 py-1 cursor-pointer"
                    onclick="document.getElementById('friend-dialog-{{ loop.index }}').close()"
                  >
                    Close
                  </button>
                </div>
              </div>
            </div>
          </dialog>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <div class="border border-[#b7cbd6] bg-[#f4f8fa] px-4 py-3 text-xs text-[#485b66]">
      No friends added yet. Friends added via the admin panel will appear here.
    </div>
  {% endif %}
</div>

<script>
// Close dialog when clicking on the backdrop outside the window
document.querySelectorAll("dialog.site-friend-dialog").forEach(
  function(dialog) {
    dialog.addEventListener("click", function(e) {
      var rect = dialog.getBoundingClientRect();
      var isInDialog = rect.top <= e.clientY
        && e.clientY <= rect.top + rect.height
        && rect.left <= e.clientX && e.clientX <= rect.left + rect.width;
      if (!isInDialog) {
        dialog.close();
      }
    });
  },
);
</script>

<p class="mt-6">
  <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/"
  >← back to home</a>
</p>
