---
layout: base.njk
title: Games
headerTagline: WHAT I'M PLAYING
permalink: /about/games/
aboutTab: games

---
{% include "components/about-tabs.njk" %}

<div class="border-b border-[#b7cbd6] pb-2 flex flex-wrap items-baseline justify-between gap-2">
  <div>
    <h2 class="text-lg font-bold text-[#164b70] m-0">
      {{ games.heading or 'Gaming Timeline' }}
    </h2>
    {% if games.intro %}
      <p class="mt-1 text-sm leading-relaxed text-[#26343d]">
        {{ games.intro }}
      </p>
    {% endif %}
  </div>
</div>

{% set totalGames = games.items.length %}

{# Timeline Header & Direction Toggle #}
<div class="my-4 p-2 bg-[#f4f8fa] border border-[#b7cbd6] flex items-center justify-between text-xs select-none">
  <span class="font-bold text-[#164b70] uppercase tracking-wider text-[11px]">Timeline Flow</span>
  <button
    type="button"
    id="btn-toggle-timeline"
    class="site-button-2007 px-2.5 py-1 text-xs font-semibold inline-flex items-center gap-1.5 cursor-pointer"
    onclick="toggleTimelineOrder()"
    title="Toggle timeline order"
    aria-label="Toggle timeline order"
  >
    <svg class="w-3.5 h-3.5 shrink-0 text-[#164b70]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m21 16-4 4-4-4"/>
      <path d="M17 20V4"/>
      <path d="m3 8 4-4 4 4"/>
      <path d="M7 4v16"/>
    </svg>
    <span id="timeline-flow-text" class="font-bold text-[#164b70]">#{{ totalGames }} &rarr; #1</span>
  </button>
</div>

{# Timeline Origin Banner #}
<div id="timeline-banner-top" class="mb-4 px-3 py-1.5 bg-[#eaf2f6] border-l-4 border-[#164b70] border-y border-r flex items-center justify-between text-xs">
  <span class="font-bold text-[#164b70] flex items-center gap-1.5">
    <svg class="w-3.5 h-3.5 shrink-0 text-[#c0392b]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" x2="4" y1="22" y2="15"/></svg>
    <span id="timeline-banner-top-text">ORIGIN: Where It All Began (First Games Played)</span>
  </span>
  <span id="timeline-banner-top-num" class="text-[11px] text-[#556b78] font-semibold">Game #{{
      totalGames
    }}</span>
</div>

{# The Vertical Timeline Container #}
<div
  class="relative pl-7 sm:pl-9 mt-4 before:content-[''] before:absolute before:left-3 sm:before:left-3.5 before:top-2 before:bottom-4 before:w-0.5 before:bg-[#8faab8]"
  id="games-timeline-container"
>
  <div class="flex flex-col space-y-6" id="games-timeline-list">
    {% if games.items and games.items.length > 0 %}
      {% for game in games.items | reverse %}
        {% set milestoneNum = loop.revindex %}
        <div
          class="relative timeline-item"
          data-chrono="{{ loop.index }}"
          data-milestone="{{ milestoneNum }}"
        >
          {# Timeline Node Marker #}
          <div class="absolute -left-7 sm:-left-9 top-2.5 flex items-center justify-center w-6 sm:w-7 h-6 sm:h-7 rounded-full border-2 {% if milestoneNum == 1 %}border-[#2e7d32] bg-[#e8f5e9] text-[#1b5e20]{% else %}border-[#164b70] bg-[#f0f6f9] text-[#164b70]{% endif %} shadow-[0_1px_3px_rgba(0,0,0,0.18)] select-none">
            <span class="font-bold text-[10px] sm:text-[11px] leading-none">{{
              milestoneNum
            }}</span>
          </div>

          {# Card Window #}
          <article class="site-card border border-[#9bb0be] bg-white p-0 shadow-[2px_2px_0_#cad6de] hover:border-[#164b70] transition-colors">
            {# 2005 Window Header #}
            <div class="border-b border-[#c6d7e0] bg-[#e4eef2] px-3 py-1.5 flex flex-wrap items-center justify-between gap-2 shadow-[inset_0_1px_0_#fff]">
              <div class="flex items-baseline gap-2 text-sm min-w-0">
                <span
                  class="site-badge font-bold text-xs bg-[#164b70] text-white px-1.5 py-0.2 shadow-[inset_0_1px_1px_rgba(0,0,0,0.25)] select-none"
                >
                  #{{ milestoneNum }}
                </span>
                <h3 class="font-bold text-sm text-[#164b70] tracking-tight uppercase leading-none m-0 truncate">
                  {% if game.link %}
                    <a
                      class="text-[#164b70] underline hover:text-[#c0392b]"
                      href="{{ game.link }}"
                      target="_blank"
                      rel="noopener noreferrer"
                    >{{ game.name }}</a>
                  {% else %}
                    {{ game.name }}
                  {% endif %}
                </h3>
                {% if game.publisher %}
                  <span
                    class="text-xs text-[#556b78] font-normal truncate hidden sm:inline"
                  >({{ game.publisher }})</span>
                {% elif game.platform %}
                  <span
                    class="text-xs text-[#556b78] font-normal truncate hidden sm:inline"
                  >({{ game.platform }})</span>
                {% endif %}
              </div>

              <div>
                {% if game.playingRightNow %}
                  <span
                    class="inline-flex items-center gap-1 bg-[#164b70] text-white text-[10px] font-bold px-2 py-0.5 shadow-[inset_0_1px_1px_rgba(0,0,0,0.3)]"
                  >
                    <span
                      class="w-1.5 h-1.5 rounded-full bg-[#22c55e] inline-block animate-pulse"
                    ></span>
                    <span>PLAYING RIGHT NOW</span>
                  </span>
                {% elif game.status == "completed" %}
                  <span
                    class="inline-block bg-[#2e7d32] text-white text-[10px] font-bold px-1.5 py-0.5 uppercase tracking-wide"
                  >COMPLETED</span>
                {% elif game.status == "on-hold" %}
                  <span
                    class="inline-block bg-[#d97706] text-white text-[10px] font-bold px-1.5 py-0.5 uppercase tracking-wide"
                  >ON HOLD</span>
                {% elif game.status == "backlog" %}
                  <span
                    class="inline-block bg-[#4f46e5] text-white text-[10px] font-bold px-1.5 py-0.5 uppercase tracking-wide"
                  >BACKLOG</span>
                {% elif game.status == "dropped" %}
                  <span class="text-[11px] font-bold text-[#485b66] uppercase"
                  >DROPPED</span>
                {% elif game.status %}
                  <span
                    class="text-[11px] font-bold text-[#556b78] uppercase"
                  >{{ game.status | replace('-', ' ') }}</span>
                {% endif %}
              </div>
            </div>

            {# Body #}
            <div class="site-listing-body p-3 bg-[#f8fbfc]">
              {# Left Icon / Box Art #}
              {% set gameImg = game.image or game.icon %}
              {%
                set gameAlt = game.imageAlt or game.iconAlt or game.name or 'Game cover'
              %}
              <div class="site-listing-image-col">
                {% if gameImg %}
                  <div class="site-listing-frame shadow-[1px_1px_2px_rgba(0,0,0,0.12)]">
                    <img
                      src="{{ gameImg }}"
                      alt="{{ gameAlt }}"
                      loading="lazy"
                    />
                  </div>
                {% else %}
                  <div class="site-listing-placeholder">
                    GAME
                  </div>
                {% endif %}
              </div>

              {# Right Details Table #}
              <div class="min-w-0 flex-1 w-full text-xs">
                <table class="w-full text-xs text-[#26343d] border-collapse">
                  <tbody>
                    {% if game.publisher %}
                      <tr class="border-b border-[#e1ebf0]">
                        <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">
                          Publisher:
                        </td>
                        <td class="py-1 text-[#3b4d57]">
                          {{ game.publisher }}
                        </td>
                      </tr>
                    {% endif %}
                    {% if game.platform %}
                      <tr class="border-b border-[#e1ebf0]">
                        <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">
                          Platform:
                        </td>
                        <td class="py-1 text-[#3b4d57]">
                          <span
                            class="inline-block bg-[#eef4f7] border border-[#b7cbd6] px-1.5 py-0.2 rounded font-semibold text-[#164b70]"
                          >
                            {{ game.platform }}
                          </span>
                        </td>
                      </tr>
                    {% endif %}
                    {% if game.status %}
                      <tr class="border-b border-[#e1ebf0]">
                        <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">
                          Status:
                        </td>
                        <td class="py-1 text-[#3b4d57]">
                          <strong class="capitalize">{{
                            game.status | replace('-', ' ')
                          }}</strong>
                          {% if game.tags and game.tags.length > 0 %}
                            <span class="text-[#485b66] ml-1"
                            >({{ game.tags | join(', ') }})</span>
                          {% endif %}
                        </td>
                      </tr>
                    {% endif %}
                    {% if game.description %}
                      <tr class="border-b border-[#e1ebf0]">
                        <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">
                          Timeline Note:
                        </td>
                        <td class="py-1 text-[#26343d] leading-relaxed italic bg-[#f0f6f9] p-2 rounded mt-1 block sm:table-cell">
                          "{{ game.description }}"
                        </td>
                      </tr>
                    {% endif %}
                  </tbody>
                </table>

                {% if game.link %}
                  <div class="pt-2 flex justify-end">
                    <a
                      class="site-button-2007 inline-block px-3 py-1 text-xs font-semibold"
                      href="{{ game.link }}"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Official Game Page &raquo;
                    </a>
                  </div>
                {% endif %}
              </div>
            </div>
          </article>
        </div>
      {% endfor %}
    {% else %}
      <div class="border border-[#b7cbd6] bg-[#f4f8fa] px-4 py-3 text-xs text-[#485b66]">
        No games added yet. Games added via the admin panel will appear here.
      </div>
    {% endif %}
  </div>
</div>

{# Timeline Present Day Banner #}
<div id="timeline-banner-bottom" class="mt-6 px-3 py-1.5 bg-[#eaf2f6] border-l-4 border-[#2e7d32] border-y border-r flex items-center justify-between text-xs">
  <span class="font-bold text-[#2e7d32] flex items-center gap-1.5">
    <span id="timeline-banner-bottom-text">PRESENT: Latest &amp; Ongoing Gaming Era</span>
  </span>
  <span id="timeline-banner-bottom-num" class="text-[11px] text-[#2e7d32] font-semibold">Game #1</span>
</div>

<script>
var currentTimelineOrder = "chrono";
var totalTimelineGames = {{ totalGames }};

function toggleTimelineOrder() {
  currentTimelineOrder = (currentTimelineOrder === "chrono") ? "reverse" : "chrono";
  setTimelineOrder(currentTimelineOrder);
}

function setTimelineOrder(order) {
  var list = document.getElementById("games-timeline-list");
  var label = document.getElementById("timeline-flow-text");
  var bannerTopText = document.getElementById("timeline-banner-top-text");
  var bannerTopNum = document.getElementById("timeline-banner-top-num");
  var bannerBottomText = document.getElementById("timeline-banner-bottom-text");
  var bannerBottomNum = document.getElementById("timeline-banner-bottom-num");
  if (!list) return;

  var items = Array.prototype.slice.call(list.children);

  if (order === "reverse") {
    // Latest (#1) first down to Starting (#total)
    items.sort(function(a, b) {
      return parseInt(a.getAttribute("data-milestone"), 10)
        - parseInt(b.getAttribute("data-milestone"), 10);
    });
    if (label) label.innerHTML = "#1 &rarr; #" + totalTimelineGames;
    if (bannerTopText) bannerTopText.textContent = "PRESENT: Latest & Ongoing Gaming Era";
    if (bannerTopNum) bannerTopNum.textContent = "Game #1";
    if (bannerBottomText) bannerBottomText.textContent = "ORIGIN: Where It All Began (First Games Played)";
    if (bannerBottomNum) bannerBottomNum.textContent = "Game #" + totalTimelineGames;
  } else {
    // Starting (#total) first down to Latest (#1)
    items.sort(function(a, b) {
      return parseInt(b.getAttribute("data-milestone"), 10)
        - parseInt(a.getAttribute("data-milestone"), 10);
    });
    if (label) label.innerHTML = "#" + totalTimelineGames + " &rarr; #1";
    if (bannerTopText) bannerTopText.textContent = "ORIGIN: Where It All Began (First Games Played)";
    if (bannerTopNum) bannerTopNum.textContent = "Game #" + totalTimelineGames;
    if (bannerBottomText) bannerBottomText.textContent = "PRESENT: Latest & Ongoing Gaming Era";
    if (bannerBottomNum) bannerBottomNum.textContent = "Game #1";
  }

  items.forEach(function(item) {
    list.appendChild(item);
  });
}
</script>

<p class="mt-8">
  <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/"
  >← back to home</a>
</p>
