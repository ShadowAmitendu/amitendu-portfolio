---
layout: base.njk
title: Books
headerTagline: WHAT I'M READING
permalink: /about/books/
aboutTab: books
---
{% include "about-tabs.njk" %}

<h2 class="border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">
  {{ books.heading or 'Bookshelf' }}
</h2>
{% if books.intro %}
  <p class="mt-3 text-sm leading-relaxed text-[#26343d]">{{ books.intro }}</p>
{% endif %}

{% set readingBooks = books.items | filterByStatus("reading") %}
{% set readBooks = books.items | filterByStatus("read") %}
{% set toReadBooks = books.items | filterByStatus("to-read") %}

{# Quick Jump / Status Category Bar #}
<div class="mt-4 mb-6 flex flex-wrap items-center gap-1.5 text-xs select-none border-y border-[#b7cbd6] py-2 bg-[#f4f8fa]">
  <span class="font-bold text-[#164b70] uppercase tracking-wider text-[11px] mr-1">Categories:</span>
  <a href="#reading" class="site-button-2007 px-2.5 py-0.5 text-xs font-semibold inline-flex items-center gap-1.5 no-underline">
    <span>📖 Currently Reading</span>
    <span class="bg-[#164b70] text-white text-[10px] px-1.5 py-0.2 rounded-full font-bold">{{ readingBooks.length }}</span>
  </a>
  <a href="#finished" class="site-button-2007 px-2.5 py-0.5 text-xs font-semibold inline-flex items-center gap-1.5 no-underline">
    <span>✅ Finished / Read</span>
    <span class="bg-[#2e7d32] text-white text-[10px] px-1.5 py-0.2 rounded-full font-bold">{{ readBooks.length }}</span>
  </a>
  <a href="#to-read" class="site-button-2007 px-2.5 py-0.5 text-xs font-semibold inline-flex items-center gap-1.5 no-underline">
    <span>📑 Plan to Read</span>
    <span class="bg-[#556b78] text-white text-[10px] px-1.5 py-0.2 rounded-full font-bold">{{ toReadBooks.length }}</span>
  </a>
</div>

{# Macro to render individual book cards #}
{% macro renderBook(book, prefix, idx) %}
  {% set dialogId = "book-dialog-" ~ prefix ~ "-" ~ idx %}
  <article class="site-card border border-[#9bb0be] bg-white p-2.5 flex flex-col justify-between shadow-[2px_2px_0_#cad6de] hover:border-[#164b70] transition-colors group">
    <button
      type="button"
      class="w-full text-left cursor-pointer flex flex-col h-full focus:outline-dotted focus:outline-2 focus:outline-[#164b70]"
      onclick="document.getElementById('{{ dialogId }}').showModal()"
      aria-haspopup="dialog"
      aria-controls="{{ dialogId }}"
      title="Click to view details for {{ book.title }}"
    >
      {# Book Cover Frame with Book Aspect Ratio #}
      <div class="relative w-full aspect-2/3 overflow-hidden bg-[#e4eef2] border border-[#7892a3] p-1.5 shadow-[inset_0_1px_2px_rgba(0,0,0,0.1)] flex items-center justify-center">
        {% if book.image %}
          <img
            src="{{ book.image }}"
            alt="{{ book.imageAlt or book.title }}"
            class="w-full h-auto max-h-full object-contain block mx-auto drop-shadow-[0_2px_4px_rgba(0,0,0,0.12)]"
            loading="lazy"
          />
        {% else %}
          <div class="w-full h-full flex flex-col items-center justify-center text-center p-2 bg-[#dce9ef]">
            <span class="text-xs font-bold text-[#164b70] uppercase">BOOK</span>
            <span class="text-[10px] text-[#556b78] mt-1 line-clamp-2">{{ book.title }}</span>
          </div>
        {% endif %}

        {# Status Tag Ribbon #}
        <div class="absolute top-1.5 right-1.5 shadow-[1px_1px_2px_rgba(0,0,0,0.3)]">
          {% if book.status == "currently-reading" or book.status == "reading" %}
            <span class="inline-block bg-[#164b70] text-white text-[9px] font-bold px-1.5 py-0.5 tracking-wider uppercase">Reading</span>
          {% elif book.status == "read" or book.status == "completed" or book.status == "finished" %}
            <span class="inline-block bg-[#2e7d32] text-white text-[9px] font-bold px-1.5 py-0.5 tracking-wider uppercase">Finished</span>
          {% else %}
            <span class="inline-block bg-[#556b78] text-white text-[9px] font-bold px-1.5 py-0.5 tracking-wider uppercase">Plan</span>
          {% endif %}
        </div>
      </div>

      {# Book Title & Author #}
      <div class="mt-2.5 flex-1 flex flex-col justify-between">
        <div>
          <span class="text-[10px] font-bold text-[#71828b] block select-none">#{{ idx }}</span>
          <h3 class="font-bold text-xs text-[#164b70] tracking-tight uppercase leading-snug line-clamp-2 min-h-8 flex items-start group-hover:text-[#c0392b] group-hover:underline mt-0.5">
            {{ book.title }}
          </h3>
          <p class="text-[11px] text-[#556b78] line-clamp-1 min-h-[1.1rem] flex items-center mt-0.5">
            {% if book.author %}by {{ book.author }}{% endif %}
          </p>
          {% if book.progress %}
            <div class="mt-1">
              <span class="inline-block bg-[#eaf2f6] border border-[#b7cbd6] text-[#164b70] text-[10px] px-1.5 py-0.2 rounded font-semibold truncate max-w-full">
                📍 {{ book.progress }}
              </span>
            </div>
          {% endif %}
        </div>

        <div class="mt-2 pt-1.5 border-t border-dashed border-[#d8e5ec] flex items-center justify-between text-[11px]">
          {% if book.rating %}
            <span class="text-[#c0392b] font-bold text-[10px]">{{ book.rating | ratingStars }}</span>
          {% else %}
            <span></span>
          {% endif %}
          <span class="text-[#064f83] font-semibold underline text-[10px] group-hover:text-[#c0392b]">Details &raquo;</span>
        </div>
      </div>
    </button>

    {# Native HTML5 Accessible Modal Dialog #}
    <dialog
      id="{{ dialogId }}"
      class="site-book-dialog p-0 bg-transparent border-0 max-w-xl w-[92vw] m-auto backdrop:backdrop-blur-xs"
    >
      <div class="win7-aero-window p-1 shadow-[0_20px_50px_rgba(0,0,0,0.5)]">
        <div class="win7-aero-glass-shine"></div>

        <div class="win7-aero-titlebar pr-14">
          <div class="win7-title-text truncate">
            #{{ idx }} — {{ book.title }}
          </div>
          <button
            type="button"
            class="win7-btn-close"
            onclick="document.getElementById('{{ dialogId }}').close()"
            aria-label="Close details"
          >
            <span>✕</span>
          </button>
        </div>

        <div class="win7-client-area bg-[#f8fbfc] p-3 sm:p-4 text-xs">
          <div class="flex flex-col sm:flex-row items-center sm:items-start gap-4">
            <div class="shrink-0 w-28 sm:w-32 flex items-start justify-center">
              {% if book.image %}
                <div class="site-listing-frame w-full shadow-[2px_2px_0_#cad6de] border border-[#7892a3] bg-white p-1">
                  <img
                    src="{{ book.image }}"
                    alt="{{ book.imageAlt or book.title }}"
                    class="w-full h-auto object-contain block mx-auto"
                  />
                </div>
              {% else %}
                <div class="w-full aspect-2/3 flex items-center justify-center bg-[#dce9ef] border border-[#7892a3] font-bold text-[#164b70]">
                  BOOK
                </div>
              {% endif %}
            </div>

            <div class="min-w-0 flex-1 w-full">
              <h3 class="text-base font-bold text-[#164b70] tracking-tight uppercase leading-snug">
                {{ book.title }}
              </h3>
              {% if book.author %}
                <p class="text-xs text-[#556b78] mt-0.5">
                  by <span class="font-bold text-[#26343d]">{{ book.author }}</span>
                </p>
              {% endif %}

              <table class="w-full mt-3 text-xs border-collapse">
                <tbody>
                  <tr class="border-b border-[#e1ebf0]">
                    <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Status:</td>
                    <td class="py-1 text-[#26343d]">
                      {% if book.status == "currently-reading" or book.status == "reading" %}
                        <span class="font-bold text-[#164b70]">Currently Reading</span>
                      {% elif book.status == "read" or book.status == "completed" or book.status == "finished" %}
                        <span class="font-bold text-[#2e7d32]">Finished / Read</span>
                      {% else %}
                        <span class="font-bold text-[#556b78]">Plan to Read</span>
                      {% endif %}
                    </td>
                  </tr>
                  {% if book.progress %}
                    <tr class="border-b border-[#e1ebf0]">
                      <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Current Page:</td>
                      <td class="py-1 text-[#164b70] font-semibold">{{ book.progress }}</td>
                    </tr>
                  {% endif %}
                  {% if book.rating %}
                    <tr class="border-b border-[#e1ebf0]">
                      <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Rating:</td>
                      <td class="py-1 text-[#c0392b] font-bold">{{ book.rating | ratingStars }} ({{ book.rating }}/5)</td>
                    </tr>
                  {% endif %}
                  {% if book.year %}
                    <tr class="border-b border-[#e1ebf0]">
                      <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Year:</td>
                      <td class="py-1 text-[#556b78]">{{ book.year }}</td>
                    </tr>
                  {% endif %}
                  {% if book.review %}
                    <tr class="border-b border-[#e1ebf0]">
                      <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Reader Notes:</td>
                      <td class="py-1 text-[#26343d] leading-relaxed italic bg-[#f0f6f9] p-2 rounded mt-1 block sm:table-cell">
                        "{{ book.review }}"
                      </td>
                    </tr>
                  {% endif %}
                </tbody>
              </table>
            </div>
          </div>

          <div class="mt-3 pt-2 border-t border-[#d8e5ec] flex justify-center sm:hidden">
            <button
              type="button"
              class="site-button-2007 px-4 py-1 cursor-pointer"
              onclick="document.getElementById('{{ dialogId }}').close()"
            >
              Close
            </button>
          </div>
        </div>
      </div>
    </dialog>
  </article>
{% endmacro %}

{# Section 1: Currently Reading #}
<section id="reading" class="mt-4 mb-10 scroll-mt-6">
  <div class="border-b-2 border-[#164b70] pb-1.5 mb-4 flex items-center justify-between gap-2">
    <div class="flex items-center gap-2">
      <span class="text-base select-none">📖</span>
      <h3 class="text-base font-bold text-[#164b70] uppercase tracking-wide m-0">
        Currently Reading
      </h3>
    </div>
    <span class="site-badge font-bold text-xs bg-[#164b70] text-white px-2.5 py-0.5 shadow-[inset_0_1px_1px_rgba(0,0,0,0.25)]">
      {{ readingBooks.length }} Books
    </span>
  </div>
  {% if readingBooks and readingBooks.length > 0 %}
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
      {% for book in readingBooks %}
        {{ renderBook(book, "reading", loop.index) }}
      {% endfor %}
    </div>
  {% else %}
    <p class="text-xs italic text-[#71828b]">No books marked as currently reading right now.</p>
  {% endif %}
</section>

{# Section 2: Finished / Completed #}
<section id="finished" class="mt-10 mb-10 scroll-mt-6">
  <div class="border-b-2 border-[#2e7d32] pb-1.5 mb-4 flex items-center justify-between gap-2">
    <div class="flex items-center gap-2">
      <span class="text-base select-none">✅</span>
      <h3 class="text-base font-bold text-[#2e7d32] uppercase tracking-wide m-0">
        Finished &amp; Completed
      </h3>
    </div>
    <span class="site-badge font-bold text-xs bg-[#2e7d32] text-white px-2.5 py-0.5 shadow-[inset_0_1px_1px_rgba(0,0,0,0.25)]">
      {{ readBooks.length }} Books
    </span>
  </div>
  {% if readBooks and readBooks.length > 0 %}
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
      {% for book in readBooks %}
        {{ renderBook(book, "read", loop.index) }}
      {% endfor %}
    </div>
  {% else %}
    <p class="text-xs italic text-[#71828b]">No finished books recorded yet.</p>
  {% endif %}
</section>

{# Section 3: Plan to Read #}
<section id="to-read" class="mt-10 mb-8 scroll-mt-6">
  <div class="border-b-2 border-[#556b78] pb-1.5 mb-4 flex items-center justify-between gap-2">
    <div class="flex items-center gap-2">
      <span class="text-base select-none">📑</span>
      <h3 class="text-base font-bold text-[#556b78] uppercase tracking-wide m-0">
        Plan to Read (Reading Queue)
      </h3>
    </div>
    <span class="site-badge font-bold text-xs bg-[#556b78] text-white px-2.5 py-0.5 shadow-[inset_0_1px_1px_rgba(0,0,0,0.25)]">
      {{ toReadBooks.length }} Books
    </span>
  </div>
  {% if toReadBooks and toReadBooks.length > 0 %}
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
      {% for book in toReadBooks %}
        {{ renderBook(book, "toread", loop.index) }}
      {% endfor %}
    </div>
  {% else %}
    <p class="text-xs italic text-[#71828b]">No upcoming books in the reading queue.</p>
  {% endif %}
</section>

<script>
// Close dialog when clicking on the backdrop outside the window
document.querySelectorAll("dialog.site-book-dialog").forEach(function(dialog) {
  dialog.addEventListener("click", function(e) {
    var rect = dialog.getBoundingClientRect();
    var isInDialog = rect.top <= e.clientY
      && e.clientY <= rect.top + rect.height
      && rect.left <= e.clientX && e.clientX <= rect.left + rect.width;
    if (!isInDialog) {
      dialog.close();
    }
  });
});
</script>

<p class="mt-8">
  <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/">← back to home</a>
</p>
