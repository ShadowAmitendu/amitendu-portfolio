---
layout: base.njk
title: Books
headerTagline: WHAT I'M READING
permalink: /about/books/
aboutTab: books
---
{% include "about-tabs.njk" %}

<h2 class="border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">
  {{ books.heading or 'Bookshelf' }}</h2>
{% if books.intro %}
<p class="mt-3 text-sm leading-relaxed text-[#26343d]">{{ books.intro }}</p>
{% endif %}

<div class="mt-4 space-y-4">
  {% if books.items and books.items.length > 0 %}
  {# Retro directory toolbar #}
  <div class="border border-[#b7cbd6] bg-[#edf4f7] px-3 py-1.5 text-xs text-[#536a75] flex items-center justify-between shadow-[inset_0_1px_0_#fff]">
    <span class="font-bold text-[#164b70]">BOOKSHELF // {{ books.items.length }} BOOK{% if books.items.length != 1 %}S{% endif %} LOGGED</span>
    <span class="text-[11px] text-[#71828b]">GENRE: TECH &amp; LITERATURE</span>
  </div>

  {% for book in books.items %}
  <div class="site-card border border-[#9bb0be] bg-white p-0 shadow-[2px_2px_0_#cad6de]">
    {# 2005 Window Header #}
    <div class="border-b border-[#c6d7e0] bg-[#e4eef2] px-3 py-1.5 flex flex-wrap items-center justify-between gap-2 shadow-[inset_0_1px_0_#fff]">
      <div class="flex items-center gap-2">
        <span class="text-xs font-bold text-[#556b78]">#{{ loop.index }}</span>
        <h3 class="font-bold text-sm text-[#164b70] tracking-tight uppercase leading-none m-0">
          {% if book.link %}
          <a class="text-[#164b70] underline hover:text-[#c0392b]" href="{{ book.link }}" target="_blank" rel="noopener noreferrer">{{ book.title }}</a>
          {% else %}
          {{ book.title }}
          {% endif %}
        </h3>
        {% if book.author %}
        <span class="text-[11px] text-[#556b78] font-normal">by {{ book.author }}</span>
        {% endif %}
      </div>
      <div>
        {% if book.status == "currently-reading" %}
        <span class="inline-block bg-[#164b70] text-white text-[10px] font-bold px-1.5 py-0.5 shadow-[inset_0_1px_1px_rgba(0,0,0,0.3)]">[CURRENTLY READING]</span>
        {% elif book.status == "read" %}
        <span class="text-[11px] font-bold text-[#2e7d32]">[FINISHED / READ]</span>
        {% elif book.status == "to-read" %}
        <span class="text-[11px] font-bold text-[#556b78]">[PLAN TO READ]</span>
        {% endif %}
      </div>
    </div>

    {# Body #}
    <div class="p-3 bg-[#f8fbfc] flex flex-col sm:flex-row items-start gap-3.5">
      {# Left Cover Image Frame #}
      <div class="shrink-0 flex flex-col items-center mx-auto sm:mx-0">
        {% if book.image %}
        <div class="border border-[#7892a3] bg-white p-1 shadow-[2px_2px_0_#cad6de]">
          <img class="h-28 w-20 object-contain block" src="{{ book.image }}" alt="{{ book.title }}" />
        </div>
        {% else %}
        <div class="h-24 w-16 border border-[#7892a3] bg-[#dce9ef] flex items-center justify-center text-[10px] font-bold text-[#164b70] shadow-[2px_2px_0_#cad6de]">
          BOOK
        </div>
        {% endif %}
      </div>

      {# Right Details Definition Table #}
      <div class="min-w-0 flex-1 w-full text-xs">
        <table class="w-full text-xs text-[#26343d] border-collapse">
          <tbody>
            {% if book.author %}
            <tr class="border-b border-[#e1ebf0]">
              <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Author:</td>
              <td class="py-1 text-[#3b4d57]">{{ book.author }}</td>
            </tr>
            {% endif %}
            {% if book.status %}
            <tr class="border-b border-[#e1ebf0]">
              <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Reading Status:</td>
              <td class="py-1 text-[#3b4d57]">
                {% if book.status == "currently-reading" %}Currently Reading{% elif book.status == "read" %}Completed / Finished{% else %}Want to Read{% endif %}
              </td>
            </tr>
            {% endif %}
            {% if book.progress %}
            <tr class="border-b border-[#e1ebf0]">
              <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Current Page:</td>
              <td class="py-1 text-[#164b70] font-semibold">{{ book.progress }}</td>
            </tr>
            {% endif %}
            {% if book.rating %}
            <tr class="border-b border-[#e1ebf0]">
              <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Score / Rating:</td>
              <td class="py-1 text-[#c0392b] font-bold">{{ book.rating }}</td>
            </tr>
            {% endif %}
            {% if book.year %}
            <tr class="border-b border-[#e1ebf0]">
              <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Year:</td>
              <td class="py-1 text-[#556b78]">{{ book.year }}</td>
            </tr>
            {% endif %}
            {% if book.review %}
            <tr class="border-b border-[#e1ebf0]">
              <td class="py-1 font-bold text-[#164b70] w-24 shrink-0 align-top">Reader Notes:</td>
              <td class="py-1 text-[#26343d] leading-relaxed italic">"{{ book.review }}"</td>
            </tr>
            {% endif %}
          </tbody>
        </table>

        {% if book.link %}
        <div class="pt-2 flex justify-end">
          <a class="site-button-2007 inline-block px-3 py-1 text-xs" href="{{ book.link }}" target="_blank" rel="noopener noreferrer">
            Book Details / Page &raquo;
          </a>
        </div>
        {% endif %}
      </div>
    </div>
  </div>
  {% endfor %}
  {% else %}
  <div class="border border-[#b7cbd6] bg-[#f4f8fa] px-4 py-3 text-xs text-[#71828b]">
    No books added yet. Books added via the admin panel will appear here.
  </div>
  {% endif %}
</div>

<p class="mt-6"><a class="text-[#064f83] underline hover:text-[#c0392b]" href="/">← back to home</a></p>
