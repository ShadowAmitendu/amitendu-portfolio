---
layout: base.njk
permalink: /resume/
---
{% set r = resume %}
<div class="site-resume">
  {# Document Control Bar / Single Download Button #}
  <div class="site-resume-toolbar border border-[#b7cbd6] bg-[#f4f8fa] px-3.5 py-2 shadow-[inset_0_1px_0_#fff] flex flex-wrap items-center justify-between gap-3 mb-6 select-none">
    <div class="flex items-center gap-2">
      <span class="inline-block w-2 h-2 rounded-full bg-[#2e7d32] shadow-[0_0_4px_#2e7d32]"></span>
      <span class="text-xs font-bold text-[#164b70] uppercase tracking-wider">CURRICULUM VITAE</span>
      <span class="hidden sm:inline-block text-[#9bb0be]">·</span>
      <span class="hidden sm:inline-block text-[11px] font-semibold text-[#556b78]">ATS-Compliant Format</span>
    </div>
    <div>
      {% if r.pdfUrl and r.pdfUrl.trim() !== "" and r.pdfUrl !== "#" %}
        <a
          id="btn-download-cv"
          href="{{ r.pdfUrl }}"
          download="Amitendu_Bikash_Dhusiya_CV.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="site-button-2007 inline-flex items-center gap-2 px-3.5 py-1.5 text-xs font-bold text-white cursor-pointer shadow-[inset_0_1px_1px_rgba(255,255,255,0.35)]"
          style="background: linear-gradient(#236487 0%, #164b70 100%); color: #ffffff !important;"
          title="Download CV as PDF"
          aria-label="Download CV as PDF"
        >
          <svg class="w-3.5 h-3.5 shrink-0 text-white fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" x2="12" y1="15" y2="3" />
          </svg>
          <span>Download CV</span>
        </a>
      {% else %}
        <button
          type="button"
          id="btn-download-cv"
          onclick="window.print()"
          class="site-button-2007 inline-flex items-center gap-2 px-3.5 py-1.5 text-xs font-bold text-white cursor-pointer shadow-[inset_0_1px_1px_rgba(255,255,255,0.35)]"
          style="background: linear-gradient(#236487 0%, #164b70 100%); color: #ffffff !important;"
          title="Save or Print CV as PDF"
          aria-label="Save or Print CV as PDF"
        >
          <svg class="w-3.5 h-3.5 shrink-0 text-white fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" x2="12" y1="15" y2="3" />
          </svg>
          <span>Download CV</span>
        </button>
      {% endif %}
    </div>
  </div>

  {# ATS-Friendly Modern Resume Document (Clean Paper Sheet) #}
  <article class="site-resume-doc bg-white border border-[#c4d4de] shadow-[0_4px_24px_rgba(0,0,0,0.06),2px_2px_0_#cad6de] p-6 sm:p-10 max-w-4xl mx-auto text-[#1e293b] font-sans">
    
    {# 1. Header & Contact Information #}
    <header class="border-b-2 border-[#164b70] pb-4 mb-6 text-center">
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[#0f172a] uppercase leading-tight m-0">
        {{ r.heading }}
      </h1>
      {% if r.subheading %}
        <p class="mt-1 text-xs sm:text-sm font-bold text-[#164b70] tracking-wide uppercase">
          {{ r.subheading }}
        </p>
      {% endif %}

      {# Standard ATS Inline Contact Strip #}
      <div class="mt-3 flex flex-wrap items-center justify-center gap-x-2.5 gap-y-1 text-xs text-[#475569]">
        {% set hasPrev = false %}
        {% if site.email %}
          <a href="mailto:{{ site.email }}" class="text-[#0f172a] font-medium underline hover:text-[#c0392b]">{{ site.email }}</a>
          {% set hasPrev = true %}
        {% endif %}
        {% for item in r.contactDetails %}
          {% if hasPrev %}
            <span class="text-[#94a3b8] select-none">•</span>
          {% endif %}
          {% if item.url %}
            <a href="{{ item.url }}" target="_blank" rel="noopener noreferrer" class="text-[#0f172a] font-medium underline hover:text-[#c0392b]">{{ item.value }}</a>
          {% else %}
            <span class="font-medium text-[#334155]">{{ item.value }}</span>
          {% endif %}
          {% set hasPrev = true %}
        {% endfor %}
        {% if site.url %}
          {% if hasPrev %}
            <span class="text-[#94a3b8] select-none">•</span>
          {% endif %}
          <a href="{{ site.url }}" target="_blank" rel="noopener noreferrer" class="text-[#0f172a] font-medium underline hover:text-[#c0392b]">amitendu.me</a>
        {% endif %}
      </div>
    </header>

    {# 2. Professional Summary #}
    {% if r.intro %}
      <section class="mb-6">
        <h2 class="text-xs font-bold text-[#0f172a] uppercase tracking-wider border-b border-[#0f172a] pb-1 mb-2.5">
          Professional Summary
        </h2>
        <p class="text-xs leading-relaxed text-[#334155] text-justify sm:text-left">
          {{ r.intro }}
        </p>
      </section>
    {% endif %}

    {# 3. Technical Skills #}
    {% if r.skillsList and r.skillsList.length > 0 %}
      <section class="mb-6">
        <h2 class="text-xs font-bold text-[#0f172a] uppercase tracking-wider border-b border-[#0f172a] pb-1 mb-2.5">
          Technical Skills
        </h2>
        <div class="space-y-1.5 text-xs text-[#334155]">
          {% for cat in r.skillsList %}
            <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-2">
              <span class="font-bold text-[#0f172a] min-w-44 shrink-0 sm:after:content-[':']">{{ cat.category }}</span>
              <span class="text-[#334155]">{{ cat.items }}</span>
            </div>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {# 4. Experience & Practical Training #}
    {% if r.experience and r.experience.length > 0 %}
      <section class="mb-6">
        <h2 class="text-xs font-bold text-[#0f172a] uppercase tracking-wider border-b border-[#0f172a] pb-1 mb-3">
          Experience &amp; Practical Training
        </h2>
        <div class="space-y-4">
          {% for job in r.experience %}
            <div class="site-resume-item break-inside-avoid">
              <div class="flex flex-wrap items-baseline justify-between gap-x-2 gap-y-0.5">
                <h3 class="font-bold text-sm text-[#0f172a] m-0">{{ job.role }}</h3>
                {% if job.period %}
                  <span class="text-xs font-semibold text-[#164b70] shrink-0">{{ job.period }}</span>
                {% endif %}
              </div>
              {% if job.company %}
                <p class="text-xs font-medium text-[#475569] mt-0.5 italic">{{ job.company }}</p>
              {% endif %}
              {% if job.description %}
                <p class="text-xs leading-relaxed text-[#334155] mt-1.5">
                  {{ job.description }}
                </p>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {# 5. Education & Academics #}
    {% if r.education and r.education.length > 0 %}
      <section class="mb-6">
        <h2 class="text-xs font-bold text-[#0f172a] uppercase tracking-wider border-b border-[#0f172a] pb-1 mb-3">
          Education
        </h2>
        <div class="space-y-3.5">
          {% for edu in r.education %}
            <div class="site-resume-item break-inside-avoid">
              <div class="flex flex-wrap items-baseline justify-between gap-x-2 gap-y-0.5">
                <h3 class="font-bold text-sm text-[#0f172a] m-0">{{ edu.degree }}</h3>
                {% if edu.period %}
                  <span class="text-xs font-semibold text-[#164b70] shrink-0">{{ edu.period }}</span>
                {% endif %}
              </div>
              {% if edu.institution %}
                <p class="text-xs font-medium text-[#475569] mt-0.5 italic">{{ edu.institution }}</p>
              {% endif %}
              {% if edu.details %}
                <p class="text-xs text-[#64748b] mt-0.5">{{ edu.details }}</p>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {# 6. Certifications & Credentials #}
    {% if r.certifications and r.certifications.length > 0 %}
      <section class="mb-6">
        <h2 class="text-xs font-bold text-[#0f172a] uppercase tracking-wider border-b border-[#0f172a] pb-1 mb-3">
          Certifications &amp; Credentials
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {% for cert in r.certifications %}
            <div class="site-card border border-[#9bb0be] bg-white p-0 shadow-[2px_2px_0_#cad6de] break-inside-avoid">
              {# Card Header #}
              <div class="border-b border-[#c6d7e0] bg-[#e4eef2] px-3 py-1.5 flex items-center justify-between gap-2 shadow-[inset_0_1px_0_#fff]">
                <span class="font-bold text-xs text-[#164b70] uppercase tracking-tight leading-tight truncate">{{ cert.name }}</span>
                {% if cert.date %}
                  <span class="text-[10px] text-[#556b78] font-semibold shrink-0">{{ cert.date }}</span>
                {% endif %}
              </div>

              {# Card Body #}
              <div class="p-3 bg-[#f8fbfc] flex gap-3">
                {# Badge Image #}
                {% if cert.badge %}
                  <div class="shrink-0 w-20 h-20 border border-[#b7cbd6] bg-white shadow-[inset_0_0_0_1px_#e2e8f0] flex items-center justify-center overflow-hidden">
                    <img src="{{ cert.badge }}" alt="{{ cert.badgeAlt or cert.name }}" class="w-full h-full object-contain" loading="lazy" />
                  </div>
                {% endif %}

                {# Details #}
                <div class="min-w-0 flex-1 text-xs space-y-1">
                  {% if cert.issuer %}
                    <div>
                      <span class="font-bold text-[#164b70]">Issuer:</span>
                      <span class="text-[#3b4d57]">{{ cert.issuer }}</span>
                    </div>
                  {% endif %}
                  {% if cert.credentialId %}
                    <div>
                      <span class="font-bold text-[#164b70]">ID:</span>
                      <span class="text-[#556b78] font-mono text-[11px]">{{ cert.credentialId }}</span>
                    </div>
                  {% endif %}
                  {% if cert.skills %}
                    <div>
                      <span class="font-bold text-[#164b70]">Skills:</span>
                      <span class="text-[#3b4d57]">{{ cert.skills }}</span>
                    </div>
                  {% endif %}
                  {% if cert.credentialUrl and cert.credentialUrl != '#' %}
                    <div class="pt-1">
                      <a href="{{ cert.credentialUrl }}" target="_blank" rel="noopener noreferrer" class="site-button-2007 inline-block px-2.5 py-0.5 text-[11px]">
                        Verify &raquo;
                      </a>
                    </div>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {# 7. Additional Notes #}
    {% if r.additionalNotes %}
      <section class="mt-6 pt-3 border-t border-[#e2e8f0] text-xs text-[#64748b]">
        <span class="font-semibold text-[#0f172a]">Availability &amp; Notes:</span> {{ r.additionalNotes }}
      </section>
    {% endif %}

  </article>

  {# Back link #}
  <p class="site-resume-back-link mt-6 border-t border-[#b7cbd6] pt-4 text-xs">
    <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/">← back to home</a>
  </p>
</div>



<style>
.site-resume-doc,
.site-resume-doc h1,
.site-resume-doc h2,
.site-resume-doc h3,
.site-resume-doc h4,
.site-resume-doc h5,
.site-resume-doc h6,
.site-resume-doc p,
.site-resume-doc span,
.site-resume-doc a,
.site-resume-doc div,
.site-resume-doc li {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important;
}

.site-resume-doc {
  letter-spacing: -0.011em;
  font-feature-settings: "cv02", "cv03", "cv04", "cv11";
}

@media print {
  @page {
    margin: 12mm 15mm;
    size: A4 portrait;
  }
  .site-header,
  .site-nav,
  .site-sidebar,
  .site-sidebar-left,
  .site-sidebar-right,
  .site-footer,
  .site-announcement-banner,
  .site-resume-toolbar,
  .site-resume-back-link,
  #cookieConsentBanner,
  .site-lightbox {
    display: none !important;
  }
  body,
  .site-shell,
  .site-columns,
  .site-content,
  .site-resume {
    background: #ffffff !important;
    color: #000000 !important;
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
    box-shadow: none !important;
    max-width: 100% !important;
    width: 100% !important;
  }
  .site-resume-doc {
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    margin: 0 !important;
    max-width: 100% !important;
    width: 100% !important;
  }
  .break-inside-avoid {
    page-break-inside: avoid !important;
    break-inside: avoid !important;
  }
}
</style>
