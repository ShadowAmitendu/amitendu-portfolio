---
layout: base.njk
title: About Me
headerTagline: ABOUT MYSELF
permalink: /about/
aboutTab: me
---
{% include "about-tabs.njk" %}

<h2 class="border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">
  {{ about.heading or heading or 'About me' }}</h2>
<div class="site-entry-body mt-4 text-sm leading-relaxed text-[#26343d]">
  {% if about.profileImage %}
  <div class="float-right ml-4 mb-3 shrink-0">
    <div class="border border-[#7892a3] bg-white p-1 shadow-[2px_2px_0_#cad6de]">
      <img class="h-32 w-32 sm:h-40 sm:w-40 object-cover block"
        src="{{ about.profileImage }}" alt="{{ about.profileAlt or 'Profile photo' }}" />
    </div>
  </div>
  {% endif %}
  {% if about.intro or intro %}
  <p class="text-sm text-[#536a75] mb-3">{{ about.intro or intro }}</p>
  {% endif %}
  {% if about.content or about.body %}
    {{ (about.content or about.body) | markdown | safe }}
  {% elif about.paragraphs %}
    {% for paragraph in about.paragraphs %}<p class="mt-3">{{ paragraph }}</p>{% endfor %}
  {% endif %}
</div>

<p class="mt-6"><a class="text-[#064f83] underline hover:text-[#c0392b]" href="/">← back to home</a></p>
