---
layout: base.njk
title: Home
---
{% set h = home %}
<div class="site-intro mb-6 border border-[#b7cbd6] bg-[#f4f8fa] p-4">
  <p class="text-xl font-bold text-[#164b70]">
    {{ h.greeting or greeting }}
  </p>
  <p class="mt-1 text-sm text-[#3b4d57]">
    {{ h.welcome or welcome }}
  </p>
</div>

<h2 id="about"
  class="mt-6 border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">
  {{ h.aboutTitle or aboutTitle }}</h2>
<div class="mt-3 flex items-start gap-4">
  <p class="flex-1">{{ h.about or about }}</p>
  {% if h.profileImage or profileImage %}
  <img class="site-profile-frame h-24 w-24 shrink-0 object-cover" src="{{ h.profileImage or profileImage }}"
    alt="{{ h.profileAlt or profileAlt }}" />
  {% endif %}
</div>

<h2 class="mt-6 border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">
  {{ h.currentlyTitle or currentlyTitle }}</h2>
<ul class="mt-3 list-inside list-disc">
  {% for item in (h.currently or currently) %}<li>{{ item }}</li>{% endfor %}
</ul>

<h2 class="mt-6 border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">
  {{ h.statusTitle or statusTitle }}</h2>
<div class="mt-3 border border-[#b7cbd6] bg-[#f4f8fa] px-4 py-3">
  {% for item in (h.status or status) %}<p><span class="font-bold text-[#164b70]">{{ item.label }}:</span>
    {{ item.value }}</p>{% endfor %}
</div>

{# Currently Reading Spotlight #}
{% set homeBook = null %}
{% for b in shelf.books %}
  {% if b.status == "currently-reading" and not homeBook %}
    {% set homeBook = b %}
  {% endif %}
{% endfor %}
{% if not homeBook and shelf.books and shelf.books.length > 0 %}
  {% set homeBook = shelf.books[0] %}
{% endif %}
{% if homeBook %}
<h2 class="mt-6 border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">
  Currently Reading
</h2>
<div class="mt-3 border border-[#b7cbd6] bg-[#f4f8fa] p-4">
  <div class="flex flex-col sm:flex-row items-start gap-4">
    {% if homeBook.image %}
    <img class="site-profile-frame h-28 w-20 shrink-0 object-cover shadow-sm" src="{{ homeBook.image }}" alt="{{ homeBook.title }}" />
    {% else %}
    <div class="h-28 w-20 shrink-0 border border-[#b7cbd6] bg-[#dce9ef] shadow-[inset_1px_1px_0_#fff] flex flex-col justify-between p-2 text-center">
      <span class="text-[10px] font-bold text-[#164b70] tracking-wider uppercase">Book</span>
      <span class="text-[11px] font-bold leading-tight text-[#26343d] line-clamp-3">{{ homeBook.title }}</span>
      <span class="text-[9px] text-[#556b78]">Cover n/a</span>
    </div>
    {% endif %}
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2">
        <span class="inline-block bg-[#2e7d32] text-white text-[10px] font-bold px-1.5 py-0.5 tracking-wider">
          CURRENTLY READING
        </span>
        {% if homeBook.rating %}
        <span class="text-xs font-bold text-[#c0392b]">★ {{ homeBook.rating }}</span>
        {% endif %}
      </div>
      <h3 class="font-bold text-[#164b70] text-base mt-1.5">
        {% if homeBook.link %}
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="{{ homeBook.link }}" target="_blank" rel="noopener noreferrer">{{ homeBook.title }}</a>
        {% else %}
        {{ homeBook.title }}
        {% endif %}
      </h3>
      <p class="text-xs text-[#556b78] font-medium mt-0.5">by {{ homeBook.author }}</p>
      {% if homeBook.progress %}
      <p class="mt-2 text-xs font-semibold text-[#164b70] bg-[#e2ecf2] inline-block px-2 py-0.5 border border-[#b7cbd6]">
        Current Progress: {{ homeBook.progress }}
      </p>
      {% endif %}
      {% if homeBook.review %}
      <p class="mt-2 text-sm leading-relaxed text-[#26343d] italic border-l-2 border-[#b7cbd6] pl-2.5">
        "{{ homeBook.review }}"
      </p>
      {% endif %}
      <div class="mt-3 flex items-center gap-3 text-xs">
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/shelf/">View full bookshelf &raquo;</a>
        {% if homeBook.link %}
        <span class="text-[#71828b]">·</span>
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="{{ homeBook.link }}" target="_blank" rel="noopener noreferrer">About this book &raquo;</a>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{% endif %}

<h2 class="mt-6 border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">
  Quick links</h2>
<div class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
  {% for link in (h.links or links) %}
  {% set linkIcon = link.url | resolveIcon(link.label, link.icon) %}
  <a class="flex items-center gap-1.5 text-[#064f83] underline hover:text-[#c0392b]"
    href="{{ link.url }}" {% if link.url and link.url.startsWith('http') %}target="_blank" rel="noopener noreferrer"{% endif %}>
    <img class="site-macos-icon h-4 w-4 shrink-0 rounded-[3.5px] shadow-[0_1px_2px_rgba(0,0,0,0.25)]"
      src="/assets/icons/macos-{{ linkIcon }}.png" alt="" width="16" height="16" />
    <span>{{ link.label }}</span>
  </a>
  {% endfor %}
</div>

<h2 class="mt-6 border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">
  Featured portfolio</h2>
<div class="mt-3 space-y-3">
  {% if collections.portfolio and collections.portfolio.length > 0 %}
  {% for project in collections.portfolio %}
  {% if loop.index <= site.featuredLimit %}
  <article class="site-card border border-[#b7cbd6] bg-[#f4f8fa] p-0">
    <a class="site-card-link block p-3 text-inherit no-underline" href="{{ project.url }}">
      <div class="site-card-row flex items-center justify-between gap-4">
        <div class="min-w-0">
          <h3 class="font-bold text-[#164b70]">{{ project.data.title }}</h3>
          <p class="mt-1">{{ project.data.description }}</p>
        </div>
        {% if project.data.image %}<img class="site-card-image h-20 w-24 max-w-full shrink-0 object-cover"
          src="{{ project.data.image }}" alt="{{ project.data.title }}" />{% endif %}
      </div>
    </a>
  </article>
  {% endif %}
  {% endfor %}
  {% else %}
  <div class="border border-[#b7cbd6] bg-[#f4f8fa] px-4 py-3 text-xs text-[#71828b]">
    <p class="font-bold text-[#164b70]">No Portfolio</p>
    <p class="mt-1">No portfolio projects published yet.</p>
  </div>
  {% endif %}
</div>

<h2 class="mt-6 border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">
  Featured blog posts</h2>
<div class="mt-3 space-y-3">
  {% if collections.blog and collections.blog.length > 0 %}
  {% for post in collections.blog %}
  {% if loop.index <= site.featuredLimit %}
  <article class="site-card border border-[#b7cbd6] bg-[#f4f8fa] p-0">
    <a class="site-card-link block p-3 text-inherit no-underline" href="{{ post.url }}">
      <div class="site-card-row flex items-center justify-between gap-4">
        <div class="min-w-0">
          <h3 class="font-bold text-[#164b70]">{{ post.data.title }}</h3>
          <p class="mt-1">{{ post.data.description }}</p>
          {% if post.data.author %}<p class="mt-2 text-xs text-[#71828b]">by {{ post.data.author }}</p>{% endif %}
        </div>
        {% if post.data.image %}<img class="site-card-image h-20 w-24 max-w-full shrink-0 object-cover"
          src="{{ post.data.image }}" alt="{{ post.data.title }}" />{% endif %}
      </div>
    </a>
  </article>
  {% endif %}
  {% endfor %}
  {% else %}
  <div class="border border-[#b7cbd6] bg-[#f4f8fa] px-4 py-3 text-xs text-[#71828b]">
    <p class="font-bold text-[#164b70]">No Blogs</p>
    <p class="mt-1">No blog posts published yet.</p>
  </div>
  {% endif %}
</div>

<div class="mt-6 flex items-baseline justify-between border-b border-[#b7cbd6] pb-1">
  <h2 class="text-lg font-bold text-[#164b70]">
    Books & Movies
  </h2>
  <a class="text-xs text-[#064f83] underline hover:text-[#c0392b]" href="/shelf/">View all &raquo;</a>
</div>
<div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-3">
  {# Recent Book #}
  {% if shelf.books and shelf.books.length > 0 %}
  {% set previewBook = shelf.books[0] %}
  <article class="site-card border border-[#b7cbd6] bg-[#f4f8fa] p-3 flex gap-3 items-start">
    {% if previewBook.image %}
    <img class="site-profile-frame h-20 w-14 shrink-0 object-cover" src="{{ previewBook.image }}" alt="{{ previewBook.title }}" />
    {% else %}
    <div class="h-20 w-14 shrink-0 border border-[#b7cbd6] bg-[#dce9ef] flex items-center justify-center text-[10px] font-bold text-[#164b70]">
      BOOK
    </div>
    {% endif %}
    <div class="min-w-0 flex-1">
      <span class="inline-block bg-[#164b70] text-white text-[9px] font-bold px-1.5 py-0.2 tracking-wider">BOOKSHELF</span>
      <h3 class="font-bold text-[#164b70] text-sm mt-1 leading-snug line-clamp-2">
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/shelf/">{{ previewBook.title }}</a>
      </h3>
      <p class="text-xs text-[#556b78] mt-0.5">by {{ previewBook.author }}</p>
      {% if previewBook.progress %}<p class="text-[11px] text-[#164b70] font-semibold mt-1">{{ previewBook.progress }}</p>{% endif %}
    </div>
  </article>
  {% endif %}

  {# Recent Movie #}
  {% if shelf.movies and shelf.movies.length > 0 %}
  {% set previewMovie = shelf.movies[0] %}
  <article class="site-card border border-[#b7cbd6] bg-[#f4f8fa] p-3 flex gap-3 items-start">
    {% if previewMovie.image %}
    <img class="site-profile-frame h-20 w-14 shrink-0 object-cover" src="{{ previewMovie.image }}" alt="{{ previewMovie.title }}" />
    {% else %}
    <div class="h-20 w-14 shrink-0 border border-[#b7cbd6] bg-[#dce9ef] flex items-center justify-center text-[10px] font-bold text-[#164b70]">
      CINEMA
    </div>
    {% endif %}
    <div class="min-w-0 flex-1">
      <span class="inline-block bg-[#00695c] text-white text-[9px] font-bold px-1.5 py-0.2 tracking-wider">CINEMA & SHOWS</span>
      <h3 class="font-bold text-[#164b70] text-sm mt-1 leading-snug line-clamp-2">
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/shelf/">{{ previewMovie.title }}</a>
      </h3>
      {% if previewMovie.director %}<p class="text-xs text-[#556b78] mt-0.5">{{ previewMovie.director }}</p>{% endif %}
      {% if previewMovie.rating %}<p class="text-[11px] text-[#c0392b] font-bold mt-1">★ {{ previewMovie.rating }}</p>{% endif %}
    </div>
  </article>
  {% endif %}
</div>

<div class="mt-6 flex items-baseline justify-between border-b border-[#b7cbd6] pb-1">
  <h2 class="text-lg font-bold text-[#164b70]">
    Games & Apps
  </h2>
  <a class="text-xs text-[#064f83] underline hover:text-[#c0392b]" href="/apps/">View all &raquo;</a>
</div>
<div class="mt-3 border border-[#b7cbd6] bg-[#f4f8fa] p-4">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {# Games subsection #}
    <div>
      <p class="text-xs font-bold text-[#164b70] uppercase tracking-wider mb-2">Gaming Rotation</p>
      <div class="space-y-2">
        {% for g in apps.games.slice(0, 3) %}
        <div class="flex items-center gap-2.5 bg-white border border-[#b7cbd6] p-1.5">
          {% if g.icon %}
          <img class="h-8 w-8 shrink-0 object-contain border border-[#7892a3] p-0.5" src="{{ g.icon }}" alt="{{ g.name }}" width="32" height="32" />
          {% else %}
          <div class="h-8 w-8 shrink-0 border border-[#b7cbd6] bg-[#dce9ef] flex items-center justify-center text-[9px] font-bold text-[#164b70]">GAME</div>
          {% endif %}
          <div class="min-w-0 flex-1">
            <p class="font-bold text-xs text-[#164b70] truncate leading-tight">
              {% if g.link %}
              <a class="text-[#064f83] underline hover:text-[#c0392b]" href="{{ g.link }}" target="_blank" rel="noopener noreferrer">{{ g.name }}</a>
              {% else %}
              {{ g.name }}
              {% endif %}
            </p>
            <p class="text-[10px] text-[#556b78] truncate">{% if g.status %}<span class="text-[#2e7d32] font-semibold">[{{ g.status }}]</span> {% endif %}{{ g.platform }}</p>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>

    {# Apps subsection #}
    <div>
      <p class="text-xs font-bold text-[#164b70] uppercase tracking-wider mb-2">Daily Tools & Workflow</p>
      <div class="flex flex-wrap gap-2">
        {% for a in apps.apps %}
        {% if a.icon %}
        <a class="flex items-center gap-1.5 bg-white border border-[#b7cbd6] px-2 py-1 text-xs text-[#064f83] hover:border-[#c0392b] shadow-sm" href="{{ a.link or '/apps/' }}" title="{{ a.name }} ({{ a.category }})" {% if a.link and a.link.startsWith('http') %}target="_blank" rel="noopener noreferrer"{% endif %}>
          <img class="h-4 w-4 shrink-0 object-contain" src="{{ a.icon }}" alt="{{ a.name }}" width="16" height="16" />
          <span class="underline font-medium">{{ a.name }}</span>
        </a>
        {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<h2 class="mt-6 border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">
  Skills</h2>
<p class="mt-3">{{ (h.skills or skills) | join(" · ") }}</p>

<h2 class="mt-6 border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">
  GitHub Contributions</h2>
<div class="mt-3 w-full max-w-full overflow-x-auto border border-[#b7cbd6] bg-[#f4f8fa] p-3">
  <div class="mb-2 flex items-center justify-between text-xs text-[#556b78]">
    <span class="font-bold text-[#164b70]">@ShadowAmitendu on GitHub</span>
    <a class="text-[#064f83] underline hover:text-[#c0392b]" href="https://github.com/ShadowAmitendu" target="_blank" rel="noopener noreferrer">View Profile</a>
  </div>
  <a class="block min-w-0" href="https://github.com/ShadowAmitendu" target="_blank" rel="noopener noreferrer">
    <img class="block max-w-none" style="min-width: 640px; width: 640px;" src="https://ghchart.rshah.org/ShadowAmitendu" alt="ShadowAmitendu's GitHub Contributions Calendar" loading="lazy" />
  </a>
</div>

<h2 class="mt-6 border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">
  Recent updates</h2>
{% if (collections.blog and collections.blog.length > 0) or (collections.portfolio and collections.portfolio.length > 0) %}
<ul class="mt-3 space-y-1 text-xs">
  {% for post in collections.blog %}
  {% if loop.index <= 2 %}<li><span class="text-[#71828b]">{{ post.data.date | shortDate }}</span> — New blog post: <a
      class="text-[#064f83] underline hover:text-[#c0392b]" href="{{ post.url }}">{{ post.data.title }}</a></li>
  {% endif %}
  {% endfor %}
  {% for project in collections.portfolio %}
  {% if loop.index <= 2 %}<li><span class="text-[#71828b]">{{ project.data.date | shortDate }}</span> — Added project:
    <a class="text-[#064f83] underline hover:text-[#c0392b]" href="{{ project.url }}">{{ project.data.title }}</a></li>
  {% endif %}
  {% endfor %}
</ul>
{% else %}
<div class="mt-3 border border-[#b7cbd6] bg-[#f4f8fa] px-4 py-3 text-xs text-[#71828b]">
  No recent updates.
</div>
{% endif %}
