---
layout: base.njk
title: Home
---
{% set h = home %}
<div class="site-intro mb-6 border border-[#b7cbd6] bg-[#f4f8fa] p-4 flex items-center justify-between gap-4">
  <div class="min-w-0">
    <p class="text-xl font-bold text-[#164b70]">
      {{ h.greeting or greeting }}
    </p>
    <p class="mt-1 text-sm text-[#3b4d57]">
      {{ h.welcome or welcome }}
    </p>
  </div>
  {% set introGif = h.greetingGif or greetingGif or '/images/hi.gif' %}
  {% if introGif %}
  <img class="h-16 w-16 sm:h-20 sm:w-20 shrink-0 object-contain" src="{{ introGif }}" alt="Waving stickman" width="80"
    height="80" />
  {% endif %}
</div>

<h2 id="about" class="mt-6 border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">
  {{ h.aboutTitle or aboutTitle }}</h2>
<div class="mt-3 flex items-start gap-4">
  <p class="flex-1">{{ h.about or about }}</p>
  {% if h.profileImage or profileImage %}
  <img class="site-profile-frame h-24 w-24 shrink-0 object-cover" src="{{ h.profileImage or profileImage }}"
    alt="{{ h.profileAlt or profileAlt }}" />
  {% endif %}
</div>

<h2 class="mt-6 border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">
  {{ h.currentlyTitle or currentlyTitle }}</h2>
<ul class="mt-3 list-inside list-disc">
  {% for item in (h.currently or currently) %}<li>{{ item }}</li>{% endfor %}
</ul>

<h2 class="mt-6 border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">
  {{ h.statusTitle or statusTitle }}</h2>
<div class="mt-3 border border-[#b7cbd6] bg-[#f4f8fa] px-4 py-3">
  {% for item in (h.status or status) %}<p><span class="font-bold text-[#164b70]">{{ item.label }}:</span>
    {{ item.value }}</p>{% endfor %}
</div>

<h2 class="mt-6 border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">
  Quick links</h2>
<div class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
  {% for link in (h.links or links) %}
  {% set linkIcon = link.url | resolveIcon(link.label, link.icon) %}
  <a class="flex items-center gap-1.5 text-[#064f83] underline hover:text-[#c0392b]" href="{{ link.url }}"
    {% if link.url and link.url.startsWith('http') %}target="_blank" rel="noopener noreferrer" {% endif %}>
    <img class="site-macos-icon h-4 w-4 shrink-0 rounded-[3.5px] shadow-[0_1px_2px_rgba(0,0,0,0.25)]"
      src="/assets/icons/macos-{{ linkIcon }}.png" alt="" width="16" height="16" />
    <span>{{ link.label }}</span>
  </a>
  {% endfor %}
</div>

<h2 class="mt-6 border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">
  Featured portfolio</h2>
<div class="mt-3 space-y-3">
  {% set featuredProjects = [] %}
  {% for project in (collections.portfolio or []) %}
  {% if project.data.featured and featuredProjects.length < site.featuredLimit %}
  {% set featuredProjects = (featuredProjects.push(project), featuredProjects) %}
  {% endif %}
  {% endfor %}
  {% if featuredProjects and featuredProjects.length > 0 %}
  {% for project in featuredProjects %}
  <article class="site-card border border-[#b7cbd6] bg-[#f4f8fa] p-0">
    <a class="site-card-link block p-3 text-inherit no-underline" href="{{ project.url }}">
      <div class="site-card-row flex items-center justify-between gap-4">
        <div class="min-w-0">
          <h3 class="font-bold text-[#164b70]">{{ project.data.title }}</h3>
          <p class="mt-1">{{ project.data.description }}</p>
        </div>
        {% if project.data.image %}<img class="site-card-image h-20 w-24 max-w-full shrink-0 object-cover"
          src="{{ project.data.image }}" alt="{{ project.data.imageAlt or project.data.title }}" />{% endif %}
      </div>
    </a>
  </article>
  {% endfor %}
  {% else %}
  <div class="border border-[#b7cbd6] bg-[#f4f8fa] px-4 py-3 text-xs text-[#71828b]">
    <p class="font-bold text-[#164b70]">No Featured Projects</p>
    <p class="mt-1">No featured portfolio projects published yet.</p>
  </div>
  {% endif %}
</div>

<h2 class="mt-6 border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">
  Featured blog posts</h2>
<div class="mt-3 space-y-3">
  {% if collections.blog and collections.blog.length > 0 %}
  {% for post in collections.blog %}
  {% if loop.index <= site.featuredLimit %}
  <article class="site-card border border-[#b7cbd6] bg-[#f4f8fa] p-0">
    <a class="site-card-link block p-3 text-inherit no-underline" href="{{ post.url }}">
      <div class="site-card-row flex items-center justify-between gap-4">
        <div class="min-w-0">
          <h3 class="font-bold text-[#164b70]">{{ post.data.title }}</h3>
          <p class="mt-1">{{ post.data.description }}</p>
          {% if post.data.author %}<p class="mt-2 text-xs text-[#71828b]">by {{ post.data.author }}</p>{% endif %}
        </div>
        {% if post.data.image %}<img class="site-card-image h-20 w-24 max-w-full shrink-0 object-cover"
          src="{{ post.data.image }}" alt="{{ post.data.imageAlt or post.data.title }}" />{% endif %}
      </div>
    </a>
  </article>
  {% endif %}
  {% endfor %}
  {% else %}
  <div class="border border-[#b7cbd6] bg-[#f4f8fa] px-4 py-3 text-xs text-[#71828b]">
    <p class="font-bold text-[#164b70]">No Blogs</p>
    <p class="mt-1">No blog posts published yet.</p>
  </div>
  {% endif %}
</div>

{# Side-by-Side: Ongoing Games & Currently Reading Book #}
{% set ongoingGame = null %}
{% for g in (games.items or []) %}
{% if not ongoingGame and g.playingRightNow %}
{% set ongoingGame = g %}
{% endif %}
{% endfor %}
{% if not ongoingGame and (games.items and games.items.length > 0) %}
{% set ongoingGame = games.items[0] %}
{% endif %}

{% set ongoingBook = null %}
{% for b in (books.items or []) %}
{% if not ongoingBook and (b.status == "currently-reading" or b.status == "reading" or b.status == "Currently Reading") %}
{% set ongoingBook = b %}
{% endif %}
{% endfor %}

<div class="mt-6 flex items-baseline justify-between border-b border-[#b7cbd6] pb-1">
  <h2 class="text-lg font-bold text-[#164b70]">
    Currently Enjoying
  </h2>
  <div class="text-xs space-x-2">
    <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/about/games/">games &raquo;</a>
    <span class="text-[#8aa2af]">|</span>
    <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/about/books/">books &raquo;</a>
  </div>
</div>

<div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-3">
  {# Side 1: Games I play #}
  <article class="site-card border border-[#b7cbd6] bg-[#f4f8fa] p-0 flex flex-col overflow-hidden">
    <div
      class="border-b border-[#c6d7e0] bg-[#e4eef2] px-2.5 py-1 font-bold text-[#164b70] text-xs flex justify-between items-center shadow-[inset_0_1px_0_#fff]">
      <span>Games I play</span>
      {% if ongoingGame %}<span class="text-[10px] text-[#556b78] font-normal">Ongoing</span>{% endif %}
    </div>

    {% if ongoingGame %}
    {% set gameImg = ongoingGame.image or ongoingGame.icon %}
    <div class="p-2.5 text-center flex flex-col items-center flex-1">
      <a class="my-1 block hover:opacity-90" href="/about/games/" title="{{ ongoingGame.name }} - view on games page">
        {% if gameImg %}
        <img
          class="h-20 w-20 sm:h-24 sm:w-24 object-contain border border-[#7892a3] bg-white p-1 shadow-[0_1px_2px_rgba(0,0,0,0.12)]"
          src="{{ gameImg }}" alt="{{ ongoingGame.name }}" />
        {% else %}
        <div
          class="h-16 w-16 border border-[#7892a3] bg-[#dce9ef] flex flex-col items-center justify-center text-[#164b70]">
          <span class="text-[10px] font-bold">GAME</span>
        </div>
        {% endif %}
      </a>
      <h3 class="font-bold text-[#164b70] text-sm mt-1 leading-tight tracking-tight uppercase">
        <a class="text-[#164b70] underline hover:text-[#c0392b]" href="/about/games/">{{ ongoingGame.name }}</a>
      </h3>
      <p class="text-[11px] text-[#556b78] mt-0.5">
        {{ ongoingGame.platform or ongoingGame.publisher or "PC" }}
      </p>
    </div>
    {% else %}
    <div class="p-4 text-center text-xs text-[#71828b] flex flex-col items-center justify-center flex-1 min-h-27.5">
      <p class="font-bold text-[#556b78]">Nothing to show</p>
      <p class="text-[11px] text-[#8aa2af] mt-0.5">No ongoing game added yet.</p>
    </div>
    {% endif %}
  </article>

  {# Side 2: Book I am reading #}
  <article class="site-card border border-[#b7cbd6] bg-[#f4f8fa] p-0 flex flex-col overflow-hidden">
    <div
      class="border-b border-[#c6d7e0] bg-[#e4eef2] px-2.5 py-1 font-bold text-[#164b70] text-xs flex justify-between items-center shadow-[inset_0_1px_0_#fff]">
      <span>Book I am reading</span>
      {% if ongoingBook %}<span class="text-[10px] text-[#556b78] font-normal">Reading</span>{% endif %}
    </div>

    {% if ongoingBook %}
    <div class="p-2.5 text-center flex flex-col items-center flex-1">
      <a class="my-1 block hover:opacity-90" href="/about/books/" title="{{ ongoingBook.title }} - view on bookshelf">
        {% if ongoingBook.image %}
        <img
          class="h-24 w-16 sm:h-28 sm:w-20 object-contain border border-[#7892a3] bg-white p-0.5 shadow-[0_1px_2px_rgba(0,0,0,0.12)]"
          src="{{ ongoingBook.image }}" alt="{{ ongoingBook.title }}" />
        {% else %}
        <div
          class="h-20 w-14 border border-[#7892a3] bg-[#dce9ef] flex flex-col items-center justify-center text-[#164b70]">
          <span class="text-[10px] font-bold">BOOK</span>
        </div>
        {% endif %}
      </a>
      <h3 class="font-bold text-[#164b70] text-sm mt-1 leading-tight tracking-tight uppercase">
        <a class="text-[#164b70] underline hover:text-[#c0392b]" href="/about/books/">{{ ongoingBook.title }}</a>
      </h3>
      {% if ongoingBook.author %}
      <p class="text-[11px] text-[#556b78] mt-0.5">
        by {{ ongoingBook.author }}
      </p>
      {% endif %}
    </div>
    {% else %}
    <div class="p-4 text-center text-xs text-[#71828b] flex flex-col items-center justify-center flex-1 min-h-27.5">
      <p class="font-bold text-[#556b78]">Nothing to show</p>
      <p class="text-[11px] text-[#8aa2af] mt-0.5">No book being read right now.</p>
    </div>
    {% endif %}
  </article>
</div>

{# Movies & Shows Preview (if any added) #}
{% set homeMovies = movies.movies or movies.items or movies.shows or shelf.movies %}
{% if homeMovies and homeMovies.length > 0 %}
<div class="mt-6 flex items-baseline justify-between border-b border-[#b7cbd6] pb-1">
  <h2 class="text-lg font-bold text-[#164b70]">
    Movies &amp; Shows
  </h2>
  <a class="text-xs text-[#064f83] underline hover:text-[#c0392b]" href="/about/movies/">View all &raquo;</a>
</div>
<div class="mt-3 space-y-3">
  {% set previewMovie = homeMovies[0] %}
  <article class="site-card border border-[#b7cbd6] bg-[#f4f8fa] p-3">
    <div class="flex items-start gap-3">
      {% if previewMovie.image %}
      <img class="h-20 w-14 shrink-0 object-cover border border-[#7892a3]" src="{{ previewMovie.image }}"
        alt="{{ previewMovie.title }}" />
      {% else %}
      <div
        class="h-20 w-14 shrink-0 border border-[#7892a3] bg-[#dce9ef] flex items-center justify-center text-[10px] font-bold text-[#164b70]">
        CINEMA
      </div>
      {% endif %}
      <div class="min-w-0 flex-1">
        <p class="text-xs text-[#71828b]">Movie / Show: {% if previewMovie.status == 'currently-watching' %}Currently
          Watching{% elif previewMovie.status == 'watched' %}Watched{% else %}Plan to Watch{% endif %}</p>
        <h3 class="font-bold text-[#164b70] text-sm mt-0.5">
          <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/about/movies/">{{ previewMovie.title }}</a>
        </h3>
        {% if previewMovie.director %}<p class="text-xs text-[#556b78] mt-0.5">Directed by {{ previewMovie.director }}
        </p>
        {% elif previewMovie.creator %}<p class="text-xs text-[#556b78] mt-0.5">Created by {{ previewMovie.creator }}
        </p>{% endif %}
        {% if previewMovie.rating %}<p class="text-xs text-[#c0392b] font-bold mt-1">Rating: {{ previewMovie.rating }}
        </p>{% endif %}
      </div>
    </div>
  </article>
</div>
{% endif %}

{% set homeSoftware = software.items %}
{% if homeSoftware and homeSoftware.length > 0 %}
<div class="mt-6 flex items-baseline justify-between border-b border-[#b7cbd6] pb-1">
  <h2 class="text-lg font-bold text-[#164b70]">
    Software &amp; Tools
  </h2>
  <a class="text-xs text-[#064f83] underline hover:text-[#c0392b]" href="/about/software/">View all &raquo;</a>
</div>
<div class="mt-3 site-software-grid">
  {% for item in homeSoftware.slice(0, 8) %}
  <div class="flex items-center gap-2.5 min-w-0">
    {% if item.icon %}
    <img src="{{ item.icon }}" alt="" class="w-5 h-5 object-contain shrink-0" loading="lazy" />
    {% else %}
    <span class="w-5 h-5 flex items-center justify-center shrink-0 text-[#556b78]" aria-hidden="true">
      <svg class="w-4 h-4 fill-current" viewBox="0 0 16 16"><path d="M2 3a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3zm1 1v2h10V4H3zm10 3H3v6h10V7z"/></svg>
    </span>
    {% endif %}
    {% if item.link %}
    <a class="text-[#064f83] underline hover:text-[#c0392b] text-[14px] leading-snug truncate" href="{{ item.link }}"
      {% if item.link.startsWith('http') %}target="_blank" rel="noopener noreferrer"{% endif %} title="{{ item.name }}">{{ item.name }}</a>
    {% else %}
    <span class="text-[#064f83] underline text-[14px] leading-snug truncate" title="{{ item.name }}">{{ item.name }}</span>
    {% endif %}
  </div>
  {% endfor %}
</div>
{% endif %}



<h2 class="mt-6 border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">
  Skills</h2>
<div class="mt-3 flex flex-wrap gap-2">
  {% for skill in (h.skills or skills) %}
  {% set sIcon = skill | skillIcon %}
  <span class="site-badge inline-flex items-center gap-1.5 border border-[#7892a3] bg-white px-2.5 py-1 text-xs font-semibold text-[#164b70] shadow-[1px_1px_0_#cad6de] hover:border-[#164b70] hover:bg-[#f4f8fa] transition-colors">
    {% if sIcon %}
    <img class="h-4 w-4 shrink-0 object-contain" src="/assets/icons/skills/{{ sIcon }}" alt="" width="16" height="16" loading="lazy" />
    {% endif %}
    <span>{{ skill }}</span>
  </span>
  {% endfor %}
</div>

<h2 class="mt-6 border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">
  GitHub Contributions</h2>
<div class="mt-3 w-full max-w-full overflow-x-auto border border-[#b7cbd6] bg-[#f4f8fa] p-3">
  <div class="mb-2 flex items-center justify-between text-xs text-[#556b78]">
    <span class="font-bold text-[#164b70]">@ShadowAmitendu on GitHub</span>
    <a class="text-[#064f83] underline hover:text-[#c0392b]" href="https://github.com/ShadowAmitendu" target="_blank"
      rel="noopener noreferrer">View Profile</a>
  </div>
  <a class="block min-w-0" href="https://github.com/ShadowAmitendu" target="_blank" rel="noopener noreferrer">
    <img class="block max-w-none" style="min-width: 640px; width: 640px;" src="https://ghchart.rshah.org/ShadowAmitendu"
      alt="ShadowAmitendu's GitHub Contributions Calendar" loading="lazy" />
  </a>
</div>

<h2 class="mt-6 border-b border-[#b7cbd6] pb-1 text-lg font-bold text-[#164b70]">
  Recent updates</h2>
{% if (collections.blog and collections.blog.length > 0) or (collections.portfolio and collections.portfolio.length > 0) %}
<ul class="mt-3 space-y-1 text-xs">
  {% for post in collections.blog %}
  {% if loop.index <= 2 %}<li><span class="text-[#71828b]">{{ post.data.date | shortDate }}</span> — New blog post: <a
      class="text-[#064f83] underline hover:text-[#c0392b]" href="{{ post.url }}">{{ post.data.title }}</a></li>
  {% endif %}
  {% endfor %}
  {% for project in collections.portfolio %}
  {% if loop.index <= 2 %}<li><span class="text-[#71828b]">{{ project.data.date | shortDate }}</span> — Added project:
    <a class="text-[#064f83] underline hover:text-[#c0392b]" href="{{ project.url }}">{{ project.data.title }}</a>
  </li>
  {% endif %}
  {% endfor %}
</ul>
{% else %}
<div class="mt-3 border border-[#b7cbd6] bg-[#f4f8fa] px-4 py-3 text-xs text-[#71828b]">
  No recent updates.
</div>
{% endif %}
