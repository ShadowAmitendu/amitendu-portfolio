---
layout: base.njk
title: Home
greeting: Hello, internet!
welcome: You found my little corner of the web.
aboutTitle: About this site
about: I am Shadow Amitendu, a developer who enjoys making things for the web. This is a small, quiet homepage built with Eleventy and Nunjucks.
currentlyTitle: Currently
currently:
  - learning something new
  - building useful little projects
  - listening to music while I work
profileImage: /images/shadow-amitendu.jpg
profileAlt: Shadow Amitendu
statusTitle: Status
status:
  - label: Currently
    value: building small websites
  - label: Listening to
    value: music while I work
  - label: Status
    value: online
links:
  - label: GitHub
    url: https://github.com/
  - label: Email
    url: mailto:hello@example.com
skills:
  - HTML
  - CSS
  - JavaScript
  - Eleventy
  - Nunjucks
  - Markdown
contactTitle: Contact
contact: Have a question or want to say hello? Send me an email.
badges:
  - HTML 4.01 Strict
  - CSS Validated
  - Best at 1024×768
  - Handcrafted with Care
  - RSS 2.0 Ready
  - AnyBrowser Friendly
---
<div class="site-intro border-l-4 border-[#e1a62a] bg-[#fff9e6] px-4 py-3">
  <p class="font-[Trebuchet_MS,Verdana,sans-serif] font-bold text-[#164b70]">{{ greeting }}</p>
  <p class="mt-1">{{ welcome }}</p>
</div>

<h2 id="about" class="mt-6 border-b border-[#b7cbd6] pb-1 font-[Trebuchet_MS,Verdana,sans-serif] text-lg font-bold text-[#164b70]">{{ aboutTitle }}</h2>
<div class="mt-3 flex items-start gap-4">
  <p class="flex-1">{{ about }}</p>
  {% if profileImage %}
    <img class="site-profile-frame h-24 w-24 shrink-0 object-cover" src="{{ profileImage }}" alt="{{ profileAlt }}" />
  {% endif %}
</div>

<h2 class="mt-6 border-b border-[#b7cbd6] pb-1 font-[Trebuchet_MS,Verdana,sans-serif] text-lg font-bold text-[#164b70]">{{ currentlyTitle }}</h2>
<ul class="mt-3 list-inside list-disc">
  {% for item in currently %}<li>{{ item }}</li>{% endfor %}
</ul>

<h2 class="mt-6 border-b border-[#b7cbd6] pb-1 font-[Trebuchet_MS,Verdana,sans-serif] text-lg font-bold text-[#164b70]">{{ statusTitle }}</h2>
<div class="mt-3 border border-[#b7cbd6] bg-[#f4f8fa] px-4 py-3">
  {% for item in status %}<p><span class="font-bold text-[#164b70]">{{ item.label }}:</span> {{ item.value }}</p>{% endfor %}
</div>

<h2 class="mt-6 border-b border-[#b7cbd6] pb-1 font-[Trebuchet_MS,Verdana,sans-serif] text-lg font-bold text-[#164b70]">Quick links</h2>
<div class="mt-3 flex flex-wrap gap-x-3 gap-y-1">
  {% for link in links %}<a class="text-[#064f83] underline hover:text-[#c0392b]" href="{{ link.url }}">{{ link.label }}</a>{% endfor %}
</div>

<h2 class="mt-6 border-b border-[#b7cbd6] pb-1 font-[Trebuchet_MS,Verdana,sans-serif] text-lg font-bold text-[#164b70]">Featured portfolio</h2>
<div class="mt-3 space-y-3">
  {% for project in collections.portfolio %}
    {% if loop.index <= site.featuredLimit %}
      <article class="site-card border border-[#b7cbd6] bg-[#f4f8fa] p-0">
        <a class="site-card-link block p-3 text-inherit no-underline" href="{{ project.url }}">
          <div class="site-card-row flex items-center justify-between gap-4">
            <div class="min-w-0">
              <h3 class="font-[Trebuchet_MS,Verdana,sans-serif] font-bold text-[#164b70]">{{ project.data.title }}</h3>
              <p class="mt-1">{{ project.data.description }}</p>
            </div>
            {% if project.data.image %}<img class="site-card-image h-20 w-24 max-w-full shrink-0 object-cover" src="{{ project.data.image }}" alt="{{ project.data.title }}" />{% endif %}
          </div>
        </a>
      </article>
    {% endif %}
  {% endfor %}
</div>

<h2 class="mt-6 border-b border-[#b7cbd6] pb-1 font-[Trebuchet_MS,Verdana,sans-serif] text-lg font-bold text-[#164b70]">Featured blog posts</h2>
<div class="mt-3 space-y-3">
  {% for post in collections.blog %}
    {% if loop.index <= site.featuredLimit %}
      <article class="site-card border border-[#b7cbd6] bg-[#f4f8fa] p-0">
        <a class="site-card-link block p-3 text-inherit no-underline" href="{{ post.url }}">
          <div class="site-card-row flex items-center justify-between gap-4">
            <div class="min-w-0">
              <h3 class="font-[Trebuchet_MS,Verdana,sans-serif] font-bold text-[#164b70]">{{ post.data.title }}</h3>
              <p class="mt-1">{{ post.data.description }}</p>
              {% if post.data.author %}<p class="mt-2 text-xs text-[#71828b]">by {{ post.data.author }}</p>{% endif %}
            </div>
            {% if post.data.image %}<img class="site-card-image h-20 w-24 max-w-full shrink-0 object-cover" src="{{ post.data.image }}" alt="{{ post.data.title }}" />{% endif %}
          </div>
        </a>
      </article>
    {% endif %}
  {% endfor %}
</div>

<h2 class="mt-6 border-b border-[#b7cbd6] pb-1 font-[Trebuchet_MS,Verdana,sans-serif] text-lg font-bold text-[#164b70]">Skills</h2>
<p class="mt-3">{{ skills | join(" · ") }}</p>

<h2 class="mt-6 border-b border-[#b7cbd6] pb-1 font-[Trebuchet_MS,Verdana,sans-serif] text-lg font-bold text-[#164b70]">Recent updates</h2>
<ul class="mt-3 space-y-1 text-xs">
  {% for post in collections.blog %}
    {% if loop.index <= 2 %}<li><span class="text-[#71828b]">{{ post.data.date | shortDate }}</span> — New blog post: <a class="text-[#064f83] underline hover:text-[#c0392b]" href="{{ post.url }}">{{ post.data.title }}</a></li>{% endif %}
  {% endfor %}
  {% for project in collections.portfolio %}
    {% if loop.index <= 2 %}<li><span class="text-[#71828b]">{{ project.data.date | shortDate }}</span> — Added project: <a class="text-[#064f83] underline hover:text-[#c0392b]" href="{{ project.url }}">{{ project.data.title }}</a></li>{% endif %}
  {% endfor %}
</ul>

<h2 class="mt-6 border-b border-[#b7cbd6] pb-1 font-[Trebuchet_MS,Verdana,sans-serif] text-lg font-bold text-[#164b70]">{{ contactTitle }}</h2>
<p class="mt-3">{{ contact }} <a class="text-[#064f83] underline hover:text-[#c0392b]" href="mailto:{{ site.email }}">Email me</a>.</p>

<div class="mt-6 flex flex-wrap gap-2">
  {% for badge in badges %}<span class="site-badge border border-[#7398b0] bg-[#e8f3f8] px-2 py-1 text-[10px] text-[#164b70]">{{ badge }}</span>{% endfor %}
</div>

<p class="mt-6 text-xs text-[#71828b]">Last updated: {{ buildDate | shortDate }}</p>
