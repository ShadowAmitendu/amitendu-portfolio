<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  {% set isHome = (page.url == '/' or page.url == '') %}
  {% set isAbout = ('/about/' in page.url) %}
  {% set isBlog = ('/blog/' in page.url or isPost or (tags and 'blog' in tags)) %}
  {% set isPortfolio = ('/portfolio/' in page.url or (tags and 'portfolio' in tags and not isPost)) %}
  {% set isResume = ('/resume/' in page.url or '/cv/' in page.url) %}
  {% set isShelf = ('/shelf/' in page.url or '/books-movies/' in page.url) %}
  {% set isApps = ('/apps/' in page.url or '/uses/' in page.url) %}
  {% set isDraft = draft or (tags and ('draft' in tags or tags == 'draft')) %}

  {% set displayTitle = title %}
  {% set displayTagline = headerTagline %}

  {% if isAbout and not isPost %}
  {% if aboutTab == 'books' %}
  {% set displayTitle = books.title or 'Books' %}
  {% set displayTagline = books.headerTagline or "WHAT I'M READING" %}
  {% elif aboutTab == 'movies' %}
  {% set displayTitle = movies.title or 'Movies' %}
  {% set displayTagline = movies.headerTagline or "WHAT I'M WATCHING" %}
  {% elif aboutTab == 'games' %}
  {% set displayTitle = games.title or 'Games' %}
  {% set displayTagline = games.headerTagline or "WHAT I'M PLAYING" %}
  {% elif aboutTab == 'software' %}
  {% set displayTitle = software.title or 'Software' %}
  {% set displayTagline = software.headerTagline or "TOOLS & APPS I USE" %}
  {% else %}
  {% set displayTitle = about.title or 'About' %}
  {% set displayTagline = about.headerTagline or 'ABOUT MYSELF' %}
  {% endif %}
  {% elif isResume and not isPost %}
  {% set displayTitle = resume.title or 'Resume' %}
  {% set displayTagline = resume.headerTagline or 'CURRICULUM VITAE' %}
  {% elif isPortfolio and page.url == '/portfolio/' %}
  {% set displayTitle = portfolioPage.title or 'Portfolio' %}
  {% set displayTagline = portfolioPage.headerTagline or 'MY WEB PORTFOLIO' %}
  {% elif isBlog and page.url == '/blog/' %}
  {% set displayTitle = blogPage.title or 'Blog' %}
  {% set displayTagline = blogPage.headerTagline or 'MY WEB LOG' %}
  {% elif isHome %}
  {% set displayTitle = site.title %}
  {% set displayTagline = site.tagline %}
  {% endif %}

  {% if not displayTitle %}{% set displayTitle = site.title %}{% endif %}
  {% if not displayTagline %}{% set displayTagline = site.tagline %}{% endif %}

  {# Computed SEO Variables #}
  {% set canonicalUrl = site.url ~ (page.url or '/') %}

  {% set pageDesc = description %}
  {% if not pageDesc %}
  {% if isAbout and not isPost %}
  {% if aboutTab == 'books' %}
  {% set pageDesc = books.intro or "Books read and recommended by Amitendu Bikash Dhusiya (ShadowAmitendu)." %}
  {% elif aboutTab == 'movies' %}
  {% set pageDesc = movies.intro or "Cinema, shows, and anime enjoyed by Amitendu Bikash Dhusiya (ShadowAmitendu)." %}
  {% elif aboutTab == 'games' %}
  {% set pageDesc = games.intro or "Video games played by Amitendu Bikash Dhusiya (ShadowAmitendu)." %}
  {% elif aboutTab == 'software' %}
  {% set pageDesc = software.intro or "Software, developer tools, and applications used by Amitendu Bikash Dhusiya (ShadowAmitendu)." %}
  {% elif aboutTab == 'friends' %}
  {% set pageDesc = friends.intro or "Friends, fellow developers, and creative homepages recommended by Amitendu Bikash Dhusiya (ShadowAmitendu)." %}
  {% else %}
  {% set pageDesc = about.intro or "Learn more about Amitendu Bikash Dhusiya (ShadowAmitendu) — BCA student, developer, and tech enthusiast." %}
  {% endif %}
  {% elif isResume and not isPost %}
  {% set pageDesc = resume.intro or "Curriculum Vitae and resume of Amitendu Bikash Dhusiya — Skills, experience, education, and technical background." %}
  {% elif isPortfolio and page.url == '/portfolio/' %}
  {% set pageDesc = portfolioPage.intro or "Web and software development portfolio projects by Amitendu Bikash Dhusiya (ShadowAmitendu)." %}
  {% elif isBlog and page.url == '/blog/' %}
  {% set pageDesc = blogPage.intro or "Articles, thoughts, and development logs by Amitendu Bikash Dhusiya (ShadowAmitendu)." %}
  {% elif isHome %}
  {% set pageDesc = site.description %}
  {% else %}
  {% set pageDesc = site.description %}
  {% endif %}
  {% endif %}

  {% set socialImage = image or site.ogImage %}
  {% if socialImage and not socialImage.startsWith('http') %}
  {% set socialImageUrl = site.url ~ socialImage %}
  {% else %}
  {% set socialImageUrl = socialImage %}
  {% endif %}

  <title>{% if isHome %}{{ site.title }} :: Home{% elif displayTitle and displayTitle != site.title %}{{ displayTitle }}{% if pagination.pageNumber and pagination.pageNumber > 0 %} (Page {{ pagination.pageNumber + 1 }}){% endif %} :: {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>

  {# Primary Search Engine Meta Tags #}
  <meta name="description" content="{{ pageDesc | escape }}" />
  <meta name="keywords" content="{{ site.keywords | escape }}" />
  <meta name="author" content="{{ author or site.name }}" />
  <meta name="robots"
    content="{% if isDraft %}noindex, nofollow{% else %}index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1{% endif %}" />
  <meta name="googlebot" content="{% if isDraft %}noindex, nofollow{% else %}index, follow{% endif %}" />
  <link rel="canonical" href="{{ canonicalUrl }}" />
  <meta name="generator" content="Eleventy" />
  <meta name="theme-color" content="#164b70" />
  <meta name="color-scheme" content="light" />

  {# Open Graph / Social Media Meta Tags #}
  <meta property="og:site_name" content="{{ site.title }}" />
  <meta property="og:type" content="{{ 'article' if isPost else 'website' }}" />
  <meta property="og:title" content="{% if isHome %}{{ site.title }} :: Home{% else %}{{ displayTitle }}{% endif %}" />
  <meta property="og:description" content="{{ pageDesc | escape }}" />
  <meta property="og:url" content="{{ canonicalUrl }}" />
  <meta property="og:image" content="{{ socialImageUrl }}" />
  <meta property="og:image:alt" content="{{ displayTitle }}" />
  <meta property="og:locale" content="en_US" />
  {% if isPost %}
  {% if date %}
  <meta property="article:published_time" content="{{ date | isoDate }}" />{% endif %}
  <meta property="article:author" content="{{ author or site.name }}" />
  {% if tags %}
  {% for tag in tags %}
  {% if tag != "blog" and tag != "post" %}
  <meta property="article:tag" content="{{ tag }}" />{% endif %}
  {% endfor %}
  {% endif %}
  {% endif %}

  {# Twitter / X Card Meta Tags #}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="{{ site.twitter }}" />
  <meta name="twitter:creator" content="{{ site.twitter }}" />
  <meta name="twitter:title" content="{% if isHome %}{{ site.title }} :: Home{% else %}{{ displayTitle }}{% endif %}" />
  <meta name="twitter:description" content="{{ pageDesc | escape }}" />
  <meta name="twitter:image" content="{{ socialImageUrl }}" />
  <meta name="twitter:image:alt" content="{{ displayTitle }}" />

  {# JSON-LD Structured Data Schema #}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "{{ site.url }}/#website",
        "url": "{{ site.url }}/",
        "name": {{ site.title | dump | safe }},
        "alternateName": {{ (site.handle or "ShadowAmitendu") | dump | safe }},
        "description": {{ site.description | dump | safe }},
        "inLanguage": "en-US"
      },
      {
        "@type": "Person",
        "@id": "{{ site.url }}/#person",
        "name": {{ site.name | dump | safe }},
        "alternateName": {{ (site.handle or "ShadowAmitendu") | dump | safe }},
        "url": "{{ site.url }}/",
        "image": "{{ site.url }}{{ site.author.avatar }}",
        "jobTitle": {{ site.author.role | dump | safe }},
        "email": "mailto:{{ site.email }}",
        "sameAs": [
          "https://github.com/ShadowAmitendu",
          "https://www.youtube.com/@ShadowAmitendu",
          "https://x.com/shadow_amitendu",
          "https://www.linkedin.com/in/amitendu/",
          "https://peerlist.io/amitendu"
        ]
      }{% if isPost %},
      {
        "@type": "BlogPosting",
        "@id": "{{ canonicalUrl }}#article",
        "headline": {{ title | dump | safe }},
        "description": {{ pageDesc | dump | safe }},
        "url": "{{ canonicalUrl }}",
        {% if date %}"datePublished": "{{ date | isoDate }}",{% endif %}
        "author": {
          "@type": "Person",
          "name": {{ (author or site.name) | dump | safe }}
        },
        "publisher": {
          "@type": "Person",
          "name": {{ site.name | dump | safe }}
        },
        "image": "{{ socialImageUrl }}",
        "inLanguage": "en-US"
      }
      {% endif %}
    ]
  }
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Bebas+Neue&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/assets/styles.css?v=20261015b" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>

<body class="site-body min-h-screen px-4 py-10 font-['Barlow_Condensed',sans-serif] text-[#222]">
  <main class="site-shell mx-auto max-w-6xl p-1">
    <header class="site-header relative overflow-hidden text-white">
      {% set pageHeaderBanner = headerBanner or banner or pageBanner or (about and about.headerBanner) or (home and home.headerBanner) or (portfolioPage and portfolioPage.headerBanner) or (blogPage and blogPage.headerBanner) or (resume and resume.headerBanner) or (books and books.headerBanner) or (movies and movies.headerBanner) or (games and games.headerBanner) or (software and software.headerBanner) or (friends and friends.headerBanner) or (site and site.headerBanner) or '/images/header-banner.jpg' %}
      <img class="site-header-banner absolute inset-0 h-full w-full object-cover" src="{{ pageHeaderBanner }}" alt="" />
      <div class="relative px-5 py-4">
        <p class="text-center text-xs tracking-[0.2em] text-[#b8d9e8]">{{ displayTagline }}</p>
        <h1 class="mt-1 text-center tracking-tight">
          {{ displayTitle }}</h1>
      </div>
    </header>

    <nav class="site-nav text-xs">
      <div
        class="site-nav-links flex flex-nowrap items-center justify-center gap-0.5 sm:gap-1 px-1 sm:px-5 py-1 text-[11px] sm:text-xs overflow-x-auto whitespace-nowrap scrollbar-none">
        <a class="site-nav-link shrink-0 {% if isHome %}bg-[#164b70] text-white font-bold shadow-[inset_0_1px_2px_rgba(0,0,0,0.35)] no-underline{% else %}text-[#064f83] underline hover:text-[#c0392b] hover:bg-[#dce9f0]{% endif %} px-1.5 sm:px-2 py-0.5"
          href="/">home</a>
        <span class="px-0.5 sm:px-1 text-[#8aa2af] shrink-0 text-[10px] sm:text-xs select-none">|</span>
        <a class="site-nav-link shrink-0 {% if isAbout %}bg-[#164b70] text-white font-bold shadow-[inset_0_1px_2px_rgba(0,0,0,0.35)] no-underline{% else %}text-[#064f83] underline hover:text-[#c0392b] hover:bg-[#dce9f0]{% endif %} px-1.5 sm:px-2 py-0.5"
          href="/about/">about</a>
        <span class="px-0.5 sm:px-1 text-[#8aa2af] shrink-0 text-[10px] sm:text-xs select-none">|</span>
        <a class="site-nav-link shrink-0 {% if isPortfolio %}bg-[#164b70] text-white font-bold shadow-[inset_0_1px_2px_rgba(0,0,0,0.35)] no-underline{% else %}text-[#064f83] underline hover:text-[#c0392b] hover:bg-[#dce9f0]{% endif %} px-1.5 sm:px-2 py-0.5"
          href="/portfolio/">portfolio</a>
        <span class="px-0.5 sm:px-1 text-[#8aa2af] shrink-0 text-[10px] sm:text-xs select-none">|</span>
        <a class="site-nav-link shrink-0 {% if isBlog %}bg-[#164b70] text-white font-bold shadow-[inset_0_1px_2px_rgba(0,0,0,0.35)] no-underline{% else %}text-[#064f83] underline hover:text-[#c0392b] hover:bg-[#dce9f0]{% endif %} px-1.5 sm:px-2 py-0.5"
          href="/blog/">blog</a>
        <span class="px-0.5 sm:px-1 text-[#8aa2af] shrink-0 text-[10px] sm:text-xs select-none">|</span>
        <a class="site-nav-link shrink-0 {% if isResume %}bg-[#164b70] text-white font-bold shadow-[inset_0_1px_2px_rgba(0,0,0,0.35)] no-underline{% else %}text-[#064f83] underline hover:text-[#c0392b] hover:bg-[#dce9f0]{% endif %} px-1.5 sm:px-2 py-0.5"
          href="/resume/">resume</a>
      </div>
      {% if not isHome %}
      <div
        class="site-nav-breadcrumbs flex flex-wrap items-center justify-center gap-1.5 border-t border-[#c6d7e0] bg-[#edf4f7] px-5 py-1 text-[14px] text-[#536a75] shadow-[inset_0_1px_0_#fff]">
        <span class="font-bold text-[#164b70]">Location:</span>
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/">home</a>
        <span class="text-[#8aa2af]">&gt;</span>
        {% if isBlog %}
        {% if isPost or (tags and 'blog' in tags and page.url != '/blog/') %}
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/blog/">blog</a>
        <span class="text-[#8aa2af]">&gt;</span>
        <span class="font-bold text-[#164b70]">{{ title }}</span>
        {% elif pagination and pagination.pageNumber and pagination.pageNumber > 0 %}
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/blog/">blog</a>
        <span class="text-[#8aa2af]">&gt;</span>
        <span class="font-bold text-[#164b70]">page {{ pagination.pageNumber + 1 }}</span>
        {% else %}
        <span class="font-bold text-[#164b70]">blog</span>
        {% endif %}
        {% elif isPortfolio %}
        {% if tags and 'portfolio' in tags and page.url != '/portfolio/' %}
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/portfolio/">portfolio</a>
        <span class="text-[#8aa2af]">&gt;</span>
        <span class="font-bold text-[#164b70]">{{ title }}</span>
        {% elif pagination and pagination.pageNumber and pagination.pageNumber > 0 %}
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/portfolio/">portfolio</a>
        <span class="text-[#8aa2af]">&gt;</span>
        <span class="font-bold text-[#164b70]">page {{ pagination.pageNumber + 1 }}</span>
        {% else %}
        <span class="font-bold text-[#164b70]">portfolio</span>
        {% endif %}
        {% elif isAbout %}
        {% if page.url == '/about/' %}
        <span class="font-bold text-[#164b70]">about</span>
        {% else %}
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/about/">about</a>
        <span class="text-[#8aa2af]">&gt;</span>
        <span class="font-bold text-[#164b70]">{{ aboutTab or title }}</span>
        {% endif %}
        {% elif isResume %}
        <span class="font-bold text-[#164b70]">resume</span>
        {% elif '/authors/' in page.url %}
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/about/">about</a>
        <span class="text-[#8aa2af]">&gt;</span>
        <span class="font-bold text-[#164b70]">{{ name or title }}</span>
        {% else %}
        <span class="font-bold text-[#164b70]">{{ title }}</span>
        {% endif %}
      </div>
      {% endif %}
    </nav>
    <div class="site-columns">
      <aside class="site-sidebar site-sidebar-left">
        {% if site.author %}
        <div class="site-sidebar-card mb-4">
          <div class="site-sidebar-card-header">
            About Me
          </div>
          <div class="site-sidebar-card-body">
            <div class="flex items-center gap-2.5">
              {% if site.author.avatar %}
              <img class="site-profile-frame h-11 w-11 shrink-0 object-cover" src="{{ site.author.avatar }}"
                alt="{{ site.author.name }}" width="44" height="44" />
              {% endif %}
              <div class="min-w-0">
                <p class="truncate font-bold leading-tight text-[#164b70] text-sm">{{ site.author.name }}</p>
                <p class="mt-0.5 text-[11px] leading-tight text-[#556b78]">{{ site.author.role }}</p>
              </div>
            </div>
            {% if site.author.bio %}
            <p class="mt-2.5 text-[12px] leading-snug text-[#3b4d57] border-t border-[#d8e3ea] pt-2">
              {{ site.author.bio }}</p>
            {% endif %}
            {% if site.author.resumeUrl %}
            <div class="mt-2.5">
              <a class="site-button-2007" href="{{ site.author.resumeUrl }}">View Resume</a>
            </div>
            {% endif %}
          </div>
        </div>
        {% endif %}
        <h2>{{ site.leftSidebar.title }}</h2>
        {% for item in site.leftSidebar.items %}
        {% set itemActive = false %}
        {% if item.url == '/' and isHome %}
        {% set itemActive = true %}
        {% elif item.url == '/about/' and isAbout %}
        {% set itemActive = true %}
        {% elif item.url == '/blog/' and isBlog %}
        {% set itemActive = true %}
        {% elif item.url == '/portfolio/' and isPortfolio %}
        {% set itemActive = true %}
        {% elif (item.url == '/resume/' or item.url == '/cv/') and isResume %}
        {% set itemActive = true %}
        {% elif (item.url == '/shelf/' or item.url == '/books-movies/') and isShelf %}
        {% set itemActive = true %}
        {% elif (item.url == '/apps/' or item.url == '/uses/') and isApps %}
        {% set itemActive = true %}
        {% endif %}
        <p>
          {% if itemActive %}
          <span
            class="inline-block bg-[#164b70] text-white font-bold px-1.5 py-0.5 text-[14px] shadow-[inset_0_1px_2px_rgba(0,0,0,0.3)]">{{ item.label }}</span>
          {% else %}
          <a class="text-[#064f83] underline hover:text-[#c0392b]" href="{{ item.url }}">{{ item.label }}</a>
          {% endif %}
        </p>
        {% endfor %}
        <div class="mt-5 border-t border-[#b7cbd6] pt-3">
          <h2>{{ (site.sidebar and site.sidebar.recentPostsTitle) or 'Recent Posts' }}</h2>
          <div class="mt-2 space-y-2">
            {% set recentPosts = collections.blog.slice(0, (site.sidebar and site.sidebar.recentPostsLimit) or 3) %}
            {% if recentPosts and recentPosts.length > 0 %}
            {% for post in recentPosts %}
            <div>
              <a class="block text-[13px] leading-snug text-[#064f83] underline hover:text-[#c0392b]"
                href="{{ post.url }}">{{ post.data.title }}</a>
              <span class="text-[11px] text-[#71828b]">{{ post.data.date | shortDate }}</span>
            </div>
            {% endfor %}
            {% else %}
            <p class="text-[12px] italic text-[#71828b]">No posts yet.</p>
            {% endif %}
          </div>
        </div>
        <div class="mt-5 border-t border-[#b7cbd6] pt-3">
          <h2>{{ (site.sidebar and site.sidebar.favoritesTitle) or 'Favorites' }}</h2>
          <div class="mt-2 space-y-2">
            {% if collections.fav and collections.fav.length > 0 %}
            {% for item in collections.fav.slice(0, 4) %}
            <div class="flex items-start gap-1.5">
              <svg class="mt-0.5 h-3.5 w-3.5 shrink-0 text-[#e1a62a]" xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20" fill="currentColor">
                <path
                  d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
              <div>
                <a class="block text-[13px] leading-snug text-[#064f83] underline hover:text-[#c0392b]"
                  href="{{ item.url }}">{{ item.data.title }}</a>
                <span
                  class="text-[11px] text-[#71828b]">{% if 'portfolio' in item.data.tags %}Project{% else %}Article{% endif %}</span>
              </div>
            </div>
            {% endfor %}
            {% else %}
            <p class="text-[12px] italic text-[#71828b]">No favorites tagged yet.</p>
            {% endif %}
          </div>
        </div>
      </aside>
      <section class="site-content px-5 py-6 text-sm leading-6">
        {% if draft and not isPost %}
        <div
          class="mb-4 border border-dashed border-[#d97706] bg-[#fffbeb] px-3.5 py-2 text-xs font-bold text-[#b45309]">
          DRAFT - This project is saved as a draft and is hidden from public listings.
        </div>
        {% endif %}
        {% if image and not isPost and not hideHeroImage %}<img
          class="site-full-image mb-4 h-auto max-h-none w-full object-contain" src="{{ image }}"
          alt="{{ title }}" />{% endif %}
        {% if author and not isPost %}
        <div class="mb-4 flex items-center gap-2 text-xs text-[#71828b]">
          {% if authorImage %}<img class="h-7 w-7 object-cover" src="{{ authorImage }}" alt="{{ author }}" />{% endif %}
          <span>by {{ author }}</span>
        </div>
        {% endif %}
        {{ content | safe }}
      </section>
      <aside class="site-sidebar site-sidebar-right">
        <h2>{{ site.rightSidebar.title }}</h2>
        <div class="mt-2 space-y-2">
          {% for item in site.rightSidebar.items %}
          {% set itemIcon = item.url | resolveIcon(item.label, item.icon) %}
          <div>
            <a class="flex items-center gap-2 text-[#064f83] hover:text-[#c0392b]" href="{{ item.url }}"
              {% if item.url and item.url.startsWith('http') %}target="_blank" rel="noopener noreferrer" {% endif %}>
              <img class="site-macos-icon h-5 w-5 shrink-0 rounded-[4.5px] shadow-[0_1px_2px_rgba(0,0,0,0.25)]"
                src="/assets/icons/macos-{{ itemIcon }}.png" alt="" width="20" height="20" />
              <span class="underline">{{ item.label }}</span>
            </a>
          </div>
          {% endfor %}
        </div>
        {# Book I am reading Card in Right Sidebar #}
        {% set sidebarBook = null %}
        {% for b in (books.items or shelf.books) %}
        {% if (b.status == "currently-reading" or b.status == "reading") and not sidebarBook %}
        {% set sidebarBook = b %}
        {% endif %}
        {% endfor %}
        {% if not sidebarBook and (books.items and books.items.length > 0) %}
        {% set sidebarBook = books.items[0] %}
        {% endif %}
        {% if sidebarBook %}
        <div class="mt-5 border-t border-[#b7cbd6] pt-3">
          <div class="site-card border border-[#b7cbd6] bg-[#f4f8fa] p-0 flex flex-col overflow-hidden">
            <div
              class="border-b border-[#c6d7e0] bg-[#e4eef2] px-2.5 py-1 font-bold text-[#164b70] text-xs flex justify-between items-center shadow-[inset_0_1px_0_#fff]">
              <span>Book I am reading</span>
              <span class="text-[10px] text-[#556b78] font-normal">Reading</span>
            </div>
            <div class="p-2.5 text-center flex flex-col items-center">
              <a class="my-1 block hover:opacity-90" href="/about/books/"
                title="{{ sidebarBook.title }} - view on bookshelf">
                {% if sidebarBook.image %}
                <img
                  class="h-24 w-16 object-contain border border-[#7892a3] bg-white p-0.5 shadow-[0_1px_2px_rgba(0,0,0,0.12)]"
                  src="{{ sidebarBook.image }}" alt="{{ sidebarBook.title }}" />
                {% else %}
                <div
                  class="h-20 w-14 border border-[#7892a3] bg-[#dce9ef] flex items-center justify-center text-[10px] font-bold text-[#164b70]">
                  BOOK
                </div>
                {% endif %}
              </a>
              <h3 class="font-bold text-[#164b70] text-sm mt-1 leading-tight tracking-tight uppercase">
                <a class="text-[#164b70] underline hover:text-[#c0392b]"
                  href="/about/books/">{{ sidebarBook.title }}</a>
              </h3>
              {% if sidebarBook.author %}
              <p class="text-[11px] text-[#556b78] mt-0.5">by {{ sidebarBook.author }}</p>
              {% endif %}
            </div>
          </div>
        </div>
        {% endif %}

        {# Games I play Card in Right Sidebar #}
        {% set sidebarGame = null %}
        {% for g in (games.items or []) %}
        {% if not sidebarGame %}
        {% if g.playingRightNow or g.playingNow or g.status == "Playing right now" or (g.tags and ("Playing right now" in g.tags or "playing right now" in g.tags)) %}
        {% set sidebarGame = g %}
        {% endif %}
        {% endif %}
        {% endfor %}
        {% if not sidebarGame %}
        {% for g in (games.items or []) %}
        {% if not sidebarGame and (g.status == "Currently Playing" or g.status == "currently-playing" or g.status == "Ongoing") %}
        {% set sidebarGame = g %}
        {% endif %}
        {% endfor %}
        {% endif %}
        {% if not sidebarGame and (games.items and games.items.length > 0) %}
        {% set sidebarGame = games.items[0] %}
        {% endif %}

        {% if games.items and games.items.length > 0 %}
        <div class="mt-5 border-t border-[#b7cbd6] pt-3">
          <div class="site-card border border-[#b7cbd6] bg-[#f4f8fa] p-0 flex flex-col overflow-hidden">
            <div
              class="border-b border-[#c6d7e0] bg-[#e4eef2] px-2.5 py-1 font-bold text-[#164b70] text-xs flex justify-between items-center shadow-[inset_0_1px_0_#fff]">
              <span>Games I play</span>
              <span class="text-[10px] text-[#556b78] font-normal">Ongoing</span>
            </div>
            {% if sidebarGame %}
            {% set sGameImg = sidebarGame.image or sidebarGame.icon %}
            <div class="p-2.5 text-center flex flex-col items-center">
              <a class="my-1 block hover:opacity-90" href="/about/games/"
                title="{{ sidebarGame.name }} - view on games page">
                {% if sGameImg %}
                <img
                  class="h-20 w-20 object-contain border border-[#7892a3] bg-white p-1 shadow-[0_1px_2px_rgba(0,0,0,0.12)]"
                  src="{{ sGameImg }}" alt="{{ sidebarGame.name }}" />
                {% else %}
                <div
                  class="h-16 w-16 border border-[#7892a3] bg-[#dce9ef] flex items-center justify-center text-[10px] font-bold text-[#164b70]">
                  GAME
                </div>
                {% endif %}
              </a>
              <h3 class="font-bold text-[#164b70] text-sm mt-1 leading-tight tracking-tight uppercase">
                <a class="text-[#164b70] underline hover:text-[#c0392b]" href="/about/games/">{{ sidebarGame.name }}</a>
              </h3>
              <p class="text-[11px] text-[#556b78] mt-0.5">
                {{ sidebarGame.platform or sidebarGame.publisher or "PC" }}
              </p>
            </div>
            {% endif %}

            {# If there are other games, show them as icons below the featured game, all linking to /about/games/ #}
            {% if games.items.length > 1 %}
            <div
              class="border-t border-[#d8e3ea] bg-[#eef4f7] px-2 py-1.5 flex flex-wrap items-center justify-center gap-1.5">
              {% for g in games.items %}
              {% if g != sidebarGame and (g.icon or g.image) %}
              <a class="block border border-[#7892a3] bg-white p-0.5 hover:border-[#c0392b]" href="/about/games/"
                title="{{ g.name }}{% if g.status %} [{{ g.status }}]{% endif %}">
                <img class="h-6 w-6 object-contain" src="{{ g.icon or g.image }}" alt="{{ g.name }}" width="24"
                  height="24" />
              </a>
              {% endif %}
              {% endfor %}
            </div>
            {% endif %}
          </div>
        </div>
        {% endif %}

        {# Software Icons in Right Sidebar #}
        {% set sidebarSoftware = software.items %}
        {% if sidebarSoftware and sidebarSoftware.length > 0 %}
        <div class="mt-5 border-t border-[#b7cbd6] pt-3">
          <h2>Software</h2>
          <div class="mt-2 flex flex-wrap gap-1.5">
            {% for s in sidebarSoftware %}
            {% if s.icon %}
            <a class="block border border-[#7892a3] bg-white p-0.5 hover:border-[#c0392b]"
              href="{{ s.link or '/about/software/' }}"
              title="{{ s.name }}{% if s.category %} [{{ s.category }}]{% endif %}"
              {% if s.link and s.link.startsWith('http') %}target="_blank" rel="noopener noreferrer" {% endif %}>
              <img class="h-6 w-6 object-contain" src="{{ s.icon }}" alt="{{ s.name }}" width="24" height="24" />
            </a>
            {% endif %}
            {% endfor %}
          </div>
          <div class="mt-2 text-right text-xs">
            <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/about/software/">View software &raquo;</a>
          </div>
        </div>
        {% endif %}

        {# Friends Section in Right Sidebar #}
        {% set sidebarFriends = friends.items %}
        {% if sidebarFriends and sidebarFriends.length > 0 %}
        <div class="mt-5 border-t border-[#b7cbd6] pt-3">
          <h2>Friends &amp; Allies</h2>
          <div class="mt-2 space-y-2">
            {% for f in sidebarFriends.slice(0, 4) %}
            <div class="flex items-center gap-2">
              {% if f.avatar %}
              <img class="h-5 w-5 shrink-0 object-cover border border-[#7892a3] bg-white p-0.5" src="{{ f.avatar }}"
                alt="{{ f.name }}" width="20" height="20" />
              {% else %}
              <span
                class="h-5 w-5 shrink-0 border border-[#7892a3] bg-[#dce9ef] flex items-center justify-center text-[9px] font-bold text-[#164b70]">✦</span>
              {% endif %}
              <div class="min-w-0 flex-1 truncate">
                <a class="text-[13px] leading-snug text-[#064f83] underline hover:text-[#c0392b]"
                  href="{{ f.url or '/about/friends/' }}" {% if f.url and f.url.startsWith('http') %}target="_blank"
                  rel="noopener noreferrer" {% endif %}>{{ f.name }}</a>
                {% if f.relationship %}
                <span class="block text-[10px] text-[#71828b] leading-tight truncate">{{ f.relationship }}</span>
                {% endif %}
              </div>
            </div>
            {% endfor %}
          </div>
          <div class="mt-2 text-right text-xs">
            <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/about/friends/">All friends &raquo;</a>
          </div>
        </div>
        {% endif %}

      </aside>
    </div>
    <footer class="site-footer px-5 py-4 text-center text-[14px] text-[#71828b]">
      <p class="font-bold text-[#164b70]">{{ site.footerTitle }}</p>
      <p class="mt-1">&copy; {% currentYear %} {{ site.title }}. {{ site.footer }}</p>
      <p class="mt-2">
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/">home</a>
        <span class="px-1">·</span>
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/about/">about</a>
        <span class="px-1">·</span>
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/blog/">blog</a>
        <span class="px-1">·</span>
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/portfolio/">portfolio</a>
        <span class="px-1">·</span>
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/resume/">resume</a>
      </p>
      <p class="mt-2 text-[10px]">Last updated: {{ buildDate | shortDate }}</p>
    </footer>
  </main>
  <script>
    if ( window.netlifyIdentity )
    {
      window.netlifyIdentity.on( "init", ( user ) =>
      {
        if ( !user )
        {
          window.netlifyIdentity.on( "login", () =>
          {
            document.location.href = "/admin/";
          } );
        }
      } );
    }
  </script>
  <script>
    ( function ()
    {
      function openExternalLinksInNewTab ()
      {
        var links = document.querySelectorAll( 'a[href]' );
        for ( var i = 0; i < links.length; i++ )
        {
          var a = links[ i ];
          var href = a.getAttribute( 'href' );
          if ( !href || href.charAt( 0 ) === '#' || href.indexOf( 'javascript:' ) === 0 ) continue;
          var isInternal = (
            href.charAt( 0 ) === '/' ||
            href.indexOf( './' ) === 0 ||
            href.indexOf( '../' ) === 0 ||
            a.hostname === window.location.hostname
          );
          if ( !isInternal )
          {
            a.setAttribute( 'target', '_blank' );
            a.setAttribute( 'rel', 'noopener noreferrer' );
          }
        }
      }
      if ( document.readyState === 'loading' )
      {
        document.addEventListener( 'DOMContentLoaded', openExternalLinksInNewTab );
      } else
      {
        openExternalLinksInNewTab();
      }
      document.addEventListener( 'click', function ( e )
      {
        var a = e.target && e.target.closest ? e.target.closest( 'a[href]' ) : null;
        if ( !a ) return;
        var href = a.getAttribute( 'href' );
        if ( !href || href.charAt( 0 ) === '#' || href.indexOf( 'javascript:' ) === 0 ) return;
        var isInternal = (
          href.charAt( 0 ) === '/' ||
          href.indexOf( './' ) === 0 ||
          href.indexOf( '../' ) === 0 ||
          a.hostname === window.location.hostname
        );
        if ( !isInternal )
        {
          a.setAttribute( 'target', '_blank' );
          a.setAttribute( 'rel', 'noopener noreferrer' );
        }
      } );
    } )();
  </script>

  {# Modern fluid smooth scrolling using Lenis #}
  <script src="https://unpkg.com/lenis@1.1.18/dist/lenis.min.js"></script>
  <script>
    ( function ()
    {
      if ( typeof Lenis === 'undefined' ) return;
      // Respect accessibility preferences for reduced motion
      var prefersReducedMotion = window.matchMedia && window.matchMedia( '(prefers-reduced-motion: reduce)' ).matches;
      if ( prefersReducedMotion ) return;

      var lenis = new Lenis( {
        duration: 1.2,
        easing: function ( t ) { return Math.min( 1, 1.001 - Math.pow( 2, -10 * t ) ); },
        orientation: 'vertical',
        gestureOrientation: 'vertical',
        smoothWheel: true,
        wheelMultiplier: 1,
        touchMultiplier: 2,
        infinite: false
      } );

      function raf ( time )
      {
        lenis.raf( time );
        requestAnimationFrame( raf );
      }
      requestAnimationFrame( raf );

      // Smooth scroll for anchor links
      document.querySelectorAll( 'a[href^="#"]' ).forEach( function ( anchor )
      {
        anchor.addEventListener( 'click', function ( e )
        {
          var targetId = this.getAttribute( 'href' );
          if ( targetId && targetId.length > 1 )
          {
            var targetEl = document.querySelector( targetId );
            if ( targetEl )
            {
              e.preventDefault();
              lenis.scrollTo( targetEl, { offset: -20 } );
            }
          }
        } );
      } );
    } )();
  </script>

  {# Windows 7 / Frutiger Aero Lightbox Modal Dialog (Windows Photo Viewer) #}
  <div id="siteLightbox" class="site-lightbox-overlay" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="site-lightbox-window win7-aero-window"
      style="border-radius: 14px !important; overflow: hidden !important; -webkit-mask-image: -webkit-radial-gradient(white, black); mask-image: -webkit-radial-gradient(white, black);"
      role="document">
      {# Top Specular Aero Glass Reflection #}
      <div class="win7-aero-glass-shine"></div>

      {# Windows 7 Titlebar with Aero Glow & Close Button #}
      <div class="site-lightbox-titlebar win7-aero-titlebar">
        <div class="win7-title-group flex items-center gap-1.5 min-w-0 pr-14">
          {# Official Windows Photo Viewer Icon #}
          <img src="/images/windows-photo-viewer.png" alt=""
            class="h-4 w-4 shrink-0 drop-shadow-[0_1px_1px_rgba(0,0,0,0.35)] object-contain select-none" />
          <span id="siteLightboxTitle" class="win7-title-text truncate">Windows Photo Viewer</span>
        </div>

        {# Windows 7 Glowing Red Close Button (From Top to Center) #}
        <button type="button" class="site-lightbox-close win7-btn-close" aria-label="Close image viewer"
          onclick="closeSiteLightbox()">
          <span>✕</span>
        </button>
      </div>

      {# Inner Client Area (White Stage with rounded corners) #}
      <div class="site-lightbox-body win7-client-area">
        <div class="win7-image-stage">
          <img id="siteLightboxImg" src="" alt="" />
        </div>
        <div id="siteLightboxCaption" class="site-lightbox-caption win7-caption"></div>
      </div>
    </div>
  </div>

  <script>
    ( function ()
    {
      var overlay = document.getElementById( 'siteLightbox' );
      var modalImg = document.getElementById( 'siteLightboxImg' );
      var modalCaption = document.getElementById( 'siteLightboxCaption' );
      var modalTitle = document.getElementById( 'siteLightboxTitle' );
      if ( !overlay || !modalImg ) return;

      var currentRotation = 0;
      var isZoomed = false;

      function applyTransform ()
      {
        var scale = isZoomed ? 'scale(1.4)' : 'scale(1)';
        var rot = 'rotate(' + currentRotation + 'deg)';
        modalImg.style.transform = rot + ' ' + scale;
        modalImg.style.transition = 'transform 0.22s cubic-bezier(0.16, 1, 0.3, 1)';
      }

      window.openSiteLightbox = function ( src, caption )
      {
        currentRotation = 0;
        isZoomed = false;
        modalImg.style.transform = 'none';
        modalImg.src = src;
        modalImg.alt = caption || 'Expanded image';
        modalCaption.textContent = caption || '';
        modalCaption.style.display = caption ? 'block' : 'none';
        modalTitle.textContent = ( caption ? caption + ' - ' : '' ) + 'Windows Photo Viewer';
        overlay.classList.add( 'is-active' );
        overlay.setAttribute( 'aria-hidden', 'false' );
        document.body.style.overflow = 'hidden';
      };

      window.rotateLightbox = function ( deg )
      {
        currentRotation = ( currentRotation + deg ) % 360;
        applyTransform();
      };

      window.toggleLightboxZoom = function ()
      {
        isZoomed = !isZoomed;
        applyTransform();
      };

      window.toggleLightboxFit = function ()
      {
        isZoomed = false;
        currentRotation = 0;
        applyTransform();
      };

      window.resetLightboxTransform = function ()
      {
        currentRotation = 0;
        isZoomed = false;
        applyTransform();
      };

      window.closeSiteLightbox = function ()
      {
        overlay.classList.remove( 'is-active' );
        overlay.setAttribute( 'aria-hidden', 'true' );
        modalImg.src = '';
        currentRotation = 0;
        isZoomed = false;
        modalImg.style.transform = 'none';
        document.body.style.overflow = '';
      };

      overlay.addEventListener( 'click', function ( e )
      {
        if ( e.target === overlay )
        {
          window.closeSiteLightbox();
        }
      } );

      document.addEventListener( 'keydown', function ( e )
      {
        if ( overlay.classList.contains( 'is-active' ) )
        {
          if ( e.key === 'Escape' )
          {
            window.closeSiteLightbox();
          }
          else if ( e.key === 'ArrowRight' || e.key === '.' )
          {
            window.rotateLightbox( 90 );
          }
          else if ( e.key === 'ArrowLeft' || e.key === ',' )
          {
            window.rotateLightbox( -90 );
          }
        }
      } );

      // Event delegation for lightbox clicks anywhere in site-entry-body or with data-lightbox
      document.addEventListener( 'click', function ( e )
      {
        var trigger = e.target && e.target.closest ? e.target.closest( 'a[data-lightbox="true"], .site-lightbox-trigger' ) : null;
        if ( trigger )
        {
          e.preventDefault();
          var href = trigger.getAttribute( 'href' );
          var caption = trigger.getAttribute( 'data-caption' ) || trigger.getAttribute( 'title' ) || '';
          if ( href )
          {
            window.openSiteLightbox( href, caption );
          }
          return;
        }

        // Also allow direct clicking of any image inside .site-entry-body, .site-entry-image-frame, or .site-entry-hero to zoom
        var bodyImg = e.target && e.target.closest ? e.target.closest( '.site-entry-body img, .site-entry-image-frame img, .site-entry-hero img, .site-entry-header img' ) : null;
        if ( bodyImg && !bodyImg.closest( 'a' ) )
        {
          e.preventDefault();
          var src = bodyImg.getAttribute( 'src' );
          var cap = bodyImg.getAttribute( 'alt' ) || bodyImg.getAttribute( 'title' ) || '';
          if ( src )
          {
            window.openSiteLightbox( src, cap );
          }
        }
      } );
    } )();
  </script>
