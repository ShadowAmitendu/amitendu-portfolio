  <!-- Lanyard Live Discord Presence Tracker -->
  <script>
    (function() {
      var userId = '553845371131002891';
      var dot = document.getElementById('discord-status-dot');
      var avatarDot = document.getElementById('discord-avatar-dot');
      var label = document.getElementById('discord-status-label');
      var avatar = document.getElementById('discord-avatar');
      var userDisplay = document.getElementById('discord-user-display');
      var userTag = document.getElementById('discord-user-tag');
      var activityText = document.getElementById('discord-activity-text');

      var statusConfig = {
        online: { color: '#22c55e', text: 'Online' },
        idle: { color: '#eab308', text: 'Idle' },
        dnd: { color: '#ef4444', text: 'DND' },
        offline: { color: '#94a3b8', text: 'Offline' }
      };

      function updateUI(d) {
        if (!d) return;
        var status = d.discord_status || 'offline';
        var conf = statusConfig[status] || statusConfig.offline;

        if (dot) dot.style.backgroundColor = conf.color;
        if (avatarDot) avatarDot.style.backgroundColor = conf.color;
        if (label) label.textContent = conf.text;

        if (d.discord_user) {
          if (d.discord_user.avatar && avatar) {
            avatar.src = 'https://cdn.discordapp.com/avatars/' + d.discord_user.id + '/' + d.discord_user.avatar + '.png?size=64';
          }
          if (userDisplay && (d.discord_user.global_name || d.discord_user.username)) {
            userDisplay.textContent = d.discord_user.global_name || d.discord_user.username;
          }
          if (userTag && d.discord_user.username) {
            userTag.textContent = '@' + d.discord_user.username;
          }
        }

        if (activityText) {
          if (d.listening_to_spotify && d.spotify) {
            activityText.innerHTML = '🎵 ' + (d.spotify.song || 'Music') + ' - ' + (d.spotify.artist || '');
          } else if (d.activities && d.activities.length > 0) {
            var game = d.activities.find(function(a) { return a.type === 0; });
            var custom = d.activities.find(function(a) { return a.type === 4; });
            if (game) {
              activityText.innerHTML = '🎮 Playing <strong>' + (game.name || '') + '</strong>';
            } else if (custom && custom.state) {
              activityText.textContent = (custom.emoji ? (custom.emoji.name + ' ') : '💭 ') + custom.state;
            } else {
              activityText.textContent = d.activities[0].name || 'Active on Discord';
            }
          } else {
            activityText.textContent = status === 'offline' ? 'Chat on Discord' : 'Online on Discord';
          }
        }
      }

      // Initial REST fetch
      fetch('https://api.lanyard.rest/v1/users/' + userId)
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data && data.success && data.data) {
            updateUI(data.data);
          }
        })
        .catch(function(err) {});

      // WebSocket connection for real-time presence sync
      try {
        var ws = new WebSocket('wss://api.lanyard.rest/socket');
        var heartbeatInterval;
        ws.onopen = function() {};
        ws.onmessage = function(event) {
          try {
            var msg = JSON.parse(event.data);
            if (msg.op === 1) {
              heartbeatInterval = setInterval(function() {
                ws.send(JSON.stringify({ op: 3 }));
              }, msg.d.heartbeat_interval);
              ws.send(JSON.stringify({ op: 2, d: { subscribe_to_id: userId } }));
            } else if (msg.op === 0 && (msg.t === 'INIT_STATE' || msg.t === 'PRESENCE_UPDATE')) {
              updateUI(msg.d);
            }
          } catch (e) {}
        };
        ws.onclose = function() {
          if (heartbeatInterval) clearInterval(heartbeatInterval);
        };
      } catch (e) {}
    })();
  </script>
