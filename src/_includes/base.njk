<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {% set isHome = (page.url == '/' or page.url == '') %}
  {% set isAbout = ('/about/' in page.url) %}
  {% set isBlog = ('/blog/' in page.url or isPost or (tags and 'blog' in tags)) %}
  {% set isPortfolio = ('/portfolio/' in page.url or (tags and 'portfolio' in tags and not isPost)) %}
  {% set isResume = ('/resume/' in page.url or '/cv/' in page.url) %}

  {% set displayTitle = title %}
  {% set displayTagline = headerTagline %}

  {% if isAbout and not isPost %}
  {% set displayTitle = about.title or 'About' %}
  {% set displayTagline = about.headerTagline or 'ABOUT MYSELF' %}
  {% elif isResume and not isPost %}
  {% set displayTitle = resume.title or 'Resume' %}
  {% set displayTagline = resume.headerTagline or 'CURRICULUM VITAE' %}
  {% elif isPortfolio and page.url == '/portfolio/' %}
  {% set displayTitle = portfolioPage.title or 'Portfolio' %}
  {% set displayTagline = portfolioPage.headerTagline or 'MY WEB PORTFOLIO' %}
  {% elif isBlog and page.url == '/blog/' %}
  {% set displayTitle = blogPage.title or 'Blog' %}
  {% set displayTagline = blogPage.headerTagline or 'MY WEB LOG' %}
  {% elif isHome %}
  {% set displayTitle = site.title %}
  {% set displayTagline = site.tagline %}
  {% endif %}

  {% if not displayTitle %}{% set displayTitle = site.title %}{% endif %}
  {% if not displayTagline %}{% set displayTagline = site.tagline %}{% endif %}
  <title>
    {% if displayTitle and displayTitle != site.title %}{{ displayTitle }}{% if pagination.pageNumber and pagination.pageNumber > 0 %}
    (Page {{ pagination.pageNumber + 1 }}){% endif %} : : {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/assets/styles.css" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate icon" href="/favicon.ico" />
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>

<body class="site-body min-h-screen px-4 py-10 font-['Barlow_Condensed',sans-serif] text-[#222]">
  <main class="site-shell mx-auto max-w-6xl p-1">
    <header class="site-header relative overflow-hidden text-white">
      <img class="site-header-banner absolute inset-0 h-full w-full object-cover" src="/images/header-banner.jpg"
        alt="" />
      <div class="relative px-5 py-4">
        <p class="text-center text-xs tracking-[0.2em] text-[#b8d9e8]">{{ displayTagline }}</p>
        <h1 class="mt-1 text-center font-[Trebuchet_MS,Verdana,sans-serif] tracking-tight">
          {{ displayTitle }}</h1>
      </div>
    </header>

    <nav class="site-nav text-xs">
      <div class="site-nav-links flex flex-wrap items-center justify-center gap-1 px-5 py-1.5">
        <a class="site-nav-link {% if isHome %}bg-[#164b70] text-white font-bold shadow-[inset_0_1px_2px_rgba(0,0,0,0.35)] no-underline{% else %}text-[#064f83] underline hover:text-[#c0392b] hover:bg-[#dce9f0]{% endif %} px-2 py-0.5"
          href="/">home</a>
        <span class="px-1 text-[#8aa2af]">|</span>
        <a class="site-nav-link {% if isAbout %}bg-[#164b70] text-white font-bold shadow-[inset_0_1px_2px_rgba(0,0,0,0.35)] no-underline{% else %}text-[#064f83] underline hover:text-[#c0392b] hover:bg-[#dce9f0]{% endif %} px-2 py-0.5"
          href="/about/">about</a>
        <span class="px-1 text-[#8aa2af]">|</span>
        <a class="site-nav-link {% if isPortfolio %}bg-[#164b70] text-white font-bold shadow-[inset_0_1px_2px_rgba(0,0,0,0.35)] no-underline{% else %}text-[#064f83] underline hover:text-[#c0392b] hover:bg-[#dce9f0]{% endif %} px-2 py-0.5"
          href="/portfolio/">portfolio</a>
        <span class="px-1 text-[#8aa2af]">|</span>
        <a class="site-nav-link {% if isBlog %}bg-[#164b70] text-white font-bold shadow-[inset_0_1px_2px_rgba(0,0,0,0.35)] no-underline{% else %}text-[#064f83] underline hover:text-[#c0392b] hover:bg-[#dce9f0]{% endif %} px-2 py-0.5"
          href="/blog/">blog</a>
        <span class="px-1 text-[#8aa2af]">|</span>
        <a class="site-nav-link {% if isResume %}bg-[#164b70] text-white font-bold shadow-[inset_0_1px_2px_rgba(0,0,0,0.35)] no-underline{% else %}text-[#064f83] underline hover:text-[#c0392b] hover:bg-[#dce9f0]{% endif %} px-2 py-0.5"
          href="/resume/">resume</a>
      </div>
      {% if not isHome %}
      <div
        class="site-nav-breadcrumbs flex flex-wrap items-center justify-center gap-1.5 border-t border-[#c6d7e0] bg-[#edf4f7] px-5 py-1 text-[14px] text-[#536a75] shadow-[inset_0_1px_0_#fff]">
        <span class="font-bold text-[#164b70]">Location:</span>
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/">home</a>
        <span class="text-[#8aa2af]">&gt;</span>
        {% if isBlog %}
        {% if isPost or (tags and 'blog' in tags and page.url != '/blog/') %}
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/blog/">blog</a>
        <span class="text-[#8aa2af]">&gt;</span>
        <span class="font-bold text-[#164b70]">{{ title }}</span>
        {% elif pagination and pagination.pageNumber and pagination.pageNumber > 0 %}
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/blog/">blog</a>
        <span class="text-[#8aa2af]">&gt;</span>
        <span class="font-bold text-[#164b70]">page {{ pagination.pageNumber + 1 }}</span>
        {% else %}
        <span class="font-bold text-[#164b70]">blog</span>
        {% endif %}
        {% elif isPortfolio %}
        {% if tags and 'portfolio' in tags and page.url != '/portfolio/' %}
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/portfolio/">portfolio</a>
        <span class="text-[#8aa2af]">&gt;</span>
        <span class="font-bold text-[#164b70]">{{ title }}</span>
        {% elif pagination and pagination.pageNumber and pagination.pageNumber > 0 %}
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/portfolio/">portfolio</a>
        <span class="text-[#8aa2af]">&gt;</span>
        <span class="font-bold text-[#164b70]">page {{ pagination.pageNumber + 1 }}</span>
        {% else %}
        <span class="font-bold text-[#164b70]">portfolio</span>
        {% endif %}
        {% elif isAbout %}
        <span class="font-bold text-[#164b70]">about</span>
        {% elif isResume %}
        <span class="font-bold text-[#164b70]">resume</span>
        {% elif '/authors/' in page.url %}
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/about/">about</a>
        <span class="text-[#8aa2af]">&gt;</span>
        <span class="font-bold text-[#164b70]">{{ name or title }}</span>
        {% else %}
        <span class="font-bold text-[#164b70]">{{ title }}</span>
        {% endif %}
      </div>
      {% endif %}
    </nav>
    <div class="site-columns">
      <aside class="site-sidebar site-sidebar-left">
        {% if site.author %}
        <div class="site-sidebar-card mb-4">
          <div class="site-sidebar-card-header">
            About Me
          </div>
          <div class="site-sidebar-card-body">
            <div class="flex items-center gap-2.5">
              {% if site.author.avatar %}
              <img class="site-profile-frame h-11 w-11 shrink-0 object-cover" src="{{ site.author.avatar }}"
                alt="{{ site.author.name }}" width="44" height="44" />
              {% endif %}
              <div class="min-w-0">
                <p class="truncate font-bold leading-tight text-[#164b70] text-sm">{{ site.author.name }}</p>
                <p class="mt-0.5 text-[11px] leading-tight text-[#556b78]">{{ site.author.role }}</p>
              </div>
            </div>
            {% if site.author.bio %}
            <p class="mt-2.5 text-[12px] leading-snug text-[#3b4d57] border-t border-[#d8e3ea] pt-2">
              {{ site.author.bio }}</p>
            {% endif %}
            {% if site.author.resumeUrl %}
            <div class="mt-2.5">
              <a class="site-button-2007" href="{{ site.author.resumeUrl }}">View Resume</a>
            </div>
            {% endif %}
          </div>
        </div>
        {% endif %}
        <h2>{{ site.leftSidebar.title }}</h2>
        {% for item in site.leftSidebar.items %}
        {% set itemActive = false %}
        {% if item.url == '/' and isHome %}
        {% set itemActive = true %}
        {% elif item.url == '/about/' and isAbout %}
        {% set itemActive = true %}
        {% elif item.url == '/blog/' and isBlog %}
        {% set itemActive = true %}
        {% elif item.url == '/portfolio/' and isPortfolio %}
        {% set itemActive = true %}
        {% elif (item.url == '/resume/' or item.url == '/cv/') and isResume %}
        {% set itemActive = true %}
        {% endif %}
        <p>
          {% if itemActive %}
          <span
            class="inline-block bg-[#164b70] text-white font-bold px-1.5 py-0.5 text-[14px] shadow-[inset_0_1px_2px_rgba(0,0,0,0.3)]">{{ item.label }}</span>
          {% else %}
          <a class="text-[#064f83] underline hover:text-[#c0392b]" href="{{ item.url }}">{{ item.label }}</a>
          {% endif %}
        </p>
        {% endfor %}
        <div class="mt-5 border-t border-[#b7cbd6] pt-3 text-center">
          <a href='https://www.acadoo.de/leistungen/ghostwriter-doktorarbeit/'>Dissertation Unterstützung</a>
          <script type='text/javascript'
            src='https://www.freevisitorcounters.com/auth.php?id=6c686d026fc4d2924a3282e7be0e6fe32bd5922c'></script>
          <script type="text/javascript" src="https://www.freevisitorcounters.com/en/home/counter/1668210/t/0"></script>
        </div>
      </aside>
      <section class="site-content px-5 py-6 text-sm leading-6">
        {% if draft and not isPost %}
        <div
          class="mb-4 border border-dashed border-[#d97706] bg-[#fffbeb] px-3.5 py-2 text-xs font-bold text-[#b45309]">
          DRAFT - This project is saved as a draft and is hidden from public listings.
        </div>
        {% endif %}
        {% if image and not isPost and not hideHeroImage %}<img
          class="site-full-image mb-4 h-auto max-h-none w-full object-contain" src="{{ image }}"
          alt="{{ title }}" />{% endif %}
        {% if author and not isPost %}
        <div class="mb-4 flex items-center gap-2 text-xs text-[#71828b]">
          {% if authorImage %}<img class="h-7 w-7 object-cover" src="{{ authorImage }}" alt="{{ author }}" />{% endif %}
          <span>by {{ author }}</span>
        </div>
        {% endif %}
        {{ content | safe }}
      </section>
      <aside class="site-sidebar site-sidebar-right">
        <h2>{{ site.rightSidebar.title }}</h2>
        <div class="mt-2 space-y-2">
          {% for item in site.rightSidebar.items %}
          {% set itemIcon = item.icon %}
          {% if not itemIcon %}
          {% set itemUrl = item.url | lower %}
          {% set itemLabel = item.label | lower %}
          {% if 'github' in itemUrl or 'github' in itemLabel %}
          {% set itemIcon = 'github' %}
          {% elif 'mailto' in itemUrl or 'email' in itemLabel or 'mail' in itemLabel %}
          {% set itemIcon = 'mail' %}
          {% elif 'twitter' in itemUrl or 'twitter' in itemLabel or 'x.com' in itemUrl %}
          {% set itemIcon = 'twitter' %}
          {% elif 'linkedin' in itemUrl or 'linkedin' in itemLabel %}
          {% set itemIcon = 'linkedin' %}
          {% elif 'discord' in itemUrl or 'discord' in itemLabel %}
          {% set itemIcon = 'discord' %}
          {% elif 'youtube' in itemUrl or 'youtube' in itemLabel %}
          {% set itemIcon = 'youtube' %}
          {% elif 'terminal' in itemLabel or 'code' in itemLabel %}
          {% set itemIcon = 'terminal' %}
          {% elif 'finder' in itemLabel %}
          {% set itemIcon = 'finder' %}
          {% elif 'notes' in itemLabel %}
          {% set itemIcon = 'notes' %}
          {% else %}
          {% set itemIcon = 'safari' %}
          {% endif %}
          {% endif %}
          <div>
            <a class="flex items-center gap-2 text-[#064f83] hover:text-[#c0392b]" href="{{ item.url }}">
              <img class="site-macos-icon h-5 w-5 shrink-0 rounded-[4.5px] shadow-[0_1px_2px_rgba(0,0,0,0.25)]"
                src="/assets/icons/macos-{{ itemIcon }}.png" alt="" width="20" height="20" />
              <span class="underline">{{ item.label }}</span>
            </a>
          </div>
          {% endfor %}
        </div>
        <div class="mt-5 border-t border-[#b7cbd6] pt-3">
          <h2>{{ (site.sidebar and site.sidebar.recentPostsTitle) or 'Recent Posts' }}</h2>
          <div class="mt-2 space-y-2">
            {% set recentPosts = collections.blog.slice(0, (site.sidebar and site.sidebar.recentPostsLimit) or 3) %}
            {% if recentPosts and recentPosts.length > 0 %}
            {% for post in recentPosts %}
            <div>
              <a class="block text-[13px] leading-snug text-[#064f83] underline hover:text-[#c0392b]"
                href="{{ post.url }}">{{ post.data.title }}</a>
              <span class="text-[11px] text-[#71828b]">{{ post.data.date | shortDate }}</span>
            </div>
            {% endfor %}
            {% else %}
            <p class="text-[12px] italic text-[#71828b]">No posts yet.</p>
            {% endif %}
          </div>
        </div>
        <div class="mt-5 border-t border-[#b7cbd6] pt-3">
          <h2>{{ (site.sidebar and site.sidebar.favoritesTitle) or 'Favorites' }}</h2>
          <div class="mt-2 space-y-2">
            {% if collections.fav and collections.fav.length > 0 %}
            {% for item in collections.fav.slice(0, 4) %}
            <div class="flex items-start gap-1.5">
              <svg class="mt-0.5 h-3.5 w-3.5 shrink-0 text-[#e1a62a]" xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20" fill="currentColor">
                <path
                  d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
              <div>
                <a class="block text-[13px] leading-snug text-[#064f83] underline hover:text-[#c0392b]"
                  href="{{ item.url }}">{{ item.data.title }}</a>
                <span
                  class="text-[11px] text-[#71828b]">{% if 'portfolio' in item.data.tags %}Project{% else %}Article{% endif %}</span>
              </div>
            </div>
            {% endfor %}
            {% else %}
            <p class="text-[12px] italic text-[#71828b]">No favorites tagged yet.</p>
            {% endif %}
          </div>
        </div>
      </aside>
    </div>
    <footer class="site-footer px-5 py-4 text-center text-[14px] text-[#71828b]">
      <p class="font-bold text-[#164b70]">{{ site.footerTitle }}</p>
      <p class="mt-1">&copy; {% currentYear %} {{ site.title }}. {{ site.footer }}</p>
      <p class="mt-2">
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/">home</a>
        <span class="px-1">·</span>
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/about/">about</a>
        <span class="px-1">·</span>
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/blog/">blog</a>
        <span class="px-1">·</span>
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/portfolio/">portfolio</a>
        <span class="px-1">·</span>
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/resume/">resume</a>
      </p>
      <p class="mt-2 text-[10px]">Last updated: {{ buildDate | shortDate }}</p>
    </footer>
  </main>
  <script>
    if ( window.netlifyIdentity )
    {
      window.netlifyIdentity.on( "init", ( user ) =>
      {
        if ( !user )
        {
          window.netlifyIdentity.on( "login", () =>
          {
            document.location.href = "/admin/";
          } );
        }
      } );
    }
  </script>
</body>

</html>
