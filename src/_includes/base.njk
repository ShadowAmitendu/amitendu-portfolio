<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    {% set isHome = (page.url == '/' or page.url == '') %}
    {% set isAbout = ('/about/' in page.url) %}
    {%
      set isBlog = ('/blog/' in page.url or isPost or (tags and 'blog' in tags))
    %}
    {%
      set isPortfolio = ('/portfolio/' in page.url or (tags and 'portfolio' in tags and not isPost))
    %}
    {% set isResume = ('/resume/' in page.url or '/cv/' in page.url) %}
    {% set isShelf = ('/shelf/' in page.url or '/books-movies/' in page.url) %}
    {% set isApps = ('/apps/' in page.url or '/uses/' in page.url) %}
    {% set isDraft = draft or (tags and ('draft' in tags or tags == 'draft')) %}

    {% set displayTitle = title %}
    {% set displayTagline = headerTagline %}

    {% if isAbout and not isPost %}
      {% if aboutTab == 'books' %}
        {% set displayTitle = books.title or 'Books' %}
        {% set displayTagline = books.headerTagline or "WHAT I'M READING" %}
      {% elif aboutTab == 'movies' %}
        {% set displayTitle = movies.title or 'Movies' %}
        {% set displayTagline = movies.headerTagline or "WHAT I'M WATCHING" %}
      {% elif aboutTab == 'anime' %}
        {% set displayTitle = anime.title or 'Anime' %}
        {% set displayTagline = anime.headerTagline or "WHAT I'M WATCHING" %}
      {% elif aboutTab == 'games' %}
        {% set displayTitle = games.title or 'Games' %}
        {% set displayTagline = games.headerTagline or "WHAT I'M PLAYING" %}
      {% elif aboutTab == 'software' %}
        {% set displayTitle = software.title or 'Software' %}
        {%
          set displayTagline = software.headerTagline or "TOOLS & APPS I USE"
        %}
      {% elif aboutTab == 'gear' %}
        {% set displayTitle = gear.title or 'Gear' %}
        {%
          set displayTagline = gear.headerTagline or "MY DESK & DAILY DRIVERS"
        %}
      {% else %}
        {% set displayTitle = about.title or 'About' %}
        {% set displayTagline = about.headerTagline or 'ABOUT MYSELF' %}
      {% endif %}
    {% elif isResume and not isPost %}
      {% set displayTitle = resume.title or 'Resume' %}
      {% set displayTagline = resume.headerTagline or 'CURRICULUM VITAE' %}
    {% elif isPortfolio and page.url == '/portfolio/' %}
      {% set displayTitle = portfolioPage.title or 'Portfolio' %}
      {%
        set displayTagline = portfolioPage.headerTagline or 'MY WEB PORTFOLIO'
      %}
    {% elif isBlog and page.url == '/blog/' %}
      {% set displayTitle = blogPage.title or 'Blog' %}
      {% set displayTagline = blogPage.headerTagline or 'MY WEB LOG' %}
    {% elif isHome %}
      {% set displayTitle = site.title %}
      {% set displayTagline = site.tagline %}
    {% endif %}

    {% if not displayTitle %}{% set displayTitle = site.title %}{% endif %}
    {% if not displayTagline %}{% set displayTagline = site.tagline %}{%
      endif
    %}

    {% set canonicalUrl = canonical or (site.url ~ (page.url or '/')) %}

    {% set pageDesc = description %}
    {% if not pageDesc %}
      {% if isAbout and not isPost %}
        {% if aboutTab == 'books' %}
          {%
            set pageDesc = books.intro or "Books read and recommended by Amitendu Bikash Dhusiya (ShadowAmitendu)."
          %}
        {% elif aboutTab == 'movies' %}
          {%
            set pageDesc = movies.intro or "Cinema, shows, and films enjoyed by Amitendu Bikash Dhusiya (ShadowAmitendu)."
          %}
        {% elif aboutTab == 'anime' %}
          {%
            set pageDesc = anime.intro or "Anime series, films, and animations enjoyed by Amitendu Bikash Dhusiya (ShadowAmitendu)."
          %}
        {% elif aboutTab == 'games' %}
          {%
            set pageDesc = games.intro or "Video games played by Amitendu Bikash Dhusiya (ShadowAmitendu)."
          %}
        {% elif aboutTab == 'software' %}
          {%
            set pageDesc = software.intro or "Software, developer tools, and applications used by Amitendu Bikash Dhusiya (ShadowAmitendu)."
          %}
        {% elif aboutTab == 'friends' %}
          {%
            set pageDesc = friends.intro or "Friends, fellow developers, and creative homepages recommended by Amitendu Bikash Dhusiya (ShadowAmitendu)."
          %}
        {% elif aboutTab == 'gear' %}
          {%
            set pageDesc = gear.intro or "Hardware, workstation specs, and daily peripherals used by Amitendu Bikash Dhusiya (ShadowAmitendu)."
          %}
        {% else %}
          {%
            set pageDesc = about.intro or "Learn more about Amitendu Bikash Dhusiya (ShadowAmitendu) — BCA student, developer, and tech enthusiast."
          %}
        {% endif %}
      {% elif isResume and not isPost %}
        {%
          set pageDesc = resume.intro or "Curriculum Vitae and resume of Amitendu Bikash Dhusiya — Skills, experience, education, and technical background."
        %}
      {% elif isPortfolio and page.url == '/portfolio/' %}
        {%
          set pageDesc = portfolioPage.intro or "Web and software development portfolio projects by Amitendu Bikash Dhusiya (ShadowAmitendu)."
        %}
      {% elif isBlog and page.url == '/blog/' %}
        {%
          set pageDesc = blogPage.intro or "Articles, thoughts, and development logs by Amitendu Bikash Dhusiya (ShadowAmitendu)."
        %}
      {% elif isHome %}
        {% set pageDesc = site.description %}
      {% else %}
        {% set pageDesc = site.description %}
      {% endif %}
    {% endif %}

    {% set socialImage = ogImage or image or site.ogImage %}
    {% if socialImage and not socialImage.startsWith('http') %}
      {% set socialImageUrl = site.url ~ socialImage %}
    {% else %}
      {% set socialImageUrl = socialImage %}
    {% endif %}

    {% include "components/head-meta.njk" %}
  </head>

  <body class="site-body min-h-screen px-4 py-10 font-['Barlow_Condensed',sans-serif] text-[#222]">
    <main class="site-shell mx-auto max-w-6xl p-1">
      {% include "components/announcement.njk" %}

      {% include "components/header.njk" %}

      {% include "components/nav.njk" %}
      <div class="site-columns">
        {% include "components/sidebar-left.njk" %}
        <section class="site-content px-5 py-6 text-sm leading-6">
          {%
            set isProject = isPortfolio and (page.url != '/portfolio/' and not ('/portfolio/page/' in page.url))
          %}
          {% if isProject %}
            {% include "components/project-detail.njk" %}
          {% else %}
            {% if draft and not isPost %}
              <div class="mb-4 border border-dashed border-[#d97706] bg-[#fffbeb] px-3.5 py-2 text-xs font-bold text-[#b45309]">
                DRAFT - This project is saved as a draft and is hidden from
                public listings.
              </div>
            {% endif %}
            {% if image and not isPost and not hideHeroImage %}<img
                class="site-full-image mb-4 h-auto max-h-none w-full object-contain"
                src="{{ image }}"
                alt="{{ imageAlt or title }}"
              />{% endif %}
            {% if author and not isPost %}
              <div class="mb-4 flex items-center gap-2 text-xs text-[#71828b]">
                {% if authorImage %}<img
                    class="h-7 w-7 object-cover"
                    src="{{ authorImage }}"
                    alt="{{ author }}"
                  />{% endif %}
                <span>by {{ author }}</span>
              </div>
            {% endif %}
            {{ content | safe }}
          {% endif %}
        </section>
        {% include "components/sidebar-right.njk" %}
      </div>
      {% include "components/footer.njk" %}
    </main>
    <script>
    if (window.netlifyIdentity) {
  window.netlifyIdentity.on("init", (user) => {
    if (!user) {
      window.netlifyIdentity.on("login", () => {
        document.location.href = "/admin/";
      });
    }
  });
}
    </script>
    <script>
    (function() {
  function openExternalLinksInNewTab() {
    var links = document.querySelectorAll("a[href]");
    for (var i = 0; i < links.length; i++) {
      var a = links[i];
      var href = a.getAttribute("href");
      if (
        !href || href.charAt(0) === "#" || href.indexOf("javascript:") === 0
      ) continue;
      var isInternal = href.charAt(0) === "/"
        || href.indexOf("./") === 0
        || href.indexOf("../") === 0
        || a.hostname === window.location.hostname;
      if (!isInternal) {
        a.setAttribute("target", "_blank");
        a.setAttribute("rel", "noopener noreferrer");
      }
    }
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", openExternalLinksInNewTab);
  } else {
    openExternalLinksInNewTab();
  }
  document.addEventListener("click", function(e) {
    var a = e.target && e.target.closest ? e.target.closest("a[href]") : null;
    if (!a) return;
    var href = a.getAttribute("href");
    if (!href || href.charAt(0) === "#" || href.indexOf("javascript:") === 0) {
      return;
    }
    var isInternal = href.charAt(0) === "/"
      || href.indexOf("./") === 0
      || href.indexOf("../") === 0
      || a.hostname === window.location.hostname;
    if (!isInternal) {
      a.setAttribute("target", "_blank");
      a.setAttribute("rel", "noopener noreferrer");
    }
  });
})();
    </script>

    {# Modern fluid smooth scrolling using Lenis #}
    <script src="https://unpkg.com/lenis@1.1.18/dist/lenis.min.js"></script>
    <script>
    (function() {
  if (typeof Lenis === "undefined") return;
  // Respect accessibility preferences for reduced motion
  var prefersReducedMotion = window.matchMedia
    && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (prefersReducedMotion) return;

  var lenis = new Lenis({
    duration: 1.2,
    easing: function(t) {
      return Math.min(1, 1.001 - Math.pow(2, -10 * t));
    },
    orientation: "vertical",
    gestureOrientation: "vertical",
    smoothWheel: true,
    wheelMultiplier: 1,
    touchMultiplier: 2,
    infinite: false,
  });

  function raf(time) {
    lenis.raf(time);
    requestAnimationFrame(raf);
  }
  requestAnimationFrame(raf);

  // Smooth scroll for anchor links
  document.querySelectorAll("a[href^=\"#\"]").forEach(function(anchor) {
    anchor.addEventListener("click", function(e) {
      var targetId = this.getAttribute("href");
      if (targetId && targetId.length > 1) {
        var targetEl = document.querySelector(targetId);
        if (targetEl) {
          e.preventDefault();
          lenis.scrollTo(targetEl, { offset: -20 });
        }
      }
    });
  });
})();
    </script>

    {% include "components/lightbox.njk" %}
  </body>
</html>
