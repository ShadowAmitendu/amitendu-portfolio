<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  {% set isHome = (page.url == '/' or page.url == '') %}
  {% set isAbout = ('/about/' in page.url) %}
  {% set isBlog = ('/blog/' in page.url or isPost or (tags and 'blog' in tags)) %}
  {% set isPortfolio = ('/portfolio/' in page.url or (tags and 'portfolio' in tags and not isPost)) %}
  {% set isResume = ('/resume/' in page.url or '/cv/' in page.url) %}
  {% set isShelf = ('/shelf/' in page.url or '/books-movies/' in page.url) %}
  {% set isApps = ('/apps/' in page.url or '/uses/' in page.url) %}
  {% set isDraft = draft or (tags and ('draft' in tags or tags == 'draft')) %}

  {% set displayTitle = title %}
  {% set displayTagline = headerTagline %}

  {% if isAbout and not isPost %}
  {% if aboutTab == 'books' %}
  {% set displayTitle = books.title or 'Books' %}
  {% set displayTagline = books.headerTagline or "WHAT I'M READING" %}
  {% elif aboutTab == 'movies' %}
  {% set displayTitle = movies.title or 'Movies' %}
  {% set displayTagline = movies.headerTagline or "WHAT I'M WATCHING" %}
  {% elif aboutTab == 'anime' %}
  {% set displayTitle = anime.title or 'Anime' %}
  {% set displayTagline = anime.headerTagline or "WHAT I'M WATCHING" %}
  {% elif aboutTab == 'games' %}
  {% set displayTitle = games.title or 'Games' %}
  {% set displayTagline = games.headerTagline or "WHAT I'M PLAYING" %}
  {% elif aboutTab == 'software' %}
  {% set displayTitle = software.title or 'Software' %}
  {% set displayTagline = software.headerTagline or "TOOLS & APPS I USE" %}
  {% elif aboutTab == 'gear' %}
  {% set displayTitle = gear.title or 'Gear' %}
  {% set displayTagline = gear.headerTagline or "MY DESK & DAILY DRIVERS" %}
  {% else %}
  {% set displayTitle = about.title or 'About' %}
  {% set displayTagline = about.headerTagline or 'ABOUT MYSELF' %}
  {% endif %}
  {% elif isResume and not isPost %}
  {% set displayTitle = resume.title or 'Resume' %}
  {% set displayTagline = resume.headerTagline or 'CURRICULUM VITAE' %}
  {% elif isPortfolio and page.url == '/portfolio/' %}
  {% set displayTitle = portfolioPage.title or 'Portfolio' %}
  {% set displayTagline = portfolioPage.headerTagline or 'MY WEB PORTFOLIO' %}
  {% elif isBlog and page.url == '/blog/' %}
  {% set displayTitle = blogPage.title or 'Blog' %}
  {% set displayTagline = blogPage.headerTagline or 'MY WEB LOG' %}
  {% elif isHome %}
  {% set displayTitle = site.title %}
  {% set displayTagline = site.tagline %}
  {% endif %}

  {% if not displayTitle %}{% set displayTitle = site.title %}{% endif %}
  {% if not displayTagline %}{% set displayTagline = site.tagline %}{% endif %}

  {% set canonicalUrl = canonical or (site.url ~ (page.url or '/')) %}

  {% set pageDesc = description %}
  {% if not pageDesc %}
  {% if isAbout and not isPost %}
  {% if aboutTab == 'books' %}
  {% set pageDesc = books.intro or "Books read and recommended by Amitendu Bikash Dhusiya (ShadowAmitendu)." %}
  {% elif aboutTab == 'movies' %}
  {% set pageDesc = movies.intro or "Cinema, shows, and films enjoyed by Amitendu Bikash Dhusiya (ShadowAmitendu)." %}
  {% elif aboutTab == 'anime' %}
  {% set pageDesc = anime.intro or "Anime series, films, and animations enjoyed by Amitendu Bikash Dhusiya (ShadowAmitendu)." %}
  {% elif aboutTab == 'games' %}
  {% set pageDesc = games.intro or "Video games played by Amitendu Bikash Dhusiya (ShadowAmitendu)." %}
  {% elif aboutTab == 'software' %}
  {% set pageDesc = software.intro or "Software, developer tools, and applications used by Amitendu Bikash Dhusiya (ShadowAmitendu)." %}
  {% elif aboutTab == 'friends' %}
  {% set pageDesc = friends.intro or "Friends, fellow developers, and creative homepages recommended by Amitendu Bikash Dhusiya (ShadowAmitendu)." %}
  {% elif aboutTab == 'gear' %}
  {% set pageDesc = gear.intro or "Hardware, workstation specs, and daily peripherals used by Amitendu Bikash Dhusiya (ShadowAmitendu)." %}
  {% else %}
  {% set pageDesc = about.intro or "Learn more about Amitendu Bikash Dhusiya (ShadowAmitendu) — BCA student, developer, and tech enthusiast." %}
  {% endif %}
  {% elif isResume and not isPost %}
  {% set pageDesc = resume.intro or "Curriculum Vitae and resume of Amitendu Bikash Dhusiya — Skills, experience, education, and technical background." %}
  {% elif isPortfolio and page.url == '/portfolio/' %}
  {% set pageDesc = portfolioPage.intro or "Web and software development portfolio projects by Amitendu Bikash Dhusiya (ShadowAmitendu)." %}
  {% elif isBlog and page.url == '/blog/' %}
  {% set pageDesc = blogPage.intro or "Articles, thoughts, and development logs by Amitendu Bikash Dhusiya (ShadowAmitendu)." %}
  {% elif isHome %}
  {% set pageDesc = site.description %}
  {% else %}
  {% set pageDesc = site.description %}
  {% endif %}
  {% endif %}

  {% set socialImage = ogImage or image or site.ogImage %}
  {% if socialImage and not socialImage.startsWith('http') %}
  {% set socialImageUrl = site.url ~ socialImage %}
  {% else %}
  {% set socialImageUrl = socialImage %}
  {% endif %}

  <title>{% if isHome %}{{ site.title }} :: Home{% elif displayTitle and displayTitle != site.title %}{{ displayTitle }}{% if pagination.pageNumber and pagination.pageNumber > 0 %} (Page {{ pagination.pageNumber + 1 }}){% endif %} :: {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>

  {# Primary Search Engine Meta Tags #}
  <meta name="description" content="{{ pageDesc | escape }}" />
  <meta name="keywords" content="{{ site.keywords | escape }}" />
  <meta name="author" content="{{ author or site.name }}" />
  {% if isDraft or noindex %}
  <meta name="robots" content="noindex, nofollow" />
  <meta name="googlebot" content="noindex, nofollow" />
  <meta name="bingbot" content="noindex, nofollow" />
  {% else %}
  <meta name="robots"
    content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="bingbot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <link rel="canonical" href="{{ canonicalUrl }}" />
  {% endif %}
  <meta name="generator" content="Eleventy" />
  <meta name="theme-color" content="#164b70" />
  <meta name="msapplication-TileColor" content="#164b70" />
  <meta name="msapplication-TileImage" content="/favicon-192.png?v=2" />
  <meta name="application-name" content="{{ site.title }}" />
  <meta name="color-scheme" content="light" />

  {# Open Graph / Social Media Meta Tags #}
  <meta property="og:site_name" content="{{ site.title }}" />
  <meta property="og:type" content="{{ 'article' if isPost else 'website' }}" />
  <meta property="og:title" content="{% if isHome %}{{ site.title }} :: Home{% else %}{{ displayTitle }}{% endif %}" />
  <meta property="og:description" content="{{ pageDesc | escape }}" />
  {% if not noindex %}
  <meta property="og:url" content="{{ canonicalUrl }}" />
  {% endif %}
  <meta property="og:image" content="{{ socialImageUrl }}" />
  <meta property="og:image:secure_url" content="{{ socialImageUrl }}" />
  <meta property="og:image:alt" content="{{ displayTitle }}" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:locale" content="en_US" />
  {% if isPost %}
  {% if date %}
  <meta property="article:published_time" content="{{ date | isoDate }}" />{% endif %}
  {% if updated %}
  <meta property="article:modified_time" content="{{ updated | isoDate }}" />{% endif %}
  <meta property="article:author" content="{{ author or site.name }}" />
  {% set postTopics = topics or tags %}
  {% if postTopics %}
  {% for tag in postTopics %}
  {% if tag != "blog" and tag != "post" %}
  <meta property="article:tag" content="{{ tag }}" />{% endif %}
  {% endfor %}
  {% endif %}
  {% endif %}

  {# Twitter / X Card Meta Tags #}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="{{ site.twitter }}" />
  <meta name="twitter:creator" content="{{ site.twitter }}" />
  <meta name="twitter:title" content="{% if isHome %}{{ site.title }} :: Home{% else %}{{ displayTitle }}{% endif %}" />
  <meta name="twitter:description" content="{{ pageDesc | escape }}" />
  <meta name="twitter:image" content="{{ socialImageUrl }}" />
  <meta name="twitter:image:alt" content="{{ displayTitle }}" />

  {# JSON-LD Structured Data Schema (Bing & Google compliant) #}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "{{ site.url }}/#website",
        "url": "{{ site.url }}/",
        "name": {{ site.title | dump | safe }},
        "alternateName": {{ (site.handle or "ShadowAmitendu") | dump | safe }},
        "description": {{ site.description | dump | safe }},
        "inLanguage": "en-US",
        "publisher": {
          "@id": "{{ site.url }}/#person"
        }
      },
      {
        "@type": "Person",
        "@id": "{{ site.url }}/#person",
        "name": {{ site.name | dump | safe }},
        "alternateName": {{ (site.handle or "ShadowAmitendu") | dump | safe }},
        "url": "{{ site.url }}/",
        "image": "{{ site.url }}{{ site.author.avatar }}",
        "jobTitle": {{ site.author.role | dump | safe }},
        "description": {{ site.description | dump | safe }},
        "knowsAbout": ["Web Development", "React", "Java", "Spring Boot", "JavaScript", "UI/UX Design", "Full Stack Development"],
        "alumniOf": {
          "@type": "EducationalOrganization",
          "name": "Techno India Hooghly"
        },
        "email": "mailto:{{ site.email }}",
        "sameAs": [
          "https://github.com/ShadowAmitendu",
          "https://www.youtube.com/@ShadowAmitendu",
          "https://x.com/shadow_amitendu",
          "https://www.linkedin.com/in/amitendu/",
          "https://peerlist.io/amitendu"
        ]
      }
      {% if not isHome and not noindex %},
      {
        "@type": "BreadcrumbList",
        "@id": "{{ canonicalUrl }}#breadcrumb",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "{{ site.url }}/"
          }
          {% if isBlog and (isPost or (tags and 'blog' in tags and page.url != '/blog/')) %},
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Blog",
            "item": "{{ site.url }}/blog/"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": {{ title | dump | safe }},
            "item": "{{ canonicalUrl }}"
          }
          {% elif isPortfolio and tags and 'portfolio' in tags and page.url != '/portfolio/' %},
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Portfolio",
            "item": "{{ site.url }}/portfolio/"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": {{ title | dump | safe }},
            "item": "{{ canonicalUrl }}"
          }
          {% elif isAbout and page.url != '/about/' %},
          {
            "@type": "ListItem",
            "position": 2,
            "name": "About",
            "item": "{{ site.url }}/about/"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": {{ (aboutTab or title) | dump | safe }},
            "item": "{{ canonicalUrl }}"
          }
          {% else %},
          {
            "@type": "ListItem",
            "position": 2,
            "name": {{ (displayTitle or title) | dump | safe }},
            "item": "{{ canonicalUrl }}"
          }
          {% endif %}
        ]
      }
      {% endif %}
      {% if isPost %},
      {
        "@type": "BlogPosting",
        "@id": "{{ canonicalUrl }}#article",
        "mainEntityOfPage": "{{ canonicalUrl }}",
        "headline": {{ title | dump | safe }},
        "description": {{ pageDesc | dump | safe }},
        "url": "{{ canonicalUrl }}",
        {% if date %}"datePublished": "{{ date | isoDate }}",{% endif %}
        "dateModified": "{{ (dateModified or date or buildDate) | isoDate }}",
        "author": {
          "@type": "Person",
          "name": {{ (author or site.name) | dump | safe }},
          "url": "{{ site.url }}/"
        },
        "publisher": {
          "@id": "{{ site.url }}/#person"
        },
        "image": "{{ socialImageUrl }}",
        "inLanguage": "en-US"
      }
      {% endif %}
    ]
  }
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Bebas+Neue&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/assets/styles.css?v=20261015b" />
  <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
  <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png?v=2" />
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png?v=2" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png?v=2" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
  <link rel="manifest" href="/site.webmanifest?v=2" />
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>

<body class="site-body min-h-screen px-4 py-10 font-['Barlow_Condensed',sans-serif] text-[#222]">
  <main class="site-shell mx-auto max-w-6xl p-1">
    {% include "components/announcement.njk" %}

    {% include "components/header.njk" %}

    {% include "components/nav.njk" %}
    <div class="site-columns">
      {% include "components/sidebar-left.njk" %}
      <section class="site-content px-5 py-6 text-sm leading-6">
        {% set isProject = isPortfolio and (page.url != '/portfolio/' and not ('/portfolio/page/' in page.url)) %}
        {% if isProject %}
        <article class="site-project-entry">
          {% set typeLabels = {
            "desktop": "Desktop app",
            "android": "Android app",
            "web": "Web app",
            "tool": "Tool / Script",
            "academic": "Academic / College"
          } %}
          {% set statusLabels = {
            "in-progress": "In progress",
            "completed": "Completed",
            "maintained": "Maintained",
            "archived": "Archived",
            "concept": "Concept"
          } %}
          <div class="site-card border border-[#9bb0be] bg-white p-0 shadow-[2px_2px_0_#cad6de] mb-5">
            <div class="border-b border-[#c6d7e0] bg-linear-to-b from-[#f8fbfc] to-[#dce8ee] px-3.5 py-2 flex flex-wrap items-center justify-between gap-2 text-xs shadow-[inset_0_1px_0_#fff]">
              <div class="flex flex-wrap items-center gap-1.5">
                <span class="inline-block bg-[#164b70] text-white text-[9px] font-bold px-1.5 py-0.5 tracking-wider uppercase select-none">PROJECT</span>
                {% if draft %}
                <span class="inline-block bg-[#d97706] text-white text-[9px] font-bold px-1.5 py-0.5 tracking-wider uppercase select-none">DRAFT</span>
                {% endif %}
                {% if projectType %}
                <span class="site-badge border border-[#7398b0] bg-[#e8f3f8] px-1.5 py-0.5 text-[10px] font-bold text-[#164b70]">
                  {{ typeLabels[projectType] or projectType }}
                </span>
                {% endif %}
                {% if projectStatus %}
                <span class="site-badge border border-[#7892a3] bg-white px-1.5 py-0.5 text-[10px] font-bold {% if projectStatus == 'completed' %}text-[#2e7d32]{% else %}text-[#556b78]{% endif %}">
                  {{ statusLabels[projectStatus] or projectStatus }}
                </span>
                {% endif %}
              </div>
              <div class="text-[11px] text-[#556b78]">
                {% if date %}<time datetime="{{ date }}">{{ date | shortDate }}</time>{% endif %}
                {% if duration %} · <span>{{ duration }}</span>{% endif %}
              </div>
            </div>

            <div class="p-4 sm:p-5">
              <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[#164b70] uppercase leading-tight m-0">
                {{ title }}
              </h2>
              {% if description %}
              <p class="mt-2 text-xs sm:text-sm text-[#3b4d57] leading-relaxed italic border-l-2 border-[#164b70] pl-2.5">
                {{ description }}
              </p>
              {% endif %}

              {% if (platforms and platforms.length > 0) or role or context %}
              <div class="mt-4 pt-3 border-t border-[#e1ebf0] grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
                {% if platforms and platforms.length > 0 %}
                <div>
                  <span class="font-bold text-[#164b70]">Platforms:</span>
                  <div class="inline-flex flex-wrap gap-1 ml-1.5">
                    {% for p in platforms %}
                    <span class="site-badge border border-[#9bb0be] bg-[#edf4f8] px-1.5 py-0.5 text-[10px] text-[#164b70]">{{ p }}</span>
                    {% endfor %}
                  </div>
                </div>
                {% endif %}
                {% if role %}
                <div>
                  <span class="font-bold text-[#164b70]">Role:</span>
                  <span class="text-[#3b4d57] ml-1">{{ role }}</span>
                </div>
                {% endif %}
                {% if context %}
                <div>
                  <span class="font-bold text-[#164b70]">Context:</span>
                  <span class="text-[#3b4d57] ml-1">{{ context }}</span>
                </div>
                {% endif %}
              </div>
              {% endif %}

              {% if stack and stack.length > 0 %}
              <div class="mt-4 pt-3 border-t border-[#e1ebf0]">
                <span class="font-bold text-xs text-[#164b70] block mb-1.5 uppercase tracking-wide">Tech Stack:</span>
                <div class="flex flex-wrap gap-1.5">
                  {% for tech in stack %}
                  <span class="site-badge border border-[#7892a3] bg-white px-2 py-0.5 text-xs font-semibold text-[#164b70] shadow-[1px_1px_0_#cad6de]">
                    {{ tech }}
                  </span>
                  {% endfor %}
                </div>
              </div>
              {% endif %}

              {% if highlights and highlights.length > 0 %}
              <div class="mt-4 pt-3 border-t border-[#e1ebf0]">
                <span class="font-bold text-xs text-[#164b70] block mb-1.5 uppercase tracking-wide">Key Highlights:</span>
                <ul class="list-disc list-inside space-y-1 text-xs text-[#26343d] leading-relaxed">
                  {% for hl in highlights %}
                  <li>{{ hl }}</li>
                  {% endfor %}
                </ul>
              </div>
              {% endif %}

              {% if links and links.length > 0 %}
              <div class="mt-4 pt-3 border-t border-[#e1ebf0] flex flex-wrap gap-2">
                {% for l in links %}
                {% if l.url %}
                <a class="site-button-2007 inline-flex items-center gap-1.5 px-3 py-1 text-xs font-bold" href="{{ l.url }}" target="_blank" rel="noopener noreferrer">
                  <span>{{ l.label or "Visit Project" }}</span>
                  <span class="text-[10px]">↗</span>
                </a>
                {% endif %}
                {% endfor %}
              </div>
              {% endif %}
            </div>
          </div>

          {% if image and not hideHeroImage %}
          <div class="site-card border border-[#9bb0be] bg-white p-1 shadow-[2px_2px_0_#cad6de] mb-5">
            <a class="site-lightbox-trigger block cursor-zoom-in" href="{{ image }}" data-lightbox="true" data-caption="{{ imageAlt or title }}" title="{{ imageAlt or title }}">
              <img class="block w-full h-auto max-h-125 object-contain mx-auto" src="{{ image }}" alt="{{ imageAlt or title }}" />
            </a>
          </div>
          {% endif %}

          {% if gallery and gallery.length > 0 %}
          <div class="mb-6">
            <h3 class="border-b border-[#b7cbd6] pb-1 text-sm font-bold text-[#164b70] uppercase tracking-wide mb-3">
              Screenshots & Gallery
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {% for shot in gallery %}
              {% if shot.image %}
              <figure class="site-card border border-[#9bb0be] bg-white p-1.5 shadow-[2px_2px_0_#cad6de] m-0 flex flex-col justify-between">
                <a class="site-lightbox-trigger block cursor-zoom-in" href="{{ shot.image }}" data-lightbox="true" data-caption="{{ shot.caption or shot.alt or title }}" title="{{ shot.caption or shot.alt or title }}">
                  <img class="w-full h-44 object-cover sm:object-contain bg-[#0a1926]" src="{{ shot.image }}" alt="{{ shot.alt or title }}" loading="lazy" />
                </a>
                {% if shot.caption %}
                <figcaption class="mt-1.5 text-center text-xs italic text-[#556b78] border-t border-dashed border-[#b7cbd6] pt-1">
                  {{ shot.caption }}
                </figcaption>
                {% endif %}
              </figure>
              {% endif %}
              {% endfor %}
            </div>
          </div>
          {% endif %}

          <div class="site-entry-body mt-4 text-sm leading-relaxed text-[#26343d]">
            {{ content | safe }}
          </div>

          <div class="mt-6 pt-3 border-t border-dashed border-[#b7cbd6]">
            <a class="text-[#064f83] underline hover:text-[#c0392b] text-xs font-semibold" href="/portfolio/">← Back to all projects</a>
          </div>
        </article>
        {% else %}
        {% if draft and not isPost %}
        <div
          class="mb-4 border border-dashed border-[#d97706] bg-[#fffbeb] px-3.5 py-2 text-xs font-bold text-[#b45309]">
          DRAFT - This project is saved as a draft and is hidden from public listings.
        </div>
        {% endif %}
        {% if image and not isPost and not hideHeroImage %}<img
          class="site-full-image mb-4 h-auto max-h-none w-full object-contain" src="{{ image }}"
          alt="{{ imageAlt or title }}" />{% endif %}
        {% if author and not isPost %}
        <div class="mb-4 flex items-center gap-2 text-xs text-[#71828b]">
          {% if authorImage %}<img class="h-7 w-7 object-cover" src="{{ authorImage }}" alt="{{ author }}" />{% endif %}
          <span>by {{ author }}</span>
        </div>
        {% endif %}
        {{ content | safe }}
        {% endif %}
      </section>
      {% include "components/sidebar-right.njk" %}
    </div>
    {% include "components/footer.njk" %}
  </main>
  <script>
    if ( window.netlifyIdentity )
    {
      window.netlifyIdentity.on( "init", ( user ) =>
      {
        if ( !user )
        {
          window.netlifyIdentity.on( "login", () =>
          {
            document.location.href = "/admin/";
          } );
        }
      } );
    }
  </script>
  <script>
    ( function ()
    {
      function openExternalLinksInNewTab ()
      {
        var links = document.querySelectorAll( 'a[href]' );
        for ( var i = 0; i < links.length; i++ )
        {
          var a = links[ i ];
          var href = a.getAttribute( 'href' );
          if ( !href || href.charAt( 0 ) === '#' || href.indexOf( 'javascript:' ) === 0 ) continue;
          var isInternal = (
            href.charAt( 0 ) === '/' ||
            href.indexOf( './' ) === 0 ||
            href.indexOf( '../' ) === 0 ||
            a.hostname === window.location.hostname
          );
          if ( !isInternal )
          {
            a.setAttribute( 'target', '_blank' );
            a.setAttribute( 'rel', 'noopener noreferrer' );
          }
        }
      }
      if ( document.readyState === 'loading' )
      {
        document.addEventListener( 'DOMContentLoaded', openExternalLinksInNewTab );
      } else
      {
        openExternalLinksInNewTab();
      }
      document.addEventListener( 'click', function ( e )
      {
        var a = e.target && e.target.closest ? e.target.closest( 'a[href]' ) : null;
        if ( !a ) return;
        var href = a.getAttribute( 'href' );
        if ( !href || href.charAt( 0 ) === '#' || href.indexOf( 'javascript:' ) === 0 ) return;
        var isInternal = (
          href.charAt( 0 ) === '/' ||
          href.indexOf( './' ) === 0 ||
          href.indexOf( '../' ) === 0 ||
          a.hostname === window.location.hostname
        );
        if ( !isInternal )
        {
          a.setAttribute( 'target', '_blank' );
          a.setAttribute( 'rel', 'noopener noreferrer' );
        }
      } );
    } )();
  </script>

  {# Modern fluid smooth scrolling using Lenis #}
  <script src="https://unpkg.com/lenis@1.1.18/dist/lenis.min.js"></script>
  <script>
    ( function ()
    {
      if ( typeof Lenis === 'undefined' ) return;
      // Respect accessibility preferences for reduced motion
      var prefersReducedMotion = window.matchMedia && window.matchMedia( '(prefers-reduced-motion: reduce)' ).matches;
      if ( prefersReducedMotion ) return;

      var lenis = new Lenis( {
        duration: 1.2,
        easing: function ( t ) { return Math.min( 1, 1.001 - Math.pow( 2, -10 * t ) ); },
        orientation: 'vertical',
        gestureOrientation: 'vertical',
        smoothWheel: true,
        wheelMultiplier: 1,
        touchMultiplier: 2,
        infinite: false
      } );

      function raf ( time )
      {
        lenis.raf( time );
        requestAnimationFrame( raf );
      }
      requestAnimationFrame( raf );

      // Smooth scroll for anchor links
      document.querySelectorAll( 'a[href^="#"]' ).forEach( function ( anchor )
      {
        anchor.addEventListener( 'click', function ( e )
        {
          var targetId = this.getAttribute( 'href' );
          if ( targetId && targetId.length > 1 )
          {
            var targetEl = document.querySelector( targetId );
            if ( targetEl )
            {
              e.preventDefault();
              lenis.scrollTo( targetEl, { offset: -20 } );
            }
          }
        } );
      } );
    } )();
  </script>

