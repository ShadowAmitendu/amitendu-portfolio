---
layout: base.njk
isPost: true
---
{% set isDraft = draft or (tags and ('draft' in tags or tags == 'draft')) %}
<article class="site-entry">
  {# 2005-era Weblog Entry Hero & Header Bar (Merged) #}
  <header
    class="site-entry-header border border-[#b2c2cc] bg-white shadow-[2px_2px_0_#cad6de] overflow-hidden">
    {# 1. Entry date & written by: name #}
    <div
      class="border-b border-[#c6d7e0] bg-gradient-to-b from-[#f8fbfc] to-[#dce8ee] px-3.5 py-2 flex flex-wrap items-center justify-between gap-2 text-[13px] sm:text-[14px] text-[#536a75] shadow-[inset_0_1px_0_#fff]">
      <div class="flex items-center gap-2">
        <span
          class="inline-block bg-[#164b70] px-1.5 py-0.5 text-[9px] font-bold tracking-wider text-white uppercase select-none">ENTRY</span>
        {% if isDraft %}<span
          class="inline-block bg-[#d97706] px-1.5 py-0.5 text-[9px] font-bold tracking-wider text-white uppercase select-none">DRAFT</span>{% endif %}
        <time class="font-bold text-[#164b70]" datetime="{{ date }}">{{ date | shortDate }}</time>
      </div>
      <div class="text-[13px] sm:text-[14px]">
        {% if author %}written by: <span class="font-bold text-[#164b70]">{{ author }}</span>{% endif %}
      </div>
    </div>

    {# 2. Image with Title Overlaid #}
    {% if image %}
    <div class="site-entry-hero relative bg-[#0a1926] border-b border-[#c6d7e0] overflow-hidden group">
      <img class="block w-full h-auto max-h-[540px] object-cover sm:object-contain mx-auto cursor-zoom-in"
        src="{{ image }}" alt="{{ title }}" />
      <div
        class="site-entry-hero-overlay absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#0a1f2e] from-55% via-[#0a1f2e]/85 to-transparent pt-16 pb-3.5 px-4 sm:px-5 pointer-events-none">
        <h1
          class="site-entry-title text-white font-bold tracking-tight text-xl sm:text-2xl md:text-3xl leading-tight uppercase drop-shadow-[0_2px_4px_rgba(0,0,0,0.95)] m-0 pointer-events-auto select-text"
          style="color: #ffffff !important;">
          {{ title }}
        </h1>
      </div>
    </div>
    {% else %}
    <div class="p-3.5 sm:p-4 bg-gradient-to-b from-[#ffffff] to-[#edf4f8] border-b border-[#c6d7e0]">
      <h1 class="site-entry-title font-bold tracking-tight text-[#22608a] text-xl sm:text-2xl md:text-3xl leading-tight uppercase m-0">
        {{ title }}
      </h1>
    </div>
    {% endif %}

    {# 3. Description then after #}
    {% if description %}
    <div class="site-entry-desc p-3.5 bg-[#f8fbfc] text-xs sm:text-sm text-[#3b4d57] leading-relaxed italic border-t border-[#edf3f6]">
      {{ description }}
    </div>
    {% endif %}
  </header>

  {% if isDraft %}
  <div class="my-3 border border-dashed border-[#d97706] bg-[#fffbeb] px-3.5 py-2 text-xs font-bold text-[#b45309]">
    DRAFT - This post is saved as a draft and is hidden from public blog listings.
  </div>
  {% endif %}

  {# Entry Body Content #}
  <div class="site-entry-body mt-4 text-sm leading-relaxed text-[#26343d]">
    {{ content | safe }}
  </div>

  {# Mood & Music Box (Optional) #}
  {% if mood or music %}
  <div
    class="site-entry-status mt-6 border border-[#b2c2cc] bg-[#edf4f7] px-3.5 py-2 text-xs text-[#536a75] shadow-[inset_0_1px_0_#fff]">
    <div class="flex flex-wrap items-center justify-between gap-2">
      {% if mood %}
      <div class="flex items-center gap-2">
        <span class="font-bold text-[#164b70]">Mood:</span>
        <span>{{ mood }}</span>
      </div>
      {% endif %}
      {% if music %}
      <div class="flex items-center gap-2">
        <span class="font-bold text-[#164b70]">Music:</span>
        <span class="italic">{{ music }}</span>
      </div>
      {% endif %}
    </div>
  </div>
  {% endif %}

  {# Entry Footer: Tags & Classic Actions #}
  <footer class="site-entry-footer mt-4 border-t border-dashed border-[#b7cbd6] pt-3 text-xs text-[#71828b]">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap items-center gap-1.5">
        <span class="font-bold text-[#164b70]">Filed under:</span>
        {% for tag in tags %}
        {% if tag != "blog" %}
        <span
          class="site-badge border border-[#7398b0] bg-[#e8f3f8] px-1.5 py-0.5 text-[10px] text-[#164b70]">{{ tag }}</span>
        {% endif %}
        {% endfor %}
      </div>
      <div class="flex items-center gap-2 text-[14px]">
        <span class="site-comment-link inline-block">
          <script>
            var idcomments_acct = 'b7e853c21b4a75847089752f6a167758';
            var idcomments_post_id = '{{ page.fileSlug | safeId }}';
            var idcomments_post_url;
          </script>
          <script type="text/javascript" src="https://www.intensedebate.com/js/genericLinkWrapperV2.js"></script>
        </span>
        <span>·</span>
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="{{ permalink or page.url }}">permalink</a>
        <span>·</span>
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="#top">top</a>
      </div>
    </div>
  </footer>

  {# IntenseDebate Comments Section #}
  <section id="comments" class="site-comments mt-8 p-4">
    <h3
      class="border-b border-[#b7cbd6] pb-1 text-base font-bold text-[#164b70]">
      Comments</h3>
    <div class="mt-3">
      <script>
        var idcomments_acct = 'b7e853c21b4a75847089752f6a167758';
        var idcomments_post_id = '{{ page.fileSlug | safeId }}';
        var idcomments_post_url;
      </script>
      <span id="IDCommentsPostTitle" style="display:none">{{ title }}</span>
      <script type='text/javascript' src='https://www.intensedebate.com/js/genericCommentWrapperV2.js'></script>
      <noscript>
        <p class="mt-2 text-xs text-[#71828b]">Please enable JavaScript to view comments powered by IntenseDebate.</p>
      </noscript>
    </div>
  </section>

  {# Bottom Navigation #}
  <nav class="mt-6 border-t border-[#b7cbd6] pt-4 text-xs">
    <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/blog/">« Return to Web Log Index</a>
  </nav>
</article>
