})(); /*-->*/
      </script>
      <script type="text/javascript">
      (function() {
        function formatReplyMentions() {
          var container = document.getElementById("HCB_comment_box");
          if (!container) return;

          var commentBodies = container.querySelectorAll(".hcb-comment-body:not([data-reply-styled])");
          if (!commentBodies.length) return;

          var leadingReplyRegex = /^\s*@([A-Za-z0-9_.\s-]+?)(?:,\s*|:\s*|\s*-\s*|\s*\n\s*)/;
          var replyIconSvg = '<svg class="hcb-reply-icon" width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M1.5 1.5A.5.5 0 0 0 1 2v4.5A2.5 2.5 0 0 0 3.5 9h8.793l-2.147 2.146a.5.5 0 0 0 .708.708l3-3a.5.5 0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L12.293 8H3.5A1.5 1.5 0 0 1 2 6.5V2a.5.5 0 0 0-.5-.5z"/></svg>';

          commentBodies.forEach(function(body) {
            body.setAttribute("data-reply-styled", "true");
            var rawHtml = body.innerHTML;
            var match = rawHtml.match(leadingReplyRegex);

            var replyHeader = "";
            var content = rawHtml;

            if (match) {
              var targetName = match[1].trim();
              content = rawHtml.slice(match[0].length).trim();
              replyHeader = '<div class="hcb-reply-context"><div class="hcb-reply-bar">' +
                replyIconSvg +
                '<span class="hcb-reply-label">Replying to</span>' +
                '<span class="hcb-reply-pill">@' + targetName + '</span>' +
                '</div></div>';
            }

            // Also format any remaining inline @mentions (e.g., @Name or @Username)
            content = content.replace(/(^|\s)@([a-zA-Z0-9_.-]+)(?=[,\s.:!?]|$)/g, '$1<span class="hcb-mention-pill">@$2</span>');

            body.innerHTML = replyHeader + '<div class="hcb-comment-content">' + content + '</div>';
          });
        }

        var container = document.getElementById("HCB_comment_box");
        if (container) {
          var observer = new MutationObserver(function() {
            formatReplyMentions();
          });
          observer.observe(container, { childList: true, subtree: true });
          formatReplyMentions();
          window.addEventListener("load", formatReplyMentions);
          setTimeout(formatReplyMentions, 300);
          setTimeout(formatReplyMentions, 800);
          setTimeout(formatReplyMentions, 1600);
          setTimeout(formatReplyMentions, 3000);
        }
      })();
      </script>
      <!-- end www.htmlcommentbox.com -->
    </div>
  </section>

  {# Bottom Navigation #}
  <nav class="mt-6 border-t border-[#b7cbd6] pt-4 text-xs">
    <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/blog/"
    >« Return to Web Log Index</a>
  </nav>
</article>
