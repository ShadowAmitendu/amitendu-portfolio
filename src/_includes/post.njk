---
layout: base.njk
isPost: true
---
{% set isDraft = draft or (tags and ('draft' in tags or tags == 'draft')) %}
<article class="site-entry">
  {# 2005-era Weblog Entry Hero & Header Bar (Merged) #}
  <header
    class="site-entry-header border border-[#b2c2cc] bg-white shadow-[2px_2px_0_#cad6de] overflow-hidden">
    {# 1. Entry date & written by: name #}
    <div
      class="border-b border-[#c6d7e0] bg-gradient-to-b from-[#f8fbfc] to-[#dce8ee] px-3.5 py-2 flex flex-wrap items-center justify-between gap-2 text-[13px] sm:text-[14px] text-[#536a75] shadow-[inset_0_1px_0_#fff]">
      <div class="flex items-center gap-2">
        <span
          class="inline-block bg-[#164b70] px-1.5 py-0.5 text-[9px] font-bold tracking-wider text-white uppercase select-none">ENTRY</span>
        {% if isDraft %}<span
          class="inline-block bg-[#d97706] px-1.5 py-0.5 text-[9px] font-bold tracking-wider text-white uppercase select-none">DRAFT</span>{% endif %}
        <time class="font-bold text-[#164b70]" datetime="{{ date }}">{{ date | shortDate }}</time>
      </div>
      <div class="text-[13px] sm:text-[14px]">
        {% if author %}written by: <span class="font-bold text-[#164b70]">{{ author }}</span>{% endif %}
      </div>
    </div>

    {# 2. Image with Title Overlaid #}
    {% if image %}
    <div class="site-entry-hero relative bg-[#0a1926] border-b border-[#c6d7e0] overflow-hidden group">
      <img class="block w-full h-auto max-h-[540px] object-cover sm:object-contain mx-auto cursor-zoom-in"
        src="{{ image }}" alt="{{ title }}" />
      <div
        class="site-entry-hero-overlay absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#0a1f2e] from-55% via-[#0a1f2e]/85 to-transparent pt-16 pb-3.5 px-4 sm:px-5 pointer-events-none">
        <h1
          class="site-entry-title text-white font-bold tracking-tight text-xl sm:text-2xl md:text-3xl leading-tight uppercase drop-shadow-[0_2px_4px_rgba(0,0,0,0.95)] m-0 pointer-events-auto select-text"
          style="color: #ffffff !important;">
          {{ title }}
        </h1>
      </div>
    </div>
    {% else %}
    <div class="p-3.5 sm:p-4 bg-gradient-to-b from-[#ffffff] to-[#edf4f8] border-b border-[#c6d7e0]">
      <h1 class="site-entry-title font-bold tracking-tight text-[#22608a] text-xl sm:text-2xl md:text-3xl leading-tight uppercase m-0">
        {{ title }}
      </h1>
    </div>
    {% endif %}

    {# 3. Description then after #}
    {% if description %}
    <div class="site-entry-desc p-3.5 bg-[#f8fbfc] text-xs sm:text-sm text-[#3b4d57] leading-relaxed italic border-t border-[#edf3f6]">
      {{ description }}
    </div>
    {% endif %}
  </header>

  {% if isDraft %}
  <div class="my-3 border border-dashed border-[#d97706] bg-[#fffbeb] px-3.5 py-2 text-xs font-bold text-[#b45309]">
    DRAFT - This post is saved as a draft and is hidden from public blog listings.
  </div>
  {% endif %}

  {# Entry Body Content #}
  <div class="site-entry-body mt-4 text-sm leading-relaxed text-[#26343d]">
    {{ content | safe }}
  </div>

  {# Mood & Music Box (Optional) #}
  {% if mood or music %}
  <div
    class="site-entry-status mt-6 border border-[#b2c2cc] bg-[#edf4f7] px-3.5 py-2 text-xs text-[#536a75] shadow-[inset_0_1px_0_#fff]">
    <div class="flex flex-wrap items-center justify-between gap-2">
      {% if mood %}
      <div class="flex items-center gap-2">
        <span class="font-bold text-[#164b70]">Mood:</span>
        <span>{{ mood }}</span>
      </div>
      {% endif %}
      {% if music %}
      <div class="flex items-center gap-2">
        <span class="font-bold text-[#164b70]">Music:</span>
        <span class="italic">{{ music }}</span>
      </div>
      {% endif %}
    </div>
  </div>
  {% endif %}

  {# Entry Footer: Tags & Classic Actions #}
  <footer class="site-entry-footer mt-4 border-t border-dashed border-[#b7cbd6] pt-3 text-xs text-[#71828b]">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap items-center gap-1.5">
        <span class="font-bold text-[#164b70]">Filed under:</span>
        {% for tag in tags %}
        {% if tag != "blog" %}
        <span
          class="site-badge border border-[#7398b0] bg-[#e8f3f8] px-1.5 py-0.5 text-[10px] text-[#164b70]">{{ tag }}</span>
        {% endif %}
        {% endfor %}
      </div>
      {% set postCommentsList = (comments | getComments(page.fileSlug, page.filePathStem)) or postComments or [] %}
      <div class="flex items-center gap-2 text-[14px]">
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="#comments">comments ({{ postCommentsList.length }})</a>
        <span>·</span>
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="{{ permalink or page.url }}">permalink</a>
        <span>·</span>
        <a class="text-[#064f83] underline hover:text-[#c0392b]" href="#top">top</a>
      </div>
    </div>
  </footer>

  {# Comments Section #}
  <section id="comments" class="site-comments mt-8 p-4">
    <div class="border-b border-[#b7cbd6] pb-1.5 flex items-baseline justify-between gap-2">
      <h3 class="text-base font-bold text-[#164b70]">
        Comments ({{ postCommentsList.length }})
      </h3>
      <a class="text-xs text-[#064f83] underline hover:text-[#c0392b]" href="#postAComment">Leave a comment »</a>
    </div>

    {# Display Approved Comments #}
    {% if postCommentsList.length > 0 %}
    <div class="mt-4 space-y-3">
      {% for item in postCommentsList %}
      <div class="site-comment-item border border-[#c6d7e0] bg-white p-3 shadow-[1px_1px_0_#cad6de]">
        <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-[#edf3f6] pb-1 text-xs">
          <div class="flex items-baseline gap-1.5">
            <span class="font-bold text-[#556b78] select-none">#{{ loop.index }}</span>
            <span class="font-bold text-[#164b70]">{{ item.name }}</span>
          </div>
          {% if item.date %}
          <time class="text-[#71828b] text-[11px]">{{ item.date | shortDate }}</time>
          {% endif %}
        </div>
        <div class="mt-2 text-xs leading-relaxed text-[#26343d] whitespace-pre-line">
          {{ item.message }}
        </div>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <div class="mt-3 py-2 text-xs text-[#71828b] italic">
      No comments posted yet. Be the first to leave a comment!
    </div>
    {% endif %}

    {# Post-a-Comment Form #}
    <div id="postAComment" class="mt-6 pt-4 border-t border-[#b7cbd6]">
      <h4 class="text-sm font-bold text-[#164b70] mb-3">
        Leave a Comment
      </h4>
      <form
        name="blog-comments"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="retro-comment-form space-y-3"
        id="retroCommentForm"
      >
        <input type="hidden" name="form-name" value="blog-comments" />
        <input type="hidden" name="post-title" value="{{ title }}" />
        <input type="hidden" name="post-url" value="{{ permalink or page.url }}" />
        <input type="hidden" name="post-slug" value="{{ page.fileSlug }}" />
        
        {# Honeypot field for bot spam prevention #}
        <p class="hidden" style="display:none">
          <label>Don’t fill this out if you're human: <input name="bot-field" /></label>
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label for="comment-name" class="block text-xs font-bold text-[#164b70] mb-1">
              Name <span class="text-[#c0392b]">*</span>:
            </label>
            <input
              type="text"
              id="comment-name"
              name="name"
              required
              placeholder="Your name"
              class="w-full border border-[#7892a3] bg-white px-2.5 py-1.5 text-xs text-[#1e395b] shadow-[inset_1px_1px_2px_rgba(0,0,0,0.15)] focus:border-[#164b70] focus:outline-none"
            />
          </div>

          <div>
            <label for="comment-email" class="block text-xs font-bold text-[#164b70] mb-1">
              Email <span class="text-[10px] font-normal text-[#71828b]">(optional, not shown)</span>:
            </label>
            <input
              type="text"
              id="comment-email"
              name="contact"
              placeholder="your@email.com"
              class="w-full border border-[#7892a3] bg-white px-2.5 py-1.5 text-xs text-[#1e395b] shadow-[inset_1px_1px_2px_rgba(0,0,0,0.15)] focus:border-[#164b70] focus:outline-none"
            />
          </div>
        </div>

        <div>
          <label for="comment-message" class="block text-xs font-bold text-[#164b70] mb-1">
            Comment <span class="text-[#c0392b]">*</span>:
          </label>
          <textarea
            id="comment-message"
            name="message"
            rows="4"
            required
            placeholder="Write your comment here..."
            class="w-full border border-[#7892a3] bg-white p-2.5 text-xs text-[#1e395b] shadow-[inset_1px_1px_2px_rgba(0,0,0,0.15)] focus:border-[#164b70] focus:outline-none font-sans"
          ></textarea>
        </div>

        {# Security Code / Anti-Spam #}
        <div class="border border-[#c6d7e0] bg-[#f4f8fa] p-2.5 shadow-[inset_0_1px_0_#fff]">
          <label for="comment-captcha" class="block text-xs font-bold text-[#164b70] mb-1.5">
            Security code <span class="text-[#c0392b]">*</span>:
          </label>

          <div class="flex flex-wrap items-center gap-2">
            <div class="flex items-center border border-[#7892a3] bg-gradient-to-b from-[#ffffff] to-[#e4eef2] px-3 py-1 shadow-[inset_1px_1px_2px_rgba(0,0,0,0.08)]">
              <span id="captchaQuestion" class="font-mono text-sm font-bold text-[#164b70] select-none tracking-wider">
                <!-- e.g. 5 + 3 = ? -->
              </span>
            </div>
            <button
              type="button"
              id="refreshCaptchaBtn"
              class="text-xs text-[#064f83] underline hover:text-[#c0392b] cursor-pointer"
              title="Generate a new question"
            >
              [Refresh]
            </button>
            <div class="flex items-center gap-1.5">
              <span class="text-xs font-bold text-[#556b78]">=</span>
              <input
                type="text"
                id="comment-captcha"
                name="captcha-answer"
                required
                autocomplete="off"
                placeholder="Answer"
                class="w-20 border border-[#7892a3] bg-white px-2 py-1 text-xs text-[#1e395b] shadow-[inset_1px_1px_2px_rgba(0,0,0,0.15)] focus:border-[#164b70] focus:outline-none"
              />
            </div>
          </div>
          <p id="captchaError" class="hidden mt-1 text-[11px] font-bold text-[#c0392b]">
            Incorrect code. Please try again.
          </p>
        </div>

        {# Netlify native reCAPTCHA container for server-side verification #}
        <div data-netlify-recaptcha="true"></div>

        <div class="pt-1">
          <button
            type="submit"
            id="commentSubmitBtn"
            class="border border-[#14486d] bg-gradient-to-b from-[#2a6b98] to-[#164b70] px-4 py-1.5 text-xs font-bold text-white shadow-[1px_1px_0_#0c2e47] hover:from-[#357ea7] hover:to-[#1b5680] active:translate-x-[1px] active:translate-y-[1px] active:shadow-none cursor-pointer"
          >
            Post Comment
          </button>
        </div>

        {# Confirmation Message #}
        <div id="commentStatus" class="hidden mt-3 border border-[#48bb78] bg-[#f0fff4] p-3 text-xs text-[#22543d] shadow-[inset_0_1px_0_#fff]">
          <p class="font-bold text-xs text-[#22543d]">
            Your comment has been submitted. Thank you.
          </p>
        </div>
      </form>
    </div>

    <script>
      (function() {
        var form = document.getElementById('retroCommentForm');
        var status = document.getElementById('commentStatus');
        var submitBtn = document.getElementById('commentSubmitBtn');
        var captchaQuestionEl = document.getElementById('captchaQuestion');
        var captchaInput = document.getElementById('comment-captcha');
        var captchaError = document.getElementById('captchaError');
        var refreshBtn = document.getElementById('refreshCaptchaBtn');
        if (!form || !status) return;

        var currentCaptchaSum = 0;

        function generateCaptcha() {
          var a = Math.floor(Math.random() * 8) + 2;
          var b = Math.floor(Math.random() * 8) + 1;
          currentCaptchaSum = a + b;
          if (captchaQuestionEl) {
            captchaQuestionEl.textContent = a + ' + ' + b + ' = ?';
          }
          if (captchaInput) {
            captchaInput.value = '';
          }
          if (captchaError) {
            captchaError.classList.add('hidden');
          }
        }

        generateCaptcha();

        if (refreshBtn) {
          refreshBtn.addEventListener('click', function(e) {
            e.preventDefault();
            generateCaptcha();
            if (captchaInput) captchaInput.focus();
          });
        }

        form.addEventListener('submit', function(e) {
          var rawAnswer = (captchaInput ? captchaInput.value : '').trim();
          var userAnswer = parseInt(rawAnswer, 10);
          if (!rawAnswer || isNaN(userAnswer) || userAnswer !== currentCaptchaSum) {
            e.preventDefault();
            if (captchaError) captchaError.classList.remove('hidden');
            if (captchaInput) {
              captchaInput.focus();
              captchaInput.select();
            }
            return;
          }

          if (!window.fetch) return;
          e.preventDefault();
          submitBtn.disabled = true;
          submitBtn.textContent = 'Submitting...';

          var formData = new FormData(form);
          fetch('/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(formData).toString()
          })
          .then(function() {
            status.classList.remove('hidden');
            form.reset();
            generateCaptcha();
            submitBtn.disabled = false;
            submitBtn.textContent = 'Post Comment';
          })
          .catch(function() {
            form.submit();
          });
        });
      })();
    </script>
  </section>

  {# Bottom Navigation #}
  <nav class="mt-6 border-t border-[#b7cbd6] pt-4 text-xs">
    <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/blog/">« Return to Web Log Index</a>
  </nav>
</article>
