---
layout: base.njk
isPost: true

---
{% set isDraft = draft or (tags and ('draft' in tags or tags == 'draft')) %}
<article class="site-entry">
  {% include "components/post-header.njk" %}

  {% if isDraft %}
    <div class="my-3 border border-dashed border-[#d97706] bg-[#fffbeb] px-3.5 py-2 text-xs font-bold text-[#b45309]">
      DRAFT - This post is saved as a draft and is hidden from public blog
      listings.
    </div>
  {% endif %}

  {# Entry Body Content #}
  <div class="site-entry-body mt-4 text-sm leading-relaxed text-[#26343d]">
    {{ content | safe }}
  </div>

  {% include "components/post-mood.njk" %}

  {% include "components/post-footer.njk" %}

  {% include "components/comments.njk" %}

  {# Bottom Navigation #}
  <nav class="mt-6 border-t border-[#b7cbd6] pt-4 text-xs">
    <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/blog/"
    >« Return to Web Log Index</a>
  </nav>
</article>
