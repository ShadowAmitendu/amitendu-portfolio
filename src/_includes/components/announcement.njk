{#
  Component: announcement.njk
  Description: Top-of-page announcement bar with localStorage dismissal memory.
  Data Sources:
  - announcement.json (or site.announcement fallback)
  Features:
  - Styles: info (blue bulletin), alert (yellow notice), success (green update)
  - 1-click dismiss button saving dismissal state per banner ID in localStorage
#}
{% set banner = announcement or site.announcement %}
{% if banner and banner.enabled and banner.message %}
  <aside
    id="site-announcement-bar"
    data-announcement-id="{{ banner.id or 'announcement-default' }}"
    class="mb-1 border border-[#9bb0be] px-3 py-1.5 flex items-center justify-between gap-3 text-xs shadow-[0_1px_3px_rgba(0,0,0,0.1)] {% if banner.type == 'alert' %}bg-[#fff8e1] border-[#d4a017] text-[#5d4037]{% elif banner.type == 'success' %}bg-[#e8f5e9] border-[#66bb6a] text-[#1b5e20]{% else %}bg-[#e6f2f8] border-[#789bb0] text-[#164b70]{% endif %}"
    aria-label="Site announcement"
  >
    <div class="flex items-center gap-2 min-w-0">
      <span
        class="font-bold uppercase tracking-wider text-[10px] px-1.5 py-0.5 border {% if banner.type == 'alert' %}bg-[#ffecb3] border-[#d4a017] text-[#795548]{% elif banner.type == 'success' %}bg-[#c8e6c9] border-[#66bb6a] text-[#14532d]{% else %}bg-[#d0e5f2] border-[#789bb0] text-[#164b70]{% endif %} select-none shrink-0"
      >
        {% if banner.type == 'alert' %}NOTICE{%
          elif banner.type == 'success'
        %}UPDATE{% else %}BULLETIN{% endif %}
      </span>
      <span class="truncate font-medium text-xs">{{ banner.message }}</span>
      {% if banner.linkUrl and banner.linkText %}
        <a
          href="{{ banner.linkUrl }}"
          class="shrink-0 underline font-bold hover:text-[#c0392b] ml-1"
        >{{ banner.linkText }}</a>
      {% endif %}
    </div>
    <button
      type="button"
      id="site-announcement-close"
      class="cursor-pointer px-1.5 py-0.5 border border-[#9bb0be] bg-white hover:bg-[#c0392b] hover:text-white hover:border-[#c0392b] text-[10px] font-bold transition-colors leading-none shrink-0"
      aria-label="Close announcement"
    >
      ✕
    </button>
  </aside>
  <script>
  (function() {
    try {
      var bar = document.getElementById("site-announcement-bar");
      if (bar) {
        var id = bar.getAttribute("data-announcement-id");
        if (localStorage.getItem("announcement_dismissed") === id) {
          bar.style.display = "none";
        }
        var btn = document.getElementById("site-announcement-close");
        if (btn) {
          btn.addEventListener("click", function() {
            bar.style.display = "none";
            localStorage.setItem("announcement_dismissed", id);
          });
        }
      }
    } catch (e) {}
  })();
  </script>
{% endif %}
