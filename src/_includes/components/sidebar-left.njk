<aside class="site-sidebar site-sidebar-left">
  {% if site.author %}
  <div class="site-sidebar-card mb-4">
    <div class="site-sidebar-card-header">
      About Me
    </div>
    <div class="site-sidebar-card-body">
      <div class="flex items-center gap-2.5">
        {% if site.author.avatar %}
        <img class="site-profile-frame h-11 w-11 shrink-0 object-cover" src="{{ site.author.avatar }}"
          alt="{{ site.author.name }}" width="44" height="44" />
        {% endif %}
        <div class="min-w-0">
          <p class="truncate font-bold leading-tight text-[#164b70] text-sm">{{ site.author.name }}</p>
          <p class="mt-0.5 text-[11px] leading-tight text-[#556b78]">{{ site.author.role }}</p>
        </div>
      </div>
      {% if site.author.bio %}
      <p class="mt-2.5 text-[12px] leading-snug text-[#3b4d57] border-t border-[#d8e3ea] pt-2">
        {{ site.author.bio }}</p>
      {% endif %}
      <div class="mt-2.5">
        <a class="site-button-2007" href="{{ resume.pdfUrl or '/resume/' }}">{% if resume.pdfUrl %}Download Resume{% else %}View Resume{% endif %}</a>
      </div>
    </div>
  </div>
  {% endif %}

  {# Live Discord Status Widget (via Lanyard API) #}
  <div class="site-sidebar-card mb-4" id="discord-card" data-discord-id="553845371131002891">
    <div class="site-sidebar-card-header flex items-center justify-between">
      <span class="flex items-center gap-1.5">
        <svg class="h-3.5 w-3.5 fill-[#164b70]" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.893.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
        </svg>
        <span>Discord Status</span>
      </span>
      <span class="inline-flex items-center gap-1 text-[10px] text-[#556b78]" id="discord-status-pill">
        <span id="discord-status-dot" class="inline-block h-2 w-2 rounded-full bg-[#94a3b8]"></span>
        <span id="discord-status-label" class="font-semibold uppercase tracking-wider text-[9px]">Offline</span>
      </span>
    </div>
    <div class="site-sidebar-card-body">
      <div class="flex items-center gap-2">
        <div class="relative shrink-0">
          <img id="discord-avatar" class="site-profile-frame h-9 w-9 object-cover rounded" src="{{ site.author.avatar }}" alt="Discord Avatar" width="36" height="36" />
          <span id="discord-avatar-dot" class="absolute -bottom-0.5 -right-0.5 h-2.5 w-2.5 rounded-full border border-white bg-[#94a3b8]"></span>
        </div>
        <div class="min-w-0 flex-1">
          <a href="https://discord.com/users/553845371131002891" target="_blank" rel="noopener noreferrer" class="truncate font-bold leading-tight text-[#064f83] hover:text-[#c0392b] underline text-xs block">
            <span id="discord-user-display">{{ site.author.name or 'Amitendu' }}</span>
          </a>
          <p id="discord-user-tag" class="text-[10px] text-[#71828b] leading-tight truncate">@shadowamitendu</p>
        </div>
      </div>
      <div id="discord-activity-box" class="mt-2 border-t border-[#d8e3ea] pt-1.5 text-[11px] leading-tight text-[#3b4d57]">
        <div id="discord-activity-content" class="flex items-center gap-1.5 truncate">
          <span class="text-[11px] shrink-0">💬</span>
          <span class="truncate" id="discord-activity-text">Chat on Discord</span>
        </div>
      </div>
    </div>
  </div>
  <h2>{{ site.leftSidebar.title }}</h2>
  {% for item in site.leftSidebar.items %}
  {% set itemActive = false %}
  {% if item.url == '/' and isHome %}
  {% set itemActive = true %}
  {% elif item.url == '/about/' and isAbout %}
  {% set itemActive = true %}
  {% elif item.url == '/blog/' and isBlog %}
  {% set itemActive = true %}
  {% elif item.url == '/portfolio/' and isPortfolio %}
  {% set itemActive = true %}
  {% elif (item.url == '/resume/' or item.url == '/cv/') and isResume %}
  {% set itemActive = true %}
  {% elif (item.url == '/shelf/' or item.url == '/books-movies/') and isShelf %}
  {% set itemActive = true %}
  {% elif (item.url == '/apps/' or item.url == '/uses/') and isApps %}
  {% set itemActive = true %}
  {% endif %}
  <p>
    {% if itemActive %}
    <span
      class="inline-block bg-[#164b70] text-white font-bold px-1.5 py-0.5 text-[14px] shadow-[inset_0_1px_2px_rgba(0,0,0,0.3)]">{{ item.label }}</span>
    {% else %}
    <a class="text-[#064f83] underline hover:text-[#c0392b]" href="{{ item.url }}">{{ item.label }}</a>
    {% endif %}
  </p>
  {% endfor %}
  <div class="mt-5 border-t border-[#b7cbd6] pt-3">
    <h2>{{ (site.sidebar and site.sidebar.recentPostsTitle) or 'Recent Posts' }}</h2>
    <div class="mt-2 space-y-2">
      {% set recentPosts = collections.blog.slice(0, (site.sidebar and site.sidebar.recentPostsLimit) or 3) %}
      {% if recentPosts and recentPosts.length > 0 %}
      {% for post in recentPosts %}
      <div>
        <a class="block text-[13px] leading-snug text-[#064f83] underline hover:text-[#c0392b]"
          href="{{ post.url }}">{{ post.data.title }}</a>
        <span class="text-[11px] text-[#71828b]">{{ post.data.date | shortDate }}</span>
      </div>
      {% endfor %}
      {% else %}
      <p class="text-[12px] italic text-[#71828b]">No posts yet.</p>
      {% endif %}
    </div>
  </div>
  <div class="mt-5 border-t border-[#b7cbd6] pt-3">
    <h2>{{ (site.sidebar and site.sidebar.favoritesTitle) or 'Favorites' }}</h2>
    <div class="mt-2 space-y-2">
      {% if collections.fav and collections.fav.length > 0 %}
      {% for item in collections.fav.slice(0, 4) %}
      <div class="flex items-start gap-1.5">
        <svg class="mt-0.5 h-3.5 w-3.5 shrink-0 text-[#e1a62a]" xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20" fill="currentColor">
          <path
            d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        <div>
          <a class="block text-[13px] leading-snug text-[#064f83] underline hover:text-[#c0392b]"
            href="{{ item.url }}">{{ item.data.title }}</a>
          <span
            class="text-[11px] text-[#71828b]">{% if 'portfolio' in item.data.tags %}Project{% else %}Article{% endif %}</span>
        </div>
      </div>
      {% endfor %}
      {% else %}
      <p class="text-[12px] italic text-[#71828b]">No favorites tagged yet.</p>
      {% endif %}
    </div>
  </div>
</aside>
