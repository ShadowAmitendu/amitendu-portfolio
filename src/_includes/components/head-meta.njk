<title>{% if isHome %}{{ site.title }} :: Home{% elif displayTitle and displayTitle != site.title %}{{ displayTitle }}{% if pagination.pageNumber and pagination.pageNumber > 0 %} (Page {{ pagination.pageNumber + 1 }}){% endif %} :: {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>

{# Primary Search Engine Meta Tags #}
<meta name="description" content="{{ pageDesc | escape }}" />
<meta name="keywords" content="{{ site.keywords | escape }}" />
<meta name="author" content="{{ author or site.name }}" />
{% if isDraft or noindex %}
<meta name="robots" content="noindex, nofollow" />
<meta name="googlebot" content="noindex, nofollow" />
<meta name="bingbot" content="noindex, nofollow" />
{% else %}
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="bingbot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<link rel="canonical" href="{{ canonicalUrl }}" />
{% endif %}
<meta name="msvalidate.01" content="f5c6b98e721a48c4842e19d7a31b6728" />
<meta name="generator" content="Eleventy" />
<meta name="theme-color" content="#164b70" />
<meta name="msapplication-TileColor" content="#164b70" />
<meta name="msapplication-TileImage" content="/favicon-192.png?v=2" />
<meta name="application-name" content="{{ site.title }}" />
<meta name="color-scheme" content="light" />

{# Open Graph / Social Media Meta Tags #}
<meta property="og:site_name" content="{{ site.title }}" />
<meta property="og:type" content="{{ 'article' if isPost else 'website' }}" />
<meta property="og:title" content="{% if isHome %}{{ site.title }} :: Home{% else %}{{ displayTitle }}{% endif %}" />
<meta property="og:description" content="{{ pageDesc | escape }}" />
{% if not noindex %}
<meta property="og:url" content="{{ canonicalUrl }}" />
{% endif %}
<meta property="og:image" content="{{ socialImageUrl }}" />
<meta property="og:image:secure_url" content="{{ socialImageUrl }}" />
<meta property="og:image:alt" content="{{ displayTitle }}" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:locale" content="en_US" />
{% if isPost %}
{% if date %}
<meta property="article:published_time" content="{{ date | isoDate }}" />{% endif %}
{% if updated %}
<meta property="article:modified_time" content="{{ updated | isoDate }}" />{% endif %}
<meta property="article:author" content="{{ author or site.name }}" />
{% set postTopics = topics or tags %}
{% if postTopics %}
{% for tag in postTopics %}
{% if tag != "blog" and tag != "post" %}
<meta property="article:tag" content="{{ tag }}" />{% endif %}
{% endfor %}
{% endif %}
{% endif %}

{# Twitter / X Card Meta Tags #}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="{{ site.twitter }}" />
<meta name="twitter:creator" content="{{ site.twitter }}" />
<meta name="twitter:title" content="{% if isHome %}{{ site.title }} :: Home{% else %}{{ displayTitle }}{% endif %}" />
<meta name="twitter:description" content="{{ pageDesc | escape }}" />
<meta name="twitter:image" content="{{ socialImageUrl }}" />
<meta name="twitter:image:alt" content="{{ displayTitle }}" />

{# JSON-LD Structured Data Schema (Bing & Google compliant) #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "{{ site.url }}/#website",
      "url": "{{ site.url }}/",
      "name": {{ site.title | dump | safe }},
      "alternateName": {{ (site.handle or "ShadowAmitendu") | dump | safe }},
      "description": {{ site.description | dump | safe }},
      "inLanguage": "en-US",
      "publisher": {
        "@id": "{{ site.url }}/#person"
      }
    },
    {
      "@type": "Person",
      "@id": "{{ site.url }}/#person",
      "name": {{ site.name | dump | safe }},
      "alternateName": {{ (site.handle or "ShadowAmitendu") | dump | safe }},
      "url": "{{ site.url }}/",
      "image": "{{ site.url }}{{ site.author.avatar }}",
      "jobTitle": {{ site.author.role | dump | safe }},
      "description": {{ site.description | dump | safe }},
      "knowsAbout": ["Web Development", "React", "Java", "Spring Boot", "JavaScript", "UI/UX Design", "Full Stack Development"],
      "alumniOf": {
        "@type": "EducationalOrganization",
        "name": "Techno India Hooghly"
      },
      {% if site.email %}
      "email": "mailto:{{ site.email }}",
      {% endif %}
      "sameAs": [
        "https://github.com/ShadowAmitendu",
        "https://www.youtube.com/@ShadowAmitendu",
        "https://x.com/shadow_amitendu",
        "https://www.linkedin.com/in/amitendu/",
        "https://peerlist.io/amitendu"
      ]
    }
    {% if not isHome and not noindex %},
    {
      "@type": "BreadcrumbList",
      "@id": "{{ canonicalUrl }}#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "{{ site.url }}/"
        }
        {% if isBlog and (isPost or (tags and 'blog' in tags and page.url != '/blog/')) %},
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Blog",
          "item": "{{ site.url }}/blog/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ title | dump | safe }},
          "item": "{{ canonicalUrl }}"
        }
        {% elif isPortfolio and tags and 'portfolio' in tags and page.url != '/portfolio/' %},
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Portfolio",
          "item": "{{ site.url }}/portfolio/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ title | dump | safe }},
          "item": "{{ canonicalUrl }}"
        }
        {% elif isAbout and page.url != '/about/' %},
        {
          "@type": "ListItem",
          "position": 2,
          "name": "About",
          "item": "{{ site.url }}/about/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ (aboutTab or title) | dump | safe }},
          "item": "{{ canonicalUrl }}"
        }
        {% else %},
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ (displayTitle or title) | dump | safe }},
          "item": "{{ canonicalUrl }}"
        }
        {% endif %}
      ]
    }
    {% endif %}
    {% if isPost %},
    {
      "@type": "BlogPosting",
      "@id": "{{ canonicalUrl }}#article",
      "mainEntityOfPage": "{{ canonicalUrl }}",
      "headline": {{ title | dump | safe }},
      "description": {{ pageDesc | dump | safe }},
      "url": "{{ canonicalUrl }}",
      {% if date %}"datePublished": "{{ date | isoDate }}",{% endif %}
      "dateModified": "{{ (dateModified or date or buildDate) | isoDate }}",
      "author": {
        "@type": "Person",
        "name": {{ (author or site.name) | dump | safe }},
        "url": "{{ site.url }}/"
      },
      "publisher": {
        "@id": "{{ site.url }}/#person"
      },
      "image": "{{ socialImageUrl }}",
      "inLanguage": "en-US"
    }
    {% endif %}
  ]
}
</script>

