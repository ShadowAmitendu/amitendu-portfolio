{#
  Component: sidebar-nav.njk
  Description: Left sidebar navigation link tree.
  Data Sources:
  - leftSidebar.json (or site.leftSidebar fallback)
  - sidebarWidgets.json: navigationLimit (0 = show all links)
#}
{% set nav = leftSidebar or site.leftSidebar %}
{% set sb = sidebarWidgets or site.sidebar %}
{% set navLimit = (sb and sb.navigationLimit) or (nav and nav.limit) or 0 %}
{% set navItems = nav.items.slice(0, navLimit) if (navLimit and navLimit > 0) else (nav.items or []) %}
<h2>{{ nav.title }}</h2>
{% for item in navItems %}
{% set itemActive = false %}
{% if item.url == '/' and isHome %}
{% set itemActive = true %}
{% elif item.url == '/about/' and isAbout %}
{% set itemActive = true %}
{% elif item.url == '/blog/' and isBlog %}
{% set itemActive = true %}
{% elif item.url == '/portfolio/' and isPortfolio %}
{% set itemActive = true %}
{% elif (item.url == '/resume/' or item.url == '/cv/') and isResume %}
{% set itemActive = true %}
{% elif (item.url == '/shelf/' or item.url == '/books-movies/') and isShelf %}
{% set itemActive = true %}
{% elif (item.url == '/apps/' or item.url == '/uses/') and isApps %}
{% set itemActive = true %}
{% endif %}
<p>
  {% if itemActive %}
  <span
    class="inline-block bg-[#164b70] text-white font-bold px-1.5 py-0.5 text-[14px] shadow-[inset_0_1px_2px_rgba(0,0,0,0.3)]">{{ item.label }}</span>
  {% else %}
  <a class="text-[#064f83] underline hover:text-[#c0392b]" href="{{ item.url }}">{{ item.label }}</a>
  {% endif %}
</p>
{% endfor %}
