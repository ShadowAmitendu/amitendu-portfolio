{#
  Component: sidebar-shortcuts.njk
  Description: Right sidebar outlinks and social bookmarks with retro macOS dock icons.
  Data Sources:
  - rightSidebar.json (or site.rightSidebar fallback)
  - sidebarWidgets.json: shortcutsLimit (0 = show all items), shortcutsTitle
#}
{% set shortcuts = rightSidebar or site.rightSidebar %}
{% set sb = sidebarWidgets or site.sidebar %}
{% set scLimit = (sb and sb.shortcutsLimit) or shortcuts.limit or 0 %}
{% set scItems = shortcuts.items.slice(0, scLimit) if (scLimit and scLimit > 0) else (shortcuts.items or []) %}
<h2>{{ (sb and sb.shortcutsTitle) or shortcuts.title or 'Outlinks' }}</h2>
<div class="mt-2 space-y-2">
  {% for item in scItems %}
  {% set itemIcon = item.url | resolveIcon(item.label, item.icon) %}
  <div>
    <a class="flex items-center gap-2 text-[#064f83] hover:text-[#c0392b]" href="{{ item.url }}"
      {% if item.url and item.url.startsWith('http') %}target="_blank" rel="noopener noreferrer" {% endif %}>
      <img class="site-macos-icon h-5 w-5 shrink-0 rounded-[4.5px] shadow-[0_1px_2px_rgba(0,0,0,0.25)]"
        src="/assets/icons/macos-{{ itemIcon }}.png" alt="{{ item.label }} icon" width="20" height="20" />
      <span class="underline">{{ item.label }}</span>
    </a>
  </div>
  {% endfor %}
</div>
