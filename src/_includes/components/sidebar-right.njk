<aside class="site-sidebar site-sidebar-right">
  <h2>{{ site.rightSidebar.title }}</h2>
  <div class="mt-2 space-y-2">
    {% for item in site.rightSidebar.items %}
    {% set itemIcon = item.url | resolveIcon(item.label, item.icon) %}
    <div>
      <a class="flex items-center gap-2 text-[#064f83] hover:text-[#c0392b]" href="{{ item.url }}"
        {% if item.url and item.url.startsWith('http') %}target="_blank" rel="noopener noreferrer" {% endif %}>
        <img class="site-macos-icon h-5 w-5 shrink-0 rounded-[4.5px] shadow-[0_1px_2px_rgba(0,0,0,0.25)]"
          src="/assets/icons/macos-{{ itemIcon }}.png" alt="" width="20" height="20" />
        <span class="underline">{{ item.label }}</span>
      </a>
    </div>
    {% endfor %}
  </div>
  {# Book I am reading Card in Right Sidebar #}
  {% set sidebarBook = null %}
  {% for b in (books.items or shelf.books) %}
  {% if (b.status == "currently-reading" or b.status == "reading") and not sidebarBook %}
  {% set sidebarBook = b %}
  {% endif %}
  {% endfor %}
  {% if not sidebarBook and (books.items and books.items.length > 0) %}
  {% set sidebarBook = books.items[0] %}
  {% endif %}
  {% if sidebarBook %}
  <div class="mt-5 border-t border-[#b7cbd6] pt-3">
    <div class="site-card border border-[#b7cbd6] bg-[#f4f8fa] p-0 flex flex-col overflow-hidden">
      <div
        class="border-b border-[#c6d7e0] bg-[#e4eef2] px-2.5 py-1 font-bold text-[#164b70] text-xs flex justify-between items-center shadow-[inset_0_1px_0_#fff]">
        <span>Book I am reading</span>
        <span class="text-[10px] text-[#556b78] font-normal">Reading</span>
      </div>
      <div class="p-2.5 text-center flex flex-col items-center">
        <a class="my-1 block hover:opacity-90" href="/about/books/"
          title="{{ sidebarBook.title }} - view on bookshelf">
          {% if sidebarBook.image %}
          <img
            class="h-24 w-16 object-contain border border-[#7892a3] bg-white p-0.5 shadow-[0_1px_2px_rgba(0,0,0,0.12)]"
            src="{{ sidebarBook.image }}" alt="{{ sidebarBook.title }}" />
          {% else %}
          <div
            class="h-20 w-14 border border-[#7892a3] bg-[#dce9ef] flex items-center justify-center text-[10px] font-bold text-[#164b70]">
            BOOK
          </div>
          {% endif %}
        </a>
        <h3 class="font-bold text-[#164b70] text-sm mt-1 leading-tight tracking-tight uppercase">
          <a class="text-[#164b70] underline hover:text-[#c0392b]"
            href="/about/books/">{{ sidebarBook.title }}</a>
        </h3>
        {% if sidebarBook.author %}
        <p class="text-[11px] text-[#556b78] mt-0.5">by {{ sidebarBook.author }}</p>
        {% endif %}
      </div>
    </div>
  </div>
  {% endif %}

  {# Games I play Card in Right Sidebar #}
  {% set sidebarGame = null %}
  {% for g in (games.items or []) %}
  {% if not sidebarGame and g.playingRightNow %}
  {% set sidebarGame = g %}
  {% endif %}
  {% endfor %}
  {% if not sidebarGame and (games.items and games.items.length > 0) %}
  {% set sidebarGame = games.items[0] %}
  {% endif %}

  {% if games.items and games.items.length > 0 %}
  <div class="mt-5 border-t border-[#b7cbd6] pt-3">
    <div class="site-card border border-[#b7cbd6] bg-[#f4f8fa] p-0 flex flex-col overflow-hidden">
      <div
        class="border-b border-[#c6d7e0] bg-[#e4eef2] px-2.5 py-1 font-bold text-[#164b70] text-xs flex justify-between items-center shadow-[inset_0_1px_0_#fff]">
        <span>Games I play</span>
        <span class="text-[10px] text-[#556b78] font-normal">Ongoing</span>
      </div>
      {% if sidebarGame %}
      {% set sGameImg = sidebarGame.image or sidebarGame.icon %}
      <div class="p-2.5 text-center flex flex-col items-center">
        <a class="my-1 block hover:opacity-90" href="/about/games/"
          title="{{ sidebarGame.name }} - view on games page">
          {% if sGameImg %}
          <img
            class="h-20 w-20 object-contain border border-[#7892a3] bg-white p-1 shadow-[0_1px_2px_rgba(0,0,0,0.12)]"
            src="{{ sGameImg }}" alt="{{ sidebarGame.name }}" />
          {% else %}
          <div
            class="h-16 w-16 border border-[#7892a3] bg-[#dce9ef] flex items-center justify-center text-[10px] font-bold text-[#164b70]">
            GAME
          </div>
          {% endif %}
        </a>
        <h3 class="font-bold text-[#164b70] text-sm mt-1 leading-tight tracking-tight uppercase">
          <a class="text-[#164b70] underline hover:text-[#c0392b]" href="/about/games/">{{ sidebarGame.name }}</a>
        </h3>
        <p class="text-[11px] text-[#556b78] mt-0.5">
          {{ sidebarGame.platform or sidebarGame.publisher or "PC" }}
        </p>
      </div>
      {% endif %}

      {# If there are other games, show them as icons below the featured game, all linking to /about/games/ #}
      {% if games.items.length > 1 %}
      <div
        class="border-t border-[#d8e3ea] bg-[#eef4f7] px-2 py-1.5 flex flex-wrap items-center justify-center gap-1.5">
        {% for g in games.items %}
        {% if g != sidebarGame and (g.icon or g.image) %}
        <a class="block border border-[#7892a3] bg-white p-0.5 hover:border-[#c0392b]" href="/about/games/"
          title="{{ g.name }}{% if g.status %} [{{ g.status }}]{% endif %}">
          <img class="h-6 w-6 object-contain" src="{{ g.icon or g.image }}" alt="{{ g.name }}" width="24"
            height="24" />
        </a>
        {% endif %}
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </div>
  {% endif %}

  {# Software Icons in Right Sidebar #}
  {% set sidebarSoftware = software.items %}
  {% if sidebarSoftware and sidebarSoftware.length > 0 %}
  <div class="mt-5 border-t border-[#b7cbd6] pt-3">
    <h2>Software</h2>
    <div class="mt-2 flex flex-wrap gap-1.5">
      {% for s in sidebarSoftware %}
      {% if s.icon %}
      <a class="block border border-[#7892a3] bg-white p-0.5 hover:border-[#c0392b]"
        href="{{ s.link or '/about/software/' }}"
        title="{{ s.name }}{% if s.category %} [{{ s.category }}]{% endif %}"
        {% if s.link and s.link.startsWith('http') %}target="_blank" rel="noopener noreferrer" {% endif %}>
        <img class="h-6 w-6 object-contain" src="{{ s.icon }}" alt="{{ s.name }}" width="24" height="24" />
      </a>
      {% endif %}
      {% endfor %}
    </div>
    <div class="mt-2 text-right text-xs">
      <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/about/software/">View software &raquo;</a>
    </div>
  </div>
  {% endif %}

  {# Friends Section in Right Sidebar #}
  {% set sidebarFriends = friends.items %}
  {% if sidebarFriends and sidebarFriends.length > 0 %}
  <div class="mt-5 border-t border-[#b7cbd6] pt-3">
    <h2>Friends &amp; Allies</h2>
    <div class="mt-2 space-y-2">
      {% for f in sidebarFriends.slice(0, 4) %}
      <div class="flex items-center gap-2">
        {% if f.avatar %}
        <img class="h-5 w-5 shrink-0 object-cover border border-[#7892a3] bg-white p-0.5" src="{{ f.avatar }}"
          alt="{{ f.name }}" width="20" height="20" />
        {% else %}
        <span
          class="h-5 w-5 shrink-0 border border-[#7892a3] bg-[#dce9ef] flex items-center justify-center text-[9px] font-bold text-[#164b70]">✦</span>
        {% endif %}
        <div class="min-w-0 flex-1 truncate">
          <a class="text-[13px] leading-snug text-[#064f83] underline hover:text-[#c0392b]"
            href="{{ f.url or '/about/friends/' }}" {% if f.url and f.url.startsWith('http') %}target="_blank"
            rel="noopener noreferrer" {% endif %}>{{ f.name }}</a>
          {% if f.relationship %}
          <span class="block text-[10px] text-[#71828b] leading-tight truncate">{{ f.relationship }}</span>
          {% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
    <div class="mt-2 text-right text-xs">
      <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/about/friends/">All friends &raquo;</a>
    </div>
  </div>
  {% endif %}

</aside>
