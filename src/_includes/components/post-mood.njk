{# Mood & Music Box (Optional) #}
{% if mood or music %}
  <div class="site-entry-status mt-6 border border-[#b2c2cc] bg-[#edf4f7] px-3.5 py-2 text-xs text-[#536a75] shadow-[inset_0_1px_0_#fff]">
    <div class="flex flex-wrap items-center justify-between gap-2">
      {% if mood %}
        <div class="flex items-center gap-2">
          <span class="font-bold text-[#164b70]">Mood:</span>
          <span>{{ mood }}</span>
        </div>
      {% endif %}
      {% if music %}
        <div class="flex items-center gap-2">
          <span class="font-bold text-[#164b70]">Music:</span>
          <span class="italic">{{ music }}</span>
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}
