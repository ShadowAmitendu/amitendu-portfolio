{# Software Icons in Right Sidebar #}
{% set sidebarSoftware = software.items %}
{% if sidebarSoftware and sidebarSoftware.length > 0 %}
<div class="mt-5 border-t border-[#b7cbd6] pt-3">
  <h2>Software</h2>
  <div class="mt-2 flex flex-wrap gap-1.5">
    {% for s in sidebarSoftware %}
    {% if s.icon %}
    <a class="block border border-[#7892a3] bg-white p-0.5 hover:border-[#c0392b]"
      href="{{ s.link or '/about/software/' }}"
      title="{{ s.name }}{% if s.category %} [{{ s.category }}]{% endif %}"
      {% if s.link and s.link.startsWith('http') %}target="_blank" rel="noopener noreferrer" {% endif %}>
      <img class="h-6 w-6 object-contain" src="{{ s.icon }}" alt="{{ s.name }}" width="24" height="24" />
    </a>
    {% endif %}
    {% endfor %}
  </div>
  <div class="mt-2 text-right text-xs">
    <a class="text-[#064f83] underline hover:text-[#c0392b]" href="/about/software/">View software &raquo;</a>
  </div>
</div>
{% endif %}
