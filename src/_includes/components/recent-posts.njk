{#
  Component: recent-posts.njk
  Description: Left sidebar recent blog posts widget.
  Data Sources:
  - collections.blog (newest first)
  - sidebarWidgets.json: recentPostsTitle, recentPostsLimit (default: 3)
#}
<div class="mt-5 border-t border-[#b7cbd6] pt-3">
  {% set sb = sidebarWidgets or site.sidebar %}
  <h2>{{ (sb and sb.recentPostsTitle) or 'Recent Posts' }}</h2>
  <div class="mt-2 space-y-2">
    {% set recentPosts = collections.blog.slice(0, (sb and sb.recentPostsLimit) or 3) %}
    {% if recentPosts and recentPosts.length > 0 %}
    {% for post in recentPosts %}
    <div>
      <a class="block text-[13px] leading-snug text-[#064f83] underline hover:text-[#c0392b]"
        href="{{ post.url }}">{{ post.data.title }}</a>
      <span class="text-[11px] text-[#71828b]">{{ post.data.date | shortDate }}</span>
    </div>
    {% endfor %}
    {% else %}
    <p class="text-[12px] italic text-[#71828b]">No posts yet.</p>
    {% endif %}
  </div>
</div>
