{# Entry Footer: Tags & Classic Actions #}
<footer class="site-entry-footer mt-4 border-t border-dashed border-[#b7cbd6] pt-3 text-xs text-[#71828b]">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap items-center gap-1.5">
      <span class="font-bold text-[#164b70]">Filed under:</span>
      {% set postTopics = topics or tags %}
      {% for tag in postTopics %}
        {% if tag != "blog" and tag != "post" %}
          <span
            class="site-badge border border-[#7398b0] bg-[#e8f3f8] px-1.5 py-0.5 text-[10px] text-[#164b70]"
          >{{ tag }}</span>
        {% endif %}
      {% endfor %}
    </div>
    <div class="flex items-center gap-2 text-[14px]">
      <a
        class="text-[#064f83] underline hover:text-[#c0392b]"
        href="#comments"
      >comments</a>
      <span>·</span>
      <a
        class="text-[#064f83] underline hover:text-[#c0392b]"
        href="{{ permalink or page.url }}"
      >permalink</a>
      <span>·</span>
      <a class="text-[#064f83] underline hover:text-[#c0392b]" href="#top"
      >top</a>
    </div>
  </div>
</footer>
