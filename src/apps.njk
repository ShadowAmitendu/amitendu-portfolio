---
layout: base.njk
title: Games & Apps
headerTagline: SOFTWARE & GAMING
permalink: /apps/
---
<div class="site-intro mb-6 border border-[#b7cbd6] bg-[#f4f8fa] p-4">
  <h2 class="text-xl font-bold text-[#164b70]">
    {{ apps.heading or 'Games & Apps I Use' }}
  </h2>
  <p class="mt-2 text-sm leading-relaxed text-[#3b4d57]">
    {{ apps.intro or 'A curated directory of games I play and software applications, development tools, and utilities I rely on daily.' }}
  </p>
</div>

{# Quick Icon Dock / Highlights #}
<div class="mb-8 border border-[#7892a3] bg-[#eef4f7] p-4 shadow-[inset_0_1px_0_#fff]">
  <div class="border-b border-[#b7cbd6] pb-1.5 mb-3 flex items-center justify-between">
    <span class="inline-block bg-[#164b70] text-white text-[11px] font-bold px-2 py-0.5 tracking-wider uppercase">
      Daily Dock & Favorites
    </span>
    <span class="text-[11px] text-[#556b78]">Click any icon for details</span>
  </div>
  <div class="flex flex-wrap items-center gap-3">
    {% for g in apps.games %}
    {% if g.icon %}
    <a class="block group relative p-1 border border-[#b7cbd6] bg-white hover:border-[#c0392b] shadow-sm" href="{{ g.link or '#game-' ~ loop.index }}" title="{{ g.name }} ({{ g.status }})" {% if g.link and g.link.startsWith('http') %}target="_blank" rel="noopener noreferrer"{% endif %}>
      <img class="h-9 w-9 object-contain" src="{{ g.icon }}" alt="{{ g.name }}" width="36" height="36" />
    </a>
    {% endif %}
    {% endfor %}
    {% for a in apps.apps %}
    {% if a.icon %}
    <a class="block group relative p-1 border border-[#b7cbd6] bg-white hover:border-[#c0392b] shadow-sm" href="{{ a.link or '#app-' ~ loop.index }}" title="{{ a.name }} ({{ a.category }})" {% if a.link and a.link.startsWith('http') %}target="_blank" rel="noopener noreferrer"{% endif %}>
      <img class="h-9 w-9 object-contain" src="{{ a.icon }}" alt="{{ a.name }}" width="36" height="36" />
    </a>
    {% endif %}
    {% endfor %}
  </div>
</div>

{# Games Section #}
<div class="mt-8">
  <div class="flex items-baseline justify-between border-b border-[#b7cbd6] pb-1">
    <h2 class="text-lg font-bold text-[#164b70]">
      {{ apps.gamesHeading or 'Games I Play' }}
    </h2>
    <span class="text-xs text-[#71828b]">Total: {{ apps.games.length or 0 }}</span>
  </div>
  {% if apps.gamesIntro %}
  <p class="mt-2 text-xs text-[#556b78]">{{ apps.gamesIntro }}</p>
  {% endif %}

  <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4">
    {% if apps.games and apps.games.length > 0 %}
    {% for game in apps.games %}
    <article id="game-{{ loop.index }}" class="site-card border border-[#b7cbd6] bg-[#f4f8fa] p-3.5 flex gap-3.5 items-start">
      {% if game.icon %}
      <img class="h-14 w-14 shrink-0 object-contain border border-[#7892a3] bg-white p-1 shadow-[1px_1px_0_#fff]" src="{{ game.icon }}" alt="{{ game.name }}" width="56" height="56" />
      {% else %}
      <div class="h-14 w-14 shrink-0 border border-[#b7cbd6] bg-[#dce9ef] flex flex-col items-center justify-center p-1 text-center font-bold text-xs text-[#164b70]">
        GAME
      </div>
      {% endif %}

      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-center gap-1.5">
          {% if game.status == "Currently Playing" %}
          <span class="inline-block bg-[#2e7d32] text-white text-[9px] font-bold px-1.5 py-0.2 tracking-wider">
            PLAYING
          </span>
          {% elif game.status == "Favorite" %}
          <span class="inline-block bg-[#164b70] text-white text-[9px] font-bold px-1.5 py-0.2 tracking-wider">
            FAVORITE
          </span>
          {% elif game.status %}
          <span class="inline-block bg-[#e2ecf2] border border-[#b7cbd6] text-[#164b70] text-[9px] font-bold px-1.5 py-0.2 tracking-wider uppercase">
            {{ game.status }}
          </span>
          {% endif %}

          {% if game.platform %}
          <span class="text-[10px] text-[#556b78] bg-[#eef4f7] px-1.5 py-0.2 border border-[#b7cbd6]">
            {{ game.platform }}
          </span>
          {% endif %}
        </div>

        <h3 class="font-bold text-[#164b70] text-sm mt-1 leading-snug">
          {% if game.link %}
          <a class="text-[#064f83] underline hover:text-[#c0392b]" href="{{ game.link }}" target="_blank" rel="noopener noreferrer">
            {{ game.name }}
          </a>
          {% else %}
          {{ game.name }}
          {% endif %}
        </h3>

        {% if game.genre %}
        <p class="text-[11px] text-[#556b78] mt-0.5">{{ game.genre }}</p>
        {% endif %}

        {% if game.description %}
        <p class="mt-1.5 text-xs leading-relaxed text-[#26343d]">
          {{ game.description }}
        </p>
        {% endif %}

        {% if game.link %}
        <div class="mt-2 text-right">
          <a class="text-[11px] text-[#064f83] underline hover:text-[#c0392b]" href="{{ game.link }}" target="_blank" rel="noopener noreferrer">
            Official Site &raquo;
          </a>
        </div>
        {% endif %}
      </div>
    </article>
    {% endfor %}
    {% else %}
    <div class="col-span-2 border border-[#b7cbd6] bg-[#f4f8fa] p-4 text-center text-xs text-[#71828b]">
      <p class="font-bold text-[#164b70]">No Games Listed</p>
      <p class="mt-1">Add your favorite games through the admin panel!</p>
    </div>
    {% endif %}
  </div>
</div>

{# Apps & Software Section #}
<div class="mt-10">
  <div class="flex items-baseline justify-between border-b border-[#b7cbd6] pb-1">
    <h2 class="text-lg font-bold text-[#164b70]">
      {{ apps.appsHeading or 'Software & Tools' }}
    </h2>
    <span class="text-xs text-[#71828b]">Total: {{ apps.apps.length or 0 }}</span>
  </div>
  {% if apps.appsIntro %}
  <p class="mt-2 text-xs text-[#556b78]">{{ apps.appsIntro }}</p>
  {% endif %}

  <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4">
    {% if apps.apps and apps.apps.length > 0 %}
    {% for app in apps.apps %}
    <article id="app-{{ loop.index }}" class="site-card border border-[#b7cbd6] bg-[#f4f8fa] p-3.5 flex gap-3.5 items-start">
      {% if app.icon %}
      <img class="h-14 w-14 shrink-0 object-contain border border-[#7892a3] bg-white p-1 shadow-[1px_1px_0_#fff]" src="{{ app.icon }}" alt="{{ app.name }}" width="56" height="56" />
      {% else %}
      <div class="h-14 w-14 shrink-0 border border-[#b7cbd6] bg-[#dce9ef] flex flex-col items-center justify-center p-1 text-center font-bold text-xs text-[#164b70]">
        APP
      </div>
      {% endif %}

      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-center gap-1.5">
          {% if app.category %}
          <span class="inline-block bg-[#164b70] text-white text-[9px] font-bold px-1.5 py-0.2 tracking-wider uppercase">
            {{ app.category }}
          </span>
          {% endif %}

          {% if app.status %}
          <span class="text-[10px] text-[#556b78] bg-[#eef4f7] px-1.5 py-0.2 border border-[#b7cbd6]">
            {{ app.status }}
          </span>
          {% endif %}
        </div>

        <h3 class="font-bold text-[#164b70] text-sm mt-1 leading-snug">
          {% if app.link %}
          <a class="text-[#064f83] underline hover:text-[#c0392b]" href="{{ app.link }}" target="_blank" rel="noopener noreferrer">
            {{ app.name }}
          </a>
          {% else %}
          {{ app.name }}
          {% endif %}
        </h3>

        {% if app.description %}
        <p class="mt-1.5 text-xs leading-relaxed text-[#26343d]">
          {{ app.description }}
        </p>
        {% endif %}

        {% if app.link %}
        <div class="mt-2 text-right">
          <a class="text-[11px] text-[#064f83] underline hover:text-[#c0392b]" href="{{ app.link }}" target="_blank" rel="noopener noreferrer">
            Website &raquo;
          </a>
        </div>
        {% endif %}
      </div>
    </article>
    {% endfor %}
    {% else %}
    <div class="col-span-2 border border-[#b7cbd6] bg-[#f4f8fa] p-4 text-center text-xs text-[#71828b]">
      <p class="font-bold text-[#164b70]">No Apps Listed</p>
      <p class="mt-1">Add your daily tools through the admin panel!</p>
    </div>
    {% endif %}
  </div>
</div>
